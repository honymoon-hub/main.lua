local function CleanPathVisuals()
    local old = Workspace:FindFirstChild("MarioSimWalkVisuals")
    if old then pcall(old.Destroy, old) end
end

local function RenderPathVisuals(waypoints, color)
    CleanPathVisuals()
    if not State.DrawWalkPath then return nil end

    local folder = Instance.new("Folder")
    folder.Name = "MarioSimWalkVisuals"
    folder.Parent = Workspace

    for i = 1, #waypoints - 1 do
        local p1 = waypoints[i].Position + Vector3.new(0, 0.35, 0)
        local p2 = waypoints[i+1].Position + Vector3.new(0, 0.35, 0)
        local dist = (p2 - p1).Magnitude
        if dist > 0.1 then
            local part = Instance.new("Part")
            part.Anchored = true
            part.CanCollide = false
            part.CanTouch = false
            part.CanQuery = false
            part.Material = Enum.Material.Neon
            part.Color = color or Color3.fromRGB(0, 255, 180)
            part.Transparency = 0.3
            part.Size = Vector3.new(0.4, 0.08, dist)
            part.CFrame = CFrame.new((p1 + p2) / 2, p2)
            part.Parent = folder
        end
    end

    -- Destination ring marker
    local lastP = waypoints[#waypoints].Position
    local pin = Instance.new("Part")
    pin.Shape = Enum.PartType.Cylinder
    pin.Anchored = true
    pin.CanCollide = false
    pin.Material = Enum.Material.Neon
    pin.Color = Color3.fromRGB(255, 220, 0)
    pin.Size = Vector3.new(0.15, 3.5, 3.5)
    pin.CFrame = CFrame.new(lastP + Vector3.new(0, 0.2, 0)) * CFrame.Angles(0, 0, math.rad(90))
    pin.Parent = folder

    return folder
end

local function ScanRadarObstacles(hrp, moveDir)
    if not State.RadarAvoidance then
        return false, false, Vector3.zero
    end

    local char = LocalPlayer.Character
    local rayParams = RaycastParams.new()
    rayParams.FilterType = Enum.RaycastFilterType.Exclude
    rayParams.FilterDescendantsInstances = { char }
    rayParams.IgnoreWater = true

    local origin = hrp.Position + Vector3.new(0, -0.5, 0)
    local forward = moveDir.Unit
    local centerHit = Workspace:Raycast(origin, forward * 5.0, rayParams)
    
    local leftDir = (CFrame.Angles(0, math.rad(25), 0) * Vector3.new(forward.X, 0, forward.Z)).Unit
    local leftHit = Workspace:Raycast(origin, leftDir * 4.2, rayParams)

    local rightDir = (CFrame.Angles(0, math.rad(-25), 0) * Vector3.new(forward.X, 0, forward.Z)).Unit
    local rightHit = Workspace:Raycast(origin, rightDir * 4.2, rayParams)

    if not centerHit and not leftHit and not rightHit then
        return false, false, Vector3.zero
    end

    local shouldJump = false
    if centerHit then
        local highHit = Workspace:Raycast(hrp.Position + Vector3.new(0, 1.8, 0), forward * 5.0, rayParams)
        if not highHit then
            shouldJump = true
            return true, true, Vector3.zero
        end
    end

    local rightVector = Vector3.new(-forward.Z, 0, forward.X).Unit
    local steer = Vector3.zero
    if leftHit and not rightHit then
        steer = rightVector * 2.5
    elseif rightHit and not leftHit then
        steer = -rightVector * 2.5
    elseif centerHit then
        steer = rightVector * 2.5
    end

    return true, shouldJump, steer
end

