            local label = tostring(tp.th or tp.en or tp.id)
            if TP_BY_LABEL[label] then label = label .. " (" .. tostring(tp.id) .. ")" end
            local entry = { label = label, id = tp.id, group = tp.group, en = tp.en, foot = tp.foot, car = tp.car }
            table.insert(TP_ENTRIES, entry)
            table.insert(TP_LABELS, label)
            TP_BY_LABEL[label] = entry
            if tp.id then TP_BY_ID[tp.id] = entry end
        end
    end

    -- exact label/id first, then partial match on name / description / group
    local function ResolveTeleport(query)
        local q = NormName(query)
        if q == "" then return nil end
        for _, e in ipairs(TP_ENTRIES) do
            if NormName(e.label) == q or NormName(e.id) == q then return e end
        end
        for _, e in ipairs(TP_ENTRIES) do
            if NormName(e.label):find(q, 1, true) then return e end
        end
        for _, e in ipairs(TP_ENTRIES) do
            if NormName(e.en):find(q, 1, true) or NormName(e.group):find(q, 1, true) then return e end
        end
        return nil
    end

    local function TeleportToEntry(entry)
        if not entry then return false end
        local riding = TopVehicleModel()
        local cf = (riding and entry.car) or entry.foot or entry.car
        if not cf then return false end
        State.Gen = State.Gen + 1 -- cancel any walking/riding in progress
        SmartTeleport(cf)
        task.wait(0.3)
        local hrp = SafeRoot()
        local arrived = hrp and (Vector3.new(hrp.Position.X, 0, hrp.Position.Z) - Vector3.new(cf.Position.X, 0, cf.Position.Z)).Magnitude < 60
        if arrived then
            Library:Notify("Teleport", "Teleported to " .. entry.label, 3, "Success")
        else
            Library:Notify("Teleport", "Could not reach " .. entry.label .. " (area not loaded?). Try again.", 4, "Warning")
        end
        return arrived
    end

