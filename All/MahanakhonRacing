-- ANTI-CHEAT SAFE NAVIGATION & MOVEMENT
-- (Protected against Server AntiCheat Error 267: Tween / Noclip)
-- ═══════════════════════════════════════

-- Accurate multi-layer path computation using official RoadGraph & PathfindingService
local function ComputeNavigationPath(startPos, endPos)
    local totalDist = (endPos - startPos).Magnitude

    -- 1. Short-range local navigation (inside Construction site, Garage bays, or rooms)
    -- PathfindingService computes paths around all scaffolding, walls, and obstacles safely
    if totalDist <= 55 then
        local path = PathfindingService:CreatePath({
            AgentRadius = 2.0,
            AgentHeight = 5.0,
            AgentCanJump = true,
            WaypointSpacing = 3.5
        })
        local ok = pcall(function() path:ComputeAsync(startPos, endPos) end)
        if ok and path.Status == Enum.PathStatus.Success then
            return path:GetWaypoints()
        end
    end

    -- 2. Long-range city navigation (Delivery, traveling across Bangkok map)
    -- Uses the official ReplicatedStorage.RoadGraph to route STRICTLY on paved streets and through real gates!
    -- This guarantees zero building/wall collisions so Server AntiCheat never detects noclip/tween!
    local rsRoadGraph = ReplicatedStorage:FindFirstChild("RoadGraph")
    if rsRoadGraph then
        local ok, RoadGraph = pcall(require, rsRoadGraph)
        if ok and RoadGraph and RoadGraph.route then
            local wps2d, totalLen = RoadGraph.route(startPos, endPos)
            if wps2d and #wps2d > 0 then
                local waypoints = {}
                local rayParams = RaycastParams.new()
                rayParams.FilterType = Enum.RaycastFilterType.Include
                rayParams.FilterDescendantsInstances = { Workspace.Map }

                -- Helper to find real ground elevation for a 2D road node
                local function getRoadGround(pos2d, refY)
                    local baseRef = refY or 2.0
                    local testPos = Vector3.new(pos2d.X, math.clamp(baseRef + 6, 8, 25), pos2d.Y)
                    local hit = Workspace:Raycast(testPos, Vector3.new(0, -35, 0), rayParams)
                    local y = hit and hit.Position.Y or baseRef
                    return Vector3.new(pos2d.X, y, pos2d.Y)
                end

                -- Add start position
                table.insert(waypoints, { Position = startPos, Action = Enum.PathWaypointAction.Walk })

                -- Add intermediate road nodes with raycasted road elevation
                local lastY = startPos.Y
                for _, node2d in ipairs(wps2d) do
                    local node3d = getRoadGround(node2d, lastY)
                    lastY = node3d.Y
                    table.insert(waypoints, { Position = node3d, Action = Enum.PathWaypointAction.Walk })
                end

                -- Add target position
                table.insert(waypoints, { Position = endPos, Action = Enum.PathWaypointAction.Walk })
                return waypoints
            end
        end
    end

    -- 3. Fallback: PathfindingService with broader agent spacing
    local path = PathfindingService:CreatePath({
        AgentRadius = 2.5,
        AgentHeight = 5.0,
        AgentCanJump = true,
        WaypointSpacing = 5.0
    })
    local ok = pcall(function() path:ComputeAsync(startPos, endPos) end)
    if ok and path.Status == Enum.PathStatus.Success then
        return path:GetWaypoints()
    end

    return {
        { Position = startPos, Action = Enum.PathWaypointAction.Walk },
        { Position = endPos, Action = Enum.PathWaypointAction.Walk }
    }
end

