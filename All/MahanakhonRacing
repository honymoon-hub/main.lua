-- ANTI-CHEAT SAFE NAVIGATION & MOVEMENT
-- (Protected against Server AntiCheat Error 267: Tween / Noclip)
-- ═══════════════════════════════════════

-- Accurate multi-layer path computation using official RoadGraph & PathfindingService
-- Long trips: [start -> nearest road] by PathfindingService, [road -> road] along the real street graph (dense points,
-- so corners are not cut), [road -> destination] by PathfindingService. Nothing is ever a straight line across lawns.
local RoadGraphModule = nil
local function GetRoadGraph()
    if RoadGraphModule ~= nil then return RoadGraphModule or nil end
    local mod = ReplicatedStorage:FindFirstChild("RoadGraph")
    if mod then
        local ok, rg = pcall(require, mod)
        if ok and type(rg) == "table" and rg.route then
            RoadGraphModule = rg
            return rg
        end
    end
    RoadGraphModule = false
    return nil
end

-- PathfindingService leg between two points -> Vector3 list (first = a, last = b) or nil
local function PathLeg(a, b, forVehicle)
    if (a - b).Magnitude < 6 then return { a, b } end
    if (a - b).Magnitude > 700 then return nil end
    local path = PathfindingService:CreatePath({
        AgentRadius = forVehicle and 3.0 or 2.0,
        AgentHeight = 5.0,
        AgentCanJump = true,
        WaypointSpacing = forVehicle and 10 or 6
    })
    local ok = pcall(function() path:ComputeAsync(a, b) end)
    if ok and path.Status == Enum.PathStatus.Success then
        local list = {}
        for _, w in ipairs(path:GetWaypoints()) do
            table.insert(list, w.Position)
        end
        if #list >= 2 then return list end
    end
    return nil
end

-- Insert intermediate points so no gap is longer than `step` studs (keeps us on curved roads)
local function Densify(points, step)
    local out = {}
    for i, p in ipairs(points) do
        if i > 1 then
            local prev = points[i - 1]
            local n = math.floor((p - prev).Magnitude / step)
            for k = 1, n do
                table.insert(out, prev:Lerp(p, k / (n + 1)))
            end
        end
        table.insert(out, p)
    end
    return out
end

local function ToWaypoints(points)
    local wps = {}
    for _, p in ipairs(points) do
        local last = wps[#wps]
        if not last or (last.Position - p).Magnitude > 0.8 then
            table.insert(wps, { Position = p, Action = Enum.PathWaypointAction.Walk })
        end
    end
    return wps
end

local function ComputeNavigationPath(startPos, endPos, forVehicle)
    local totalDist = (endPos - startPos).Magnitude

    -- 1. Short-range local navigation (construction site, garage bays, rooms): PathfindingService around walls/scaffolding
    if totalDist <= 55 then
        local leg = PathLeg(startPos, endPos, forVehicle)
        if leg then
            return ToWaypoints(leg)
        end
    end

    -- 2. Long-range: follow the street graph from the nearest road all the way to the road nearest the destination
    local rg = State.FollowRoads and GetRoadGraph()
    if rg then
        local ok, wps2d, roadLen = pcall(rg.route, startPos, endPos)
        if ok and wps2d and #wps2d >= 4 and (not roadLen or roadLen < totalDist * 6 + 400) then
            local rayParams = RaycastParams.new()
            rayParams.FilterType = Enum.RaycastFilterType.Include
            rayParams.FilterDescendantsInstances = { Workspace:FindFirstChild("Map") or Workspace }

            local function getRoadGround(pos2d, refY)
                local baseRef = refY or 2.0
                local testPos = Vector3.new(pos2d.X, math.clamp(baseRef + 6, 8, 25), pos2d.Y)
                local hit = Workspace:Raycast(testPos, Vector3.new(0, -35, 0), rayParams)
                return Vector3.new(pos2d.X, hit and hit.Position.Y or baseRef, pos2d.Y)
            end

            -- road nodes (drop the raw start/end entries; those legs are done by PathfindingService)
            local mid = {}
            local lastY = startPos.Y
            for i = 2, #wps2d - 1 do
                local p = getRoadGround(wps2d[i], lastY)
                lastY = p.Y
                table.insert(mid, p)
            end

            local head = PathLeg(startPos, mid[1], forVehicle) or { startPos, mid[1] }
            local tail = PathLeg(mid[#mid], endPos, forVehicle) or { mid[#mid], endPos }

            local pts = {}
            for _, p in ipairs(head) do table.insert(pts, p) end
            for i = 2, #mid do table.insert(pts, mid[i]) end
            for i = 2, #tail do table.insert(pts, tail[i]) end

            return ToWaypoints(Densify(pts, forVehicle and 22 or 12))
        end
    end

    -- 3. Fallback: PathfindingService with broader agent spacing
    local leg = PathLeg(startPos, endPos, forVehicle)
    if leg then
        return ToWaypoints(Densify(leg, forVehicle and 22 or 12))
    end

    return {
        { Position = startPos, Action = Enum.PathWaypointAction.Walk },
        { Position = endPos, Action = Enum.PathWaypointAction.Walk }
    }
end

