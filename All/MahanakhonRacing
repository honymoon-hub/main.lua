-- Stop all movement immediately (humanoid + vehicle)
local function StopMotion()
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildWhichIsA("Humanoid")
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hum and hrp then
        pcall(function() hum:MoveTo(hrp.Position) end)
        local seat = hum.SeatPart
        if seat then
            if seat:IsA("VehicleSeat") then
                seat.ThrottleFloat = 0
                seat.SteerFloat = 0
            end
            local root = seat.AssemblyRootPart or seat
            root.AssemblyLinearVelocity = Vector3.new(0, root.AssemblyLinearVelocity.Y, 0)
            root.AssemblyAngularVelocity = Vector3.zero
        end
        if not State.WalkSpeedOn and hum.WalkSpeed > 20 then
            hum.WalkSpeed = 16
        end
    end
    CleanPathVisuals()
end

local function StopFarm()
    State.Gen = State.Gen + 1
    State.Status = "Idle"
    StopMotion()
end

-- Slowly pass through whatever is blocking us. Only the blocking props are made non-colliding
-- (NoCollisionConstraint), so we never fall through the road. Everything is removed again afterwards.
local function GhostThrough(root, goalPos, gen, vehicle)
    local char = LocalPlayer.Character
    if not (char and root) then return end

    local flatDir = Vector3.new(goalPos.X - root.Position.X, 0, goalPos.Z - root.Position.Z)
    if flatDir.Magnitude < 0.5 then return end
    flatDir = flatDir.Unit

    local params = OverlapParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local ignore = { char }
    if vehicle then table.insert(ignore, vehicle) end
    params.FilterDescendantsInstances = ignore

    local footY = root.Position.Y - (vehicle and 1.2 or 2.8)
    local boxCf = CFrame.lookAt(root.Position + flatDir * 5, root.Position + flatDir * 10)
    local nearby = Workspace:GetPartBoundsInBox(boxCf, Vector3.new(14, 12, 14), params)

    local obstacles = {}
    for _, p in ipairs(nearby) do
        if p:IsA("BasePart") and not p:IsA("Terrain") and p.CanCollide
            and p.Size.Magnitude < 250
            and (p.Position.Y + p.Size.Y / 2) > footY + 0.7 then -- skip anything that is just the ground
            table.insert(obstacles, p)
        end
    end
    table.sort(obstacles, function(a, b)
        return (a.Position - root.Position).Magnitude < (b.Position - root.Position).Magnitude
    end)
    while #obstacles > 10 do table.remove(obstacles) end
    if #obstacles == 0 then return end

    local mine = {}
    local function collect(model)
        for _, p in ipairs(model:GetDescendants()) do
            if p:IsA("BasePart") and p.CanCollide and #mine < 70 then
                table.insert(mine, p)
            end
        end
    end
    collect(char)
    if vehicle then collect(vehicle) end

    local folder = Instance.new("Folder")
    folder.Name = "MarioPhase"
    folder.Parent = Workspace
    for _, o in ipairs(obstacles) do
        for _, m in ipairs(mine) do
            local c = Instance.new("NoCollisionConstraint")
            c.Part0 = m
            c.Part1 = o
            c.Parent = folder
        end
    end

    -- crawl forward slowly while the props are ghosted
    local hum = char:FindFirstChildWhichIsA("Humanoid")
    local speed = vehicle and 20 or 12
    local startPos = root.Position
    local t0 = os.clock()
    while os.clock() - t0 < 2.2 and not Cancelled(gen) do
        if (Vector3.new(root.Position.X, 0, root.Position.Z) - Vector3.new(startPos.X, 0, startPos.Z)).Magnitude > 9 then break end
        if vehicle then
            root.AssemblyLinearVelocity = Vector3.new(flatDir.X * speed, root.AssemblyLinearVelocity.Y, flatDir.Z * speed)
        elseif hum then
            hum:MoveTo(root.Position + flatDir * 6)
            hum.Jump = false
        end
        task.wait(0.03)
    end
    task.wait(0.25) -- let us clear the prop before collisions come back
    pcall(function() folder:Destroy() end)
end

--- Realistic humanoid walking simulation with stuck recovery (hop/sidestep, then slow ghost-through)
local function SimWalk(targetPos, speed, maxTimeout)
    local gen = State.Gen
    local char = LocalPlayer.Character
    if not char then return false end
    local hum = char:FindFirstChildWhichIsA("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hum or not hrp then return false end

    if hum.Sit then
        hum.Sit = false
        task.wait(0.2)
    end

    local walkSpeed = speed or State.MechanicWalkSpeed or 26
    local prevSpeed = hum.WalkSpeed
    hum.WalkSpeed = walkSpeed
    local function restore()
        if not State.WalkSpeedOn then hum.WalkSpeed = prevSpeed end
    end

    local targetV3 = typeof(targetPos) == "CFrame" and targetPos.Position or targetPos
    local flatDist = (Vector3.new(targetV3.X, hrp.Position.Y, targetV3.Z) - hrp.Position).Magnitude

    if flatDist <= 3.5 then
        CleanPathVisuals()
        restore()
        return true
    end

    local waypoints = ComputeNavigationPath(hrp.Position, targetV3)
    RenderPathVisuals(waypoints)

    local startTime = os.clock()
    local timeout = maxTimeout or ((flatDist / walkSpeed) + 8.0)

    for _, wp in ipairs(waypoints) do
        if Cancelled(gen) or os.clock() - startTime > timeout then break end
        local wpPos = wp.Position
        if wp.Action == Enum.PathWaypointAction.Jump then
            hum.Jump = true
        end

        local wpStart = os.clock()
        local lastPos, lastCheck, stuck = hrp.Position, os.clock(), 0
        while (Vector3.new(wpPos.X, hrp.Position.Y, wpPos.Z) - hrp.Position).Magnitude > 3.0 do
            if Cancelled(gen) or os.clock() - wpStart > 6.0 then break end

            local toWp = (wpPos - hrp.Position)
            local _, jump, steer = ScanRadarObstacles(hrp, toWp)
            if jump then
                hum.Jump = true
            end
            hum:MoveTo(wpPos + steer)

            -- stuck detection: barely moved in 0.8s although we are walking
            if os.clock() - lastCheck >= 0.8 then
                local moved = (hrp.Position - lastPos).Magnitude
                lastPos, lastCheck = hrp.Position, os.clock()
                if moved < 1.5 then
                    stuck = stuck + 1
                    if stuck == 1 then
                        -- hop and sidestep around it
                        hum.Jump = true
                        local fwd = Vector3.new(toWp.X, 0, toWp.Z)
                        if fwd.Magnitude > 0.1 then
                            local side = Vector3.new(-fwd.Unit.Z, 0, fwd.Unit.X) * (math.random() < 0.5 and 6 or -6)
                            hum:MoveTo(hrp.Position + side + fwd.Unit * 3)
                            task.wait(0.5)
                        end
                    else
                        stuck = 0
                        if State.AntiStuck then
                            GhostThrough(hrp, wpPos, gen, nil)
                        end
                        wpStart = os.clock()
                    end
                else
                    stuck = 0
                end
            end
            task.wait(0.05)
        end
    end

    if Cancelled(gen) then
        StopMotion()
    end
    CleanPathVisuals()
    restore()

    return (Vector3.new(targetV3.X, hrp.Position.Y, targetV3.Z) - hrp.Position).Magnitude <= 5.0
end

-- Ensure player is mounted on a MOTORCYCLE for SimRide
local function EnsureMotorcycle()
    local char = LocalPlayer.Character
    if not char then return nil end
    local hum = char:FindFirstChildWhichIsA("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hum or not hrp then return nil end

    local function isMotorcycle(model)
        if not model then return false end
        local n = model.Name:upper()
        local tag = tostring(model:GetAttribute("VehicleTag") or ""):upper()
        return n:find("PCX") or n:find("WAVE") or n:find("VESPA") or n:find("XMAX") or n:find("LEAD") or n:find("GIORNO") or n:find("SPORT") or n:find("DREAM") or tag:find("PCX") or tag:find("BIKE") or tag:find("WAVE")
    end

    -- 1. Check if already sitting on a motorcycle
    if hum.Sit and hum.SeatPart then
        local currentVeh = hum.SeatPart:FindFirstAncestorOfClass("Model")
        if isMotorcycle(currentVeh) then
            return currentVeh
        end
    end

    -- 2. Check if player has a spawned motorcycle in SpawnedVehicles
    local sv = Workspace:FindFirstChild("SpawnedVehicles")
    local myBike = nil
    if sv then
        for _, v in ipairs(sv:GetChildren()) do
            if v:GetAttribute("OwnerUserId") == LocalPlayer.UserId and isMotorcycle(v) then
                myBike = v
                break
            end
        end
    end

    -- 3. If no motorcycle is spawned, spawn PCX160
    if not myBike then
        pcall(NetSeal.invoke, GarageRemote, "Spawn", "PCX160")
        task.wait(1.2)
        if sv then
            for _, v in ipairs(sv:GetChildren()) do
                if v:GetAttribute("OwnerUserId") == LocalPlayer.UserId and isMotorcycle(v) then
                    myBike = v
                    break
                end
            end
        end
    end

    -- 4. Mount the motorcycle
    if myBike and hum then
        local seat = myBike:FindFirstChildWhichIsA("VehicleSeat", true) or myBike:FindFirstChildWhichIsA("Seat", true)
        if seat then
            hrp.CFrame = seat.CFrame + Vector3.new(0, 1.5, 0)
            task.wait(0.15)
            seat:Sit(hum)
            task.wait(0.4)
            -- Start bike engine and raise stand
            pcall(function()
                local remoteName = myBike:GetAttribute("VehicleTag") and (myBike:GetAttribute("VehicleTag") .. "Remote") or "PCX160Remote"
                local remote = ReplicatedStorage:FindFirstChild(remoteName) or ReplicatedStorage:FindFirstChild("PCX160Remote")
                if remote then
                    NetSeal.fire(remote, "Stand", false)
                    NetSeal.fire(remote, "Engine", true)
                end
            end)
        end
    end

    return myBike
end

-- SimRide: motorcycle driving via physics velocity, with stuck recovery (reverse + turn, then slow ghost-through)
local function SimRide(targetPos, speed, maxTimeout)
    local gen = State.Gen
    local char = LocalPlayer.Character
    if not char then return false end
    local hum = char:FindFirstChildWhichIsA("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hum or not hrp then return false end

    local targetV3 = typeof(targetPos) == "CFrame" and targetPos.Position or targetPos

    -- MUST DRIVE MOTORCYCLE FOR SIMRIDE:
    local bike = EnsureMotorcycle()
    if not bike or not hum.Sit then
        return SimWalk(targetV3, speed or State.DeliveryWalkSpeed or 28, maxTimeout)
    end

    local chassis = bike.PrimaryPart or bike:FindFirstChild("Chassis") or bike:FindFirstChild("RootPart") or hum.SeatPart
    if not chassis then
        return SimWalk(targetV3, speed or State.DeliveryWalkSpeed or 28, maxTimeout)
    end

    local seat = hum.SeatPart
    local rideSpeed = speed or State.DeliveryRideSpeed or 65
    local flatDist = (Vector3.new(targetV3.X, chassis.Position.Y, targetV3.Z) - chassis.Position).Magnitude

    local function halt()
        chassis.AssemblyLinearVelocity = Vector3.new(0, chassis.AssemblyLinearVelocity.Y, 0)
        chassis.AssemblyAngularVelocity = Vector3.zero
        if seat and seat:IsA("VehicleSeat") then
            seat.ThrottleFloat = 0
            seat.SteerFloat = 0
        end
        CleanPathVisuals()
    end

    if flatDist <= 10.0 then
        halt()
        return true
    end

    local waypoints = ComputeNavigationPath(chassis.Position, targetV3)
    RenderPathVisuals(waypoints)

    local startTime = os.clock()
    local timeout = maxTimeout or ((flatDist / rideSpeed) + 18.0)

    for _, wp in ipairs(waypoints) do
        if Cancelled(gen) or os.clock() - startTime > timeout then break end
        if not hum.Sit then break end

        local wpPos = wp.Position
        local wpStart = os.clock()
        local lastPos, lastCheck, stuck = chassis.Position, os.clock(), 0

        while (Vector3.new(wpPos.X, chassis.Position.Y, wpPos.Z) - chassis.Position).Magnitude > 9.0 do
            if Cancelled(gen) or os.clock() - wpStart > 8.0 then break end
            if not hum.Sit then break end

            local currentPos = chassis.Position
            local toWp = (wpPos - currentPos)
            local flatDir = Vector3.new(toWp.X, 0, toWp.Z)
            if flatDir.Magnitude < 0.2 then break end
            local moveUnit = flatDir.Unit

            local steerOffset = Vector3.zero
            if State.RadarAvoidance then
                local hasObs, _, steer = ScanRadarObstacles(chassis, moveUnit * 10.0)
                if hasObs then steerOffset = steer end
            end
            local finalDir = (moveUnit + steerOffset * 0.4).Unit

            -- rotate only (position untouched) and drive with natural velocity
            chassis.CFrame = CFrame.lookAt(currentPos, currentPos + Vector3.new(finalDir.X, 0, finalDir.Z))
            chassis.AssemblyLinearVelocity = Vector3.new(finalDir.X * rideSpeed, chassis.AssemblyLinearVelocity.Y, finalDir.Z * rideSpeed)
            chassis.AssemblyAngularVelocity = Vector3.zero
            if seat and seat:IsA("VehicleSeat") then
                seat.ThrottleFloat = 1.0
            end

            -- stuck detection: barely moved in 0.9s although we are at full throttle
            if os.clock() - lastCheck >= 0.9 then
                local moved = (chassis.Position - lastPos).Magnitude
                lastPos, lastCheck = chassis.Position, os.clock()
                if moved < 2.0 then
                    stuck = stuck + 1
                    if stuck == 1 then
                        -- back up while turning away from the obstacle
                        local side = Vector3.new(-moveUnit.Z, 0, moveUnit.X) * (math.random() < 0.5 and 1 or -1)
                        local backDir = (-moveUnit + side * 0.8).Unit
                        local t0 = os.clock()
                        while os.clock() - t0 < 0.7 and not Cancelled(gen) do
                            chassis.CFrame = CFrame.lookAt(chassis.Position, chassis.Position + Vector3.new(moveUnit.X, 0, moveUnit.Z))
                            chassis.AssemblyLinearVelocity = Vector3.new(backDir.X * 14, chassis.AssemblyLinearVelocity.Y, backDir.Z * 14)
                            task.wait(0.04)
                        end
                    else
                        stuck = 0
                        halt()
                        if State.AntiStuck then
                            GhostThrough(chassis, wpPos, gen, bike)
                        end
                        wpStart = os.clock()
                    end
                else
                    stuck = 0
                end
            end

            task.wait(0.04)
        end
    end

    halt()

    local finalFlatDist = (Vector3.new(targetV3.X, chassis.Position.Y, targetV3.Z) - chassis.Position).Magnitude
    return finalFlatDist <= 18.0
end

