local function VehicleMatches(model, id)
    id = tostring(id):upper()
    return tostring(model:GetAttribute("VehicleId") or ""):upper() == id or model.Name:upper() == id
end

local function MountVehicle(veh)
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildWhichIsA("Humanoid")
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not (veh and hum and hrp) then return false end
    local seat = veh:FindFirstChildWhichIsA("VehicleSeat", true) or veh:FindFirstChildWhichIsA("Seat", true)
    if not seat then return false end
    if hum.SeatPart == seat then return true end
    hrp.CFrame = seat.CFrame + Vector3.new(0, 1.5, 0)
    task.wait(0.15)
    seat:Sit(hum)
    task.wait(0.4)
    pcall(function()
        local tag = veh:GetAttribute("VehicleTag") or veh:GetAttribute("VehicleId") or veh.Name
        local remote = ReplicatedStorage:FindFirstChild(tostring(tag) .. "Remote") or ReplicatedStorage:FindFirstChild("PCX160Remote")
        if remote then
            NetSeal.fire(remote, "Stand", false)
            NetSeal.fire(remote, "Engine", true)
        end
    end)
    return hum.SeatPart == seat
end

-- Make sure we sit in the vehicle picked in the Vehicle tab (takes it out of the garage when needed)
local function EnsureChosenVehicle(id)
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildWhichIsA("Humanoid")
    if not hum then return nil end

    local cur = TopVehicleModel()
    if cur and VehicleMatches(cur, id) then return cur end

    local function findOwned()
        for _, v in ipairs(OwnedVehicles()) do
            if VehicleMatches(v, id) then return v end
        end
    end

    local veh = findOwned()
    if not veh then
        pcall(NetSeal.invoke, GarageRemote, "Spawn", id)
        for _ = 1, 15 do
            task.wait(0.2)
            veh = findOwned()
            if veh then break end
        end
    end
    if veh then
        MountVehicle(veh)
        return veh
    end
    return nil
end

-- Ensure player is mounted on the work vehicle (chosen vehicle, or a motorcycle by default) for SimRide
local function EnsureMotorcycle()
    local char = LocalPlayer.Character
    if not char then return nil end
    if State.WorkVehicle and State.WorkVehicle ~= "Auto" then
        return EnsureChosenVehicle(State.WorkVehicle)
    end
    local hum = char:FindFirstChildWhichIsA("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hum or not hrp then return nil end

    local function isMotorcycle(model)
        if not model then return false end
        local n = model.Name:upper()
        local tag = tostring(model:GetAttribute("VehicleTag") or ""):upper()
        return n:find("PCX") or n:find("WAVE") or n:find("VESPA") or n:find("XMAX") or n:find("LEAD") or n:find("GIORNO") or n:find("SPORT") or n:find("DREAM") or tag:find("PCX") or tag:find("BIKE") or tag:find("WAVE")
    end

    -- 1. Check if already sitting on a motorcycle
    if hum.Sit and hum.SeatPart then
        local currentVeh = hum.SeatPart:FindFirstAncestorOfClass("Model")
        if isMotorcycle(currentVeh) then
            return currentVeh
        end
    end

    -- 2. Check if player has a spawned motorcycle in SpawnedVehicles
    local sv = Workspace:FindFirstChild("SpawnedVehicles")
    local myBike = nil
    if sv then
        for _, v in ipairs(sv:GetChildren()) do
            if v:GetAttribute("OwnerUserId") == LocalPlayer.UserId and isMotorcycle(v) then
                myBike = v
                break
            end
        end
    end

    -- 3. If no motorcycle is spawned, spawn PCX160
    if not myBike then
        pcall(NetSeal.invoke, GarageRemote, "Spawn", "PCX160")
        task.wait(1.2)
        if sv then
            for _, v in ipairs(sv:GetChildren()) do
                if v:GetAttribute("OwnerUserId") == LocalPlayer.UserId and isMotorcycle(v) then
                    myBike = v
                    break
                end
            end
        end
    end

    -- 4. Mount the motorcycle
    if myBike and hum then
        local seat = myBike:FindFirstChildWhichIsA("VehicleSeat", true) or myBike:FindFirstChildWhichIsA("Seat", true)
        if seat then
            hrp.CFrame = seat.CFrame + Vector3.new(0, 1.5, 0)
            task.wait(0.15)
            seat:Sit(hum)
            task.wait(0.4)
            -- Start bike engine and raise stand
            pcall(function()
                local remoteName = myBike:GetAttribute("VehicleTag") and (myBike:GetAttribute("VehicleTag") .. "Remote") or "PCX160Remote"
                local remote = ReplicatedStorage:FindFirstChild(remoteName) or ReplicatedStorage:FindFirstChild("PCX160Remote")
                if remote then
                    NetSeal.fire(remote, "Stand", false)
                    NetSeal.fire(remote, "Engine", true)
                end
            end)
        end
    end

    return myBike
end

-- SimRide: motorcycle driving via physics velocity, with stuck recovery (reverse + turn, then slow ghost-through)
-- SimRide: drive a vehicle along the road graph. Straight-line speed and corner speed are separate settings,
-- small props are ghosted and big obstacles are detoured with PathfindingService (when "Noclip + Avoid" is on),
-- and stuck recovery (reverse + turn, then slow ghost-through) stays as the last resort.
local function SimRide(targetPos, speed, maxTimeout, useCurrent)
    local gen = State.Gen
    local char = LocalPlayer.Character
    if not char then return false end
    local hum = char:FindFirstChildWhichIsA("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hum or not hrp then return false end

    local targetV3 = typeof(targetPos) == "CFrame" and targetPos.Position or targetPos

    local bike = useCurrent and (TopVehicleModel()) or nil
    bike = bike or EnsureMotorcycle()
    if not bike or not hum.Sit then
        return SimWalk(targetV3, speed or State.DeliveryWalkSpeed or 28, maxTimeout)
    end

    local chassis = bike.PrimaryPart or bike:FindFirstChild("Chassis") or bike:FindFirstChild("RootPart") or hum.SeatPart
    if not chassis then
        return SimWalk(targetV3, speed or State.DeliveryWalkSpeed or 28, maxTimeout)
    end

    local seat = hum.SeatPart
    local straight = State.RideSpeedStraight or speed or State.DeliveryRideSpeed or 65
    local corner = math.min(State.RideSpeedCorner or 35, straight)
    local flatDist = (Vector3.new(targetV3.X, chassis.Position.Y, targetV3.Z) - chassis.Position).Magnitude

    local function halt()
        chassis.AssemblyLinearVelocity = Vector3.new(0, chassis.AssemblyLinearVelocity.Y, 0)
        chassis.AssemblyAngularVelocity = Vector3.zero
        if seat and seat:IsA("VehicleSeat") then
            seat.ThrottleFloat = 0
            seat.SteerFloat = 0
        end
        CleanPathVisuals()
    end

    if flatDist <= 10.0 then
        halt()
        return true
    end

    local waypoints = ComputeNavigationPath(chassis.Position, targetV3, true)
    RenderPathVisuals(waypoints)

    local startTime = os.clock()
    local timeout = maxTimeout or ((flatDist * 1.8 / math.max((straight + corner) / 2, 15)) + 22.0)
    local lastAvoid, lastDetour = 0, 0

    local function angleBetween(a, b)
        return math.deg(math.acos(math.clamp(a:Dot(b), -1, 1)))
    end

    local driveTo
    driveTo = function(wpPos, nextPos, allowDetour)
        local wpStart = os.clock()
        local lastPos, lastCheck, stuck = chassis.Position, os.clock(), 0

        while (Vector3.new(wpPos.X, chassis.Position.Y, wpPos.Z) - chassis.Position).Magnitude > 9.0 do
            if Cancelled(gen) or os.clock() - wpStart > 8.0 then return false end
            if not hum.Sit then return false end

            local currentPos = chassis.Position
            local toWp = (wpPos - currentPos)
            local flatDir = Vector3.new(toWp.X, 0, toWp.Z)
            if flatDir.Magnitude < 0.2 then return true end
            local moveUnit = flatDir.Unit

            -- slow down for corners: sharp turn right now, or a sharp bend right after this waypoint
            local spd = straight
            local sharp = 0
            local look = chassis.CFrame.LookVector
            local lookFlat = Vector3.new(look.X, 0, look.Z)
            if lookFlat.Magnitude > 0.05 then
                sharp = angleBetween(lookFlat.Unit, moveUnit)
            end
            if nextPos and flatDir.Magnitude < 28 then
                local seg = Vector3.new(nextPos.X - wpPos.X, 0, nextPos.Z - wpPos.Z)
                if seg.Magnitude > 0.5 then
                    sharp = math.max(sharp, angleBetween(moveUnit, seg.Unit))
                end
            end
            if sharp > 25 then
                spd = straight + (corner - straight) * math.clamp((sharp - 25) / 55, 0, 1)
            end

            -- Noclip + avoid: ghost small props, detour around big ones
            if State.NoclipAvoid and os.clock() - lastAvoid > 0.12 then
                lastAvoid = os.clock()
                local kind = AvoidAhead(chassis, moveUnit, bike)
                if kind == "big" then
                    spd = math.min(spd, corner)
                    if allowDetour and os.clock() - lastDetour > 3 then
                        lastDetour = os.clock()
                        local leg = PathLeg(chassis.Position, wpPos, true)
                        if leg and #leg >= 3 then
                            leg = Densify(leg, 14)
                            for i, p in ipairs(leg) do
                                if not driveTo(p, leg[i + 1], false) then break end
                            end
                            wpStart = os.clock()
                            lastPos, lastCheck, stuck = chassis.Position, os.clock(), 0
                        end
                    end
                end
            end

            local finalDir = moveUnit
            if State.RadarAvoidance and not State.NoclipAvoid then
                local hasObs, _, steer = ScanRadarObstacles(chassis, moveUnit * 10.0)
                if hasObs then finalDir = (moveUnit + steer * 0.4).Unit end
            end

            currentPos = chassis.Position
            chassis.CFrame = CFrame.lookAt(currentPos, currentPos + Vector3.new(finalDir.X, 0, finalDir.Z))
            chassis.AssemblyLinearVelocity = Vector3.new(finalDir.X * spd, chassis.AssemblyLinearVelocity.Y, finalDir.Z * spd)
            chassis.AssemblyAngularVelocity = Vector3.zero
            if seat and seat:IsA("VehicleSeat") then
                seat.ThrottleFloat = 1.0
            end

            -- stuck detection: barely moved in 0.9s although we are at full throttle
            if os.clock() - lastCheck >= 0.9 then
                local moved = (chassis.Position - lastPos).Magnitude
                lastPos, lastCheck = chassis.Position, os.clock()
                if moved < 2.0 then
                    stuck = stuck + 1
                    if stuck == 1 then
                        local side = Vector3.new(-moveUnit.Z, 0, moveUnit.X) * (math.random() < 0.5 and 1 or -1)
                        local backDir = (-moveUnit + side * 0.8).Unit
                        local t0 = os.clock()
                        while os.clock() - t0 < 0.7 and not Cancelled(gen) do
                            chassis.CFrame = CFrame.lookAt(chassis.Position, chassis.Position + Vector3.new(moveUnit.X, 0, moveUnit.Z))
                            chassis.AssemblyLinearVelocity = Vector3.new(backDir.X * 14, chassis.AssemblyLinearVelocity.Y, backDir.Z * 14)
                            task.wait(0.04)
                        end
                    else
                        stuck = 0
                        halt()
                        if State.AntiStuck then
                            GhostThrough(chassis, wpPos, gen, bike)
                        end
                        wpStart = os.clock()
                    end
                else
                    stuck = 0
                end
            end

            task.wait(0.04)
        end
        return true
    end

    for i, wp in ipairs(waypoints) do
        if Cancelled(gen) or os.clock() - startTime > timeout then break end
        if not hum.Sit then break end
        local nxt = waypoints[i + 1]
        driveTo(wp.Position, nxt and nxt.Position or nil, true)
    end

    halt()
    ClearAvoid()

    local finalFlatDist = (Vector3.new(targetV3.X, chassis.Position.Y, targetV3.Z) - chassis.Position).Magnitude
    return finalFlatDist <= 18.0
end

