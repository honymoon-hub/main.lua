-- KAITUN (ALL-IN-ONE SCHEDULER)
-- Rotates through every money job, finishing the current order/task before switching.
-- ═══════════════════════════════════════
local KAITUN_ORDER = { "Grab", "Delivery", "Courier", "Mechanic", "Builder" }
local Kaitun = {
    current = nil,
    sliceStart = os.clock(),
    blocked = {},      -- job -> os.clock() until which it is skipped (failed to switch)
    failures = {},     -- job -> consecutive switch failures
    startCash = nil,
    activeJob = nil,   -- job we are currently clocked in as (rotation timer starts from here)
}
xDTaraZ.Kaitun = Kaitun

local function KaitunList()
    local list = {}
    for _, j in ipairs(KAITUN_ORDER) do
        local blockedUntil = Kaitun.blocked[j]
        if State.KaitunJobs[j] and not (blockedUntil and os.clock() < blockedUntil) then
            table.insert(list, j)
        end
    end
    return list
end

-- Safe to leave the current job: no task in progress / no order being carried
local function KaitunSafePoint(job)
    if job == "Mechanic" or job == "Builder" then
        return ReadWorkTask() == nil
    end
    local st = LocalPlayer:GetAttribute("DeliveryState") or "Off"
    return st == "Off" or st == "Searching" or st == "Offer"
end

local function RunActivity(job)
    if job == "Mechanic" or job == "Builder" then
        return RunWorkStep(job, State.KaitunMoveMode)
    end
    local mode = nil
    if job == "Delivery" then
        mode = (State.DeliveryMode == "ride") and "ride" or "food"
    end
    return RunDeliveryStep(job, mode)
end

local function RunKaitunStep()
    if not SafeRoot() then
        task.wait(1)
        return
    end
    if not Kaitun.startCash then
        Kaitun.startCash = LocalPlayer:GetAttribute("Cash") or 0
    end

    local list = KaitunList()
    if #list == 0 then
        SetStatus("Kaitun: no job selected")
        task.wait(1)
        return
    end

    local idx = table.find(list, Kaitun.current)
    if not idx then
        -- current job removed / blocked: leave any delivery cleanly, then move on
        if Kaitun.current and (LocalPlayer:GetAttribute("DeliveryState") or "Off") ~= "Off" and KaitunSafePoint(Kaitun.current) then
            Call(DeliveryRemote, "Stop")
        end
        Kaitun.current = list[1]
        Kaitun.sliceStart = os.clock()
        Kaitun.activeJob = nil
        idx = 1
    elseif #list > 1 and os.clock() - Kaitun.sliceStart >= State.KaitunSlice * 60 and KaitunSafePoint(Kaitun.current) then
        if (LocalPlayer:GetAttribute("DeliveryState") or "Off") ~= "Off" then
            Call(DeliveryRemote, "Stop")
            task.wait(0.4)
        end
        Kaitun.current = list[idx % #list + 1]
        Kaitun.sliceStart = os.clock()
        Kaitun.activeJob = nil
    end

    local job = Kaitun.current
    local before = GetJob()
    -- the rotation timer starts once we are actually in the job (not while walking to the locker)
    if before == job and Kaitun.activeJob ~= job then
        Kaitun.activeJob = job
        Kaitun.sliceStart = os.clock()
    end
    RunActivity(job)

    -- Could not become this job a few times in a row: skip it for 3 minutes
    if before ~= job and GetJob() ~= job then
        Kaitun.failures[job] = (Kaitun.failures[job] or 0) + 1
        if Kaitun.failures[job] >= 3 then
            Kaitun.failures[job] = 0
            Kaitun.blocked[job] = os.clock() + 180
            warn("[Honymoon Hub] Kaitun: could not switch to " .. job .. ", skipping for 3 min")
        end
    else
        Kaitun.failures[job] = 0
    end
end

