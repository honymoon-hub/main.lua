-- The real client answers with (id, stamp). stamp = { c = checksum(id), t = seconds since last input, i = real input }.
-- Without a valid stamp the server treats the answer as a bot. Hidden options (h == true) are honeypots, "g" challenges are ghosts.
local function FarmCheckStamp(id)
    id = tostring(id)
    local sum = 7
    for i = 1, #id do
        sum = (sum * 31 + string.byte(id, i) * i) % 65521
    end
    return { c = sum, t = math.floor(math.random(40, 160)) / 100, i = true }
end

local function PickVisibleOptions(data)
    local list = {}
    for _, opt in ipairs(data.options or {}) do
        if opt.h ~= true then
            table.insert(list, opt)
        end
    end
    return list
end

