    local MoveBox = MiscTab:AddLeftGroupbox(T("Movement", "การเคลื่อนที่"), "walk")
    MoveBox:AddToggle("WalkSpeedOn", {
        Text = T("Enable WalkSpeed", "เปิดความเร็วการเดิน"),
        Default = State.WalkSpeedOn,
        Callback = function(v) State.WalkSpeedOn = v end
    })
    MoveBox:AddSlider("WalkSpeed", {
        Text = T("Walk Speed", "ความเร็ว"),
        Min = 16,
        Max = 150,
        Default = State.WalkSpeed,
        Rounding = 0,
        Callback = function(v) State.WalkSpeed = v end
    })
    MoveBox:AddToggle("InfJump", {
        Text = T("Infinite Jump", "กระโดดได้ไม่จำกัด"),
        Default = State.InfJump,
        Callback = function(v) State.InfJump = v end
    })
    MoveBox:AddToggle("Noclip", {
        Text = T("Noclip (Warning: Triggers Kick 267)", "เดินทะลุกำแพง (คำเตือน: ห้ามใช้ มีตรวจจับ 267)"),
        Default = State.Noclip,
        Callback = function(v) State.Noclip = v end
    })
    local SysBox = MiscTab:AddRightGroupbox(T("System & Hub", "ระบบและฮับ"), "shield")
    SysBox:AddToggle("AntiAfk", {
        Text = T("Anti-AFK", "ป้องกันหลุดจากการอยู่เฉยๆ"),
        Default = State.AntiAfk,
        Callback = function(v) State.AntiAfk = v end
    })
    SysBox:AddToggle("AutoReconnect", {
        Text = T("Auto Reconnect", "เชื่อมต่อเซิร์ฟเวอร์ใหม่อัตโนมัติ"),
        Default = State.AutoReconnect,
        Callback = function(v) State.AutoReconnect = v end
    })
    SysBox:AddButton({
        Text = T("Rejoin Server", "เข้าเซิร์ฟเวอร์เดิมใหม่"),
        Func = function()
            TeleportService:Teleport(game.PlaceId, LocalPlayer)
        end
    })
    SysBox:AddButton({
        Text = T("Copy Discord Link", "คัดลอกลิงก์ Discord"),
        Style = "Primary",
        Func = function()
            local copy = setclipboard or toclipboard
            if copy then copy(Config.Discord) end
            Library:Notify("Discord", "Copied discord link to clipboard!", 3, "Info")
        end
    })
    local AnonymizerBox = MiscTab:AddLeftGroupbox(T("Fake Name / Streamer Mode", "การพรางชื่อ / สตรีมเมอร์"), "user")
    AnonymizerBox:AddToggle("FakeNameEnabled", {
        Text = T("Enable Fake Name", "เปิดใช้งานชื่อปลอม"),
        Description = T("Hides your real username and displays Honymoon Hub on nametags and HUDs", "ซ่อนชื่อจริงและแสดงชื่อ Honymoon Hub บนหัวตัวละครและหน้าจอ"),
        Default = State.FakeNameEnabled,
        Callback = function(v)
            State.FakeNameEnabled = v
            if v then
                ApplyFakeName()
                Library:Notify("Fake Name", "Fake Name active: " .. State.FakeName, 3, "Success")
            else
                local char = LocalPlayer.Character
                local tag = char and char:FindFirstChild("Nametag", true)
                local pn = tag and tag:FindFirstChild("PlayerName")
                if pn then pn.Text = RealName end
                Library:Notify("Fake Name", "Restored real name", 3, "Info")
            end
        end
    })
    AnonymizerBox:AddInput("FakeNameInput", {
        Text = T("Custom Fake Name", "ชื่อปลอมที่ต้องการแสดง"),
        Default = State.FakeName,
        Placeholder = "Honymoon Hub",
        Callback = function(v)
            if v and v ~= "" then
                State.FakeName = v
                ApplyFakeName()
            end
        end
    })
    AnonymizerBox:AddButton({
        Text = T("Apply Fake Name Now", "อัปเดตชื่อปลอมทันที"),
        Func = function()
            ApplyFakeName()
            Library:Notify("Fake Name", "Applied: " .. State.FakeName, 3, "Success")
        end
    })
    Window:AddSettingsTab()
    pcall(MarioBanner.Ready)
end
-- Cleanup on unload
getgenv().MahanakhonRacingUnload = function()
    State.Alive = false
    State.Gen = State.Gen + 1
    pcall(StopMotion)
    pcall(function()
        local f = Workspace:FindFirstChild("MarioPhase")
        if f then f:Destroy() end
    end)
    State.Kaitun = false
    State.AutoMechanic = false
    State.AutoBuilder = false
    State.AutoDelivery = false
    for _, c in ipairs(Connections) do pcall(function() c:Disconnect() end) end
    CleanPathVisuals()
end
BuildInterface()
