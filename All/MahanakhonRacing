end

-- Delivery family: Delivery (food / ride), Courier (parcel), Grab (own-bike rides)
local DELIVERY_JOBS = {
    Delivery = { job = "Delivery", mode = "food" },
    Courier = { job = "Courier", mode = "parcel" },
    Grab = { job = "Grab", mode = "grab" },
}

local function DeliveryMove(target)
    if State.DeliveryMoveMode == "SimRide" then
        return SimRide(target, State.DeliveryRideSpeed)
    elseif State.DeliveryMoveMode == "SimWalk" then
        return SimWalk(target, State.DeliveryWalkSpeed)
    end
    return SafeTeleport(target + Vector3.new(0, 1.5, 0))
end

-- Go to the target, wait for the server to mark us "arrived" (stopped inside the radius), then confirm
local function DeliveryGoAndConfirm(target, label)
    local gen = State.Gen
    for _ = 1, 3 do
        if Cancelled(gen) then return false end
        SetStatus(label)
        DeliveryMove(target)
        local t0 = os.clock()
        while os.clock() - t0 < 3.5 do
            if Cancelled(gen) then return false end
            if LocalPlayer:GetAttribute("DeliveryArrived") == true then
                Call(DeliveryRemote, "Confirm", nil)
                task.wait(0.6)
                return true
            end
            task.wait(0.2)
        end
    end
    return false
end

local function RunDeliveryStep(jobName, mode)
    local gen = State.Gen
    local info = DELIVERY_JOBS[jobName] or DELIVERY_JOBS.Delivery
    mode = mode or info.mode

    if GetJob() ~= info.job then
        SetStatus("Switching job -> " .. info.job)
        return SwitchJob(info.job)
    end

    local delState = LocalPlayer:GetAttribute("DeliveryState") or "Off"
    local jobObj = DeliveryShared.decode(LocalPlayer:GetAttribute("DeliveryJob"))

    if delState == "Off" then
        -- Courier parcels are started at the depot
        if info.job == "Courier" and JobShared.DEPOT then
            local depot = Vector3.new(JobShared.DEPOT.x, (JobShared.DEPOT.y or 0) + 2, JobShared.DEPOT.z)
            local hrp = SafeRoot()
            if hrp and (Vector3.new(depot.X, hrp.Position.Y, depot.Z) - hrp.Position).Magnitude > 40 then
                SetStatus("Courier: going to the depot")
                DeliveryMove(depot)
            end
        end
        if Cancelled(gen) then return true end
        SetStatus(info.job .. ": starting (" .. mode .. ")")
        Call(DeliveryRemote, "Start", mode)
        task.wait(1)
        return true
    end

    if delState == "Searching" then
        SetStatus(info.job .. ": searching for orders")
        task.wait(0.5)
        return true
    end

    if delState == "Offer" then
        if State.MinFee > 0 and jobObj and (jobObj.fee or 0) < State.MinFee then
            Call(DeliveryRemote, "Skip", nil)
            task.wait(0.5)
        elseif State.AutoAcceptOffer then
            Call(DeliveryRemote, "Accept", nil)
            task.wait(0.5)
        end
        return true
    end

    if not jobObj then
        task.wait(0.3)
        return true
    end

    if delState == "ToShop" or delState == "ToHome" then
        local target = DeliveryShared.target(delState, jobObj)
        if target then
            local label = (delState == "ToShop" and info.job .. ": pick-up" or info.job .. ": drop-off")
            if jobObj.fee then label = label .. string.format(" (฿%s)", GameShared.formatNumber(jobObj.fee)) end
            DeliveryGoAndConfirm(target + Vector3.new(0, 2, 0), label)
        end
    end
    return true
end

