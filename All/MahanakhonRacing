local function SafeRoot()
    local char = LocalPlayer.Character
    if not char then return nil end
    return char:FindFirstChild("HumanoidRootPart")
end
-- Top-most vehicle model we are sitting in (nil on foot)
local function TopVehicleModel()
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChildWhichIsA("Humanoid")
    local seat = hum and hum.SeatPart
    if not seat then return nil, nil end
    local m = seat
    while m.Parent and m.Parent ~= Workspace and m.Parent:IsA("Model") do
        m = m.Parent
    end
    if not m:IsA("Model") then
        m = seat:FindFirstAncestorWhichIsA("Model")
    end
    return m, seat
end

-- Teleport that actually lands you on the ground: streams the area in, finds the real floor with a raycast,
-- and moves the whole vehicle (not just the character) when you are riding.
local function SafeTeleport(target)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return false end

    local cf = typeof(target) == "CFrame" and target or CFrame.new(target)
    local pos = cf.Position

    pcall(function() LocalPlayer:RequestStreamAroundAsync(pos, 4) end)

    local veh, seat = TopVehicleModel()
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = veh and { char, veh } or { char }
    params.IgnoreWater = true

    -- the coordinates are floor level, so start the ray just above them (never lands on a roof)
    local groundY
    for _ = 1, 10 do
        local hit = Workspace:Raycast(Vector3.new(pos.X, pos.Y + 4, pos.Z), Vector3.new(0, -45, 0), params)
        if hit then
            groundY = hit.Position.Y
            break
        end
        task.wait(0.25)
    end

    local final = CFrame.new(pos.X, (groundY or pos.Y) + (veh and 2.2 or 3.2), pos.Z) * cf.Rotation
    if veh then
        veh:PivotTo(final)
        local root = seat.AssemblyRootPart or seat
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    else
        char:PivotTo(final)
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end
    return true
end


