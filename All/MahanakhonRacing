-- SimRide: Smooth MOTORCYCLE driving simulation via natural physics velocity (Zero Tween, Zero Noclip, Anti-Cheat Safe)
local function SimRide(targetPos, speed, maxTimeout)
    local char = LocalPlayer.Character
    if not char then return false end
    local hum = char:FindFirstChildWhichIsA("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hum or not hrp then return false end

    local targetV3 = typeof(targetPos) == "CFrame" and targetPos.Position or targetPos

    -- MUST DRIVE MOTORCYCLE FOR SIMRIDE:
    local bike = EnsureMotorcycle()
    if not bike or not hum.Sit then
        return SimWalk(targetV3, speed or State.DeliveryWalkSpeed or 28, maxTimeout)
    end

    local chassis = bike.PrimaryPart or bike:FindFirstChild("Chassis") or bike:FindFirstChild("RootPart") or hum.SeatPart
    if not chassis then
        return SimWalk(targetV3, speed or State.DeliveryWalkSpeed or 28, maxTimeout)
    end

    local seat = hum.SeatPart
    local rideSpeed = speed or State.DeliveryRideSpeed or 65
    local flatDist = (Vector3.new(targetV3.X, chassis.Position.Y, targetV3.Z) - chassis.Position).Magnitude

    if flatDist <= 10.0 then
        chassis.AssemblyLinearVelocity = Vector3.zero
        chassis.AssemblyAngularVelocity = Vector3.zero
        if seat and seat:IsA("VehicleSeat") then
            seat.ThrottleFloat = 0
            seat.SteerFloat = 0
        end
        CleanPathVisuals()
        return true
    end

    -- Compute navigation waypoints along official city roads
    local waypoints = ComputeNavigationPath(chassis.Position, targetV3)
    RenderPathVisuals(waypoints)

    local startTime = os.clock()
    local timeout = maxTimeout or ((flatDist / rideSpeed) + 18.0)

    for i, wp in ipairs(waypoints) do
        if not State.Alive or os.clock() - startTime > timeout then break end
        if not hum.Sit then break end

        local wpPos = wp.Position
        local wpStart = os.clock()

        while (Vector3.new(wpPos.X, chassis.Position.Y, wpPos.Z) - chassis.Position).Magnitude > 9.0 do
            if not State.Alive or os.clock() - wpStart > 6.0 then break end
            if not hum.Sit then break end

            local currentPos = chassis.Position
            local toWp = (wpPos - currentPos)
            local flatDir = Vector3.new(toWp.X, 0, toWp.Z)
            if flatDir.Magnitude < 0.2 then break end
            local moveUnit = flatDir.Unit

            -- Radar Obstacle Avoidance for motorcycle
            local steerOffset = Vector3.zero
            if State.RadarAvoidance then
                local hasObs, _, steer = ScanRadarObstacles(chassis, moveUnit * 10.0)
                if hasObs then
                    steerOffset = steer
                end
            end

            local finalDir = (moveUnit + steerOffset * 0.4).Unit

            -- Steer & Rotate towards waypoint (ROTATION ONLY - preserves position so server anti-cheat doesn't flag tween!)
            chassis.CFrame = CFrame.lookAt(currentPos, currentPos + Vector3.new(finalDir.X, 0, finalDir.Z))

            -- Apply natural linear physics velocity (Server recognizes legitimate client network ownership velocity!)
            local targetVel = Vector3.new(finalDir.X * rideSpeed, chassis.AssemblyLinearVelocity.Y, finalDir.Z * rideSpeed)
            chassis.AssemblyLinearVelocity = targetVel
            chassis.AssemblyAngularVelocity = Vector3.zero

            if seat and seat:IsA("VehicleSeat") then
                seat.ThrottleFloat = 1.0
            end

            task.wait(0.04)
        end
    end

    -- Stop motorcycle at destination
    chassis.AssemblyLinearVelocity = Vector3.zero
    chassis.AssemblyAngularVelocity = Vector3.zero
    if seat and seat:IsA("VehicleSeat") then
        seat.ThrottleFloat = 0
        seat.SteerFloat = 0
    end
    CleanPathVisuals()

    local finalFlatDist = (Vector3.new(targetV3.X, chassis.Position.Y, targetV3.Z) - chassis.Position).Magnitude
    return finalFlatDist <= 18.0
end

