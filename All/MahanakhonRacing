-- Accurate multi-layer path computation using official RoadGraph & PathfindingService
local function ComputeNavigationPath(startPos, endPos)
    local totalDist = (endPos - startPos).Magnitude

    -- 1. Short-range local navigation (inside Construction site, Garage bays, or rooms)
    -- PathfindingService computes paths around all scaffolding, walls, and obstacles safely
    if totalDist <= 55 then
        local path = PathfindingService:CreatePath({
            AgentRadius = 2.0,
            AgentHeight = 5.0,
            AgentCanJump = true,
            WaypointSpacing = 3.5
        })
        local ok = pcall(function() path:ComputeAsync(startPos, endPos) end)
        if ok and path.Status == Enum.PathStatus.Success then
            return path:GetWaypoints()
        end
    end

    -- 2. Long-range city navigation (Delivery, traveling across Bangkok map)
    -- Uses the official ReplicatedStorage.RoadGraph to route STRICTLY on paved streets and through real gates!
    -- This guarantees zero building/wall collisions so Server AntiCheat never detects noclip/tween!
    local rsRoadGraph = ReplicatedStorage:FindFirstChild("RoadGraph")
    if rsRoadGraph then
        local ok, RoadGraph = pcall(require, rsRoadGraph)
        if ok and RoadGraph and RoadGraph.route then
            local wps2d, totalLen = RoadGraph.route(startPos, endPos)
            if wps2d and #wps2d > 0 then
                local waypoints = {}
                local rayParams = RaycastParams.new()
                rayParams.FilterType = Enum.RaycastFilterType.Include
                rayParams.FilterDescendantsInstances = { Workspace.Map }

                -- Helper to find real ground elevation for a 2D road node
                local function getRoadGround(pos2d, refY)
                    local baseRef = refY or 2.0
                    local testPos = Vector3.new(pos2d.X, math.clamp(baseRef + 6, 8, 25), pos2d.Y)
                    local hit = Workspace:Raycast(testPos, Vector3.new(0, -35, 0), rayParams)
                    local y = hit and hit.Position.Y or baseRef
                    return Vector3.new(pos2d.X, y, pos2d.Y)
                end

                -- Add start position
                table.insert(waypoints, { Position = startPos, Action = Enum.PathWaypointAction.Walk })

                -- Add intermediate road nodes with raycasted road elevation
                local lastY = startPos.Y
                for _, node2d in ipairs(wps2d) do
                    local node3d = getRoadGround(node2d, lastY)
                    lastY = node3d.Y
                    table.insert(waypoints, { Position = node3d, Action = Enum.PathWaypointAction.Walk })
                end

                -- Add target position
                table.insert(waypoints, { Position = endPos, Action = Enum.PathWaypointAction.Walk })
                return waypoints
            end
        end
    end

    -- 3. Fallback: PathfindingService with broader agent spacing
    local path = PathfindingService:CreatePath({
        AgentRadius = 2.5,
        AgentHeight = 5.0,
        AgentCanJump = true,
        WaypointSpacing = 5.0
    })
    local ok = pcall(function() path:ComputeAsync(startPos, endPos) end)
    if ok and path.Status == Enum.PathStatus.Success then
        return path:GetWaypoints()
    end

    return {
        { Position = startPos, Action = Enum.PathWaypointAction.Walk },
        { Position = endPos, Action = Enum.PathWaypointAction.Walk }
    }
end

--- Realistic humanoid walking simulation (100% Server Anti-Cheat Safe, No Noclip, No Tween)
local function SimWalk(targetPos, speed, maxTimeout)
    local char = LocalPlayer.Character
    if not char then return false end
    local hum = char:FindFirstChildWhichIsA("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hum or not hrp then return false end

    if hum.Sit then
        hum.Sit = false
        task.wait(0.2)
    end

    local walkSpeed = speed or State.MechanicWalkSpeed or 26
    local prevSpeed = hum.WalkSpeed
    hum.WalkSpeed = walkSpeed

    local targetV3 = typeof(targetPos) == "CFrame" and targetPos.Position or targetPos
    local flatDist = (Vector3.new(targetV3.X, hrp.Position.Y, targetV3.Z) - hrp.Position).Magnitude

    if flatDist <= 3.5 then
        CleanPathVisuals()
        return true
    end

    -- Compute safe path around obstacles & scaffolding
    local waypoints = ComputeNavigationPath(hrp.Position, targetV3)
    RenderPathVisuals(waypoints)

    local startTime = os.clock()
    local timeout = maxTimeout or ((flatDist / walkSpeed) + 8.0)

    for i, wp in ipairs(waypoints) do
        if not State.Alive or os.clock() - startTime > timeout then break end
        local wpPos = wp.Position
        if wp.Action == Enum.PathWaypointAction.Jump then
            hum.Jump = true
        end

        local wpStart = os.clock()
        while (Vector3.new(wpPos.X, hrp.Position.Y, wpPos.Z) - hrp.Position).Magnitude > 3.0 do
            if not State.Alive or os.clock() - wpStart > 3.5 then break end

            local toWp = (wpPos - hrp.Position)
            local hasObs, jump, steer = ScanRadarObstacles(hrp, toWp)
            if jump then
                hum.Jump = true
            end

            hum:MoveTo(wpPos + steer)
            task.wait(0.05)
        end
    end

    CleanPathVisuals()

    if not State.WalkSpeedOn then
        hum.WalkSpeed = prevSpeed
    end

    return (Vector3.new(targetV3.X, hrp.Position.Y, targetV3.Z) - hrp.Position).Magnitude <= 5.0
end

-- Ensure player is mounted on a MOTORCYCLE for SimRide
local function EnsureMotorcycle()
    local char = LocalPlayer.Character
    if not char then return nil end
    local hum = char:FindFirstChildWhichIsA("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hum or not hrp then return nil end

    local function isMotorcycle(model)
        if not model then return false end
        local n = model.Name:upper()
        local tag = tostring(model:GetAttribute("VehicleTag") or ""):upper()
        return n:find("PCX") or n:find("WAVE") or n:find("VESPA") or n:find("XMAX") or n:find("LEAD") or n:find("GIORNO") or n:find("SPORT") or n:find("DREAM") or tag:find("PCX") or tag:find("BIKE") or tag:find("WAVE")
    end

    -- 1. Check if already sitting on a motorcycle
    if hum.Sit and hum.SeatPart then
        local currentVeh = hum.SeatPart:FindFirstAncestorOfClass("Model")
        if isMotorcycle(currentVeh) then
            return currentVeh
        end
    end

    -- 2. Check if player has a spawned motorcycle in SpawnedVehicles
