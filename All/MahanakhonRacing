-- Fast job uniform switch via Lockers (Anti-Cheat Safe: Navigates via SimWalk / SimRide, Zero TP)
local function SwitchJob(targetJob)
    local currentJob = LocalPlayer:GetAttribute("Job")
    local currentUniform = LocalPlayer:GetAttribute("Uniform")
    if currentJob == targetJob and currentUniform == targetJob then
        return true
    end

    local lockerFolder = Workspace:FindFirstChild("Map") and Workspace.Map:FindFirstChild("JobLockers")
    if not lockerFolder then return false end

    -- Safe helper to travel to locker cabinet via SimWalk/SimRide and equip uniform
    local function TravelAndEquip(lockerObj)
        if not lockerObj then return false end
        local cab = lockerObj:FindFirstChild("Cabinet")
        local prompt = cab and cab:FindFirstChild("LockerPrompt")
        if not (cab and prompt) then return false end

        local targetPos = (cab.CFrame * CFrame.new(0, 0, 2.5)).Position
        local hrp = SafeRoot()
        if not hrp then return false end

        local dist = (Vector3.new(targetPos.X, hrp.Position.Y, targetPos.Z) - hrp.Position).Magnitude

        -- If far (> 75 studs), ride motorcycle near entrance first, then walk in
        if dist > 75 then
            local parkPos = (cab.CFrame * CFrame.new(0, 0, 15)).Position
            SimRide(parkPos, 65)
            task.wait(0.3)
            local char = LocalPlayer.Character
            local hum = char and char:FindFirstChildWhichIsA("Humanoid")
            if hum and hum.Sit then
                hum.Sit = false
                task.wait(0.3)
            end
        end

        -- Walk directly to the locker cabinet
        SimWalk(targetPos, 28)
        task.wait(0.2)

        -- Activate locker prompt within legitimate proximity
        hrp = SafeRoot()
        if hrp and (hrp.Position - cab.Position).Magnitude <= 12 then
            pcall(fireproximityprompt, prompt, 0)
            task.wait(0.8)
            return true
        end
        return false
    end

    -- 1. If currently wearing another uniform, strip it off first
    if currentJob and currentJob ~= "Citizen" and currentUniform and currentUniform ~= targetJob then
        local currentLocker = lockerFolder:FindFirstChild("Locker_" .. currentJob)
        if currentLocker then
            TravelAndEquip(currentLocker)
        end
    end

    -- 2. Travel to the target job locker and wear the uniform
    local targetLocker = lockerFolder:FindFirstChild("Locker_" .. targetJob)
    if targetLocker then
        TravelAndEquip(targetLocker)
    end

    return LocalPlayer:GetAttribute("Job") == targetJob
end
