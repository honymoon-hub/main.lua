-- ═══════════════════════════════════════
-- TELEPORT WITH BYPASS: 1) instant teleport and verify we stay there (server may rubber-band us)
--                       2) stepped hops (small distance per tick)
--                       3) drive there on the roads with the same driving system the missions use
-- ═══════════════════════════════════════
function SmartTeleport(target)
    local cf = typeof(target) == "CFrame" and target or CFrame.new(target)
    local goal = cf.Position
    local gen = State.Gen

    local function arrived(maxD)
        local r = SafeRoot()
        if not r then return false end
        local veh = TopVehicleModel()
        local p = veh and veh:GetPivot().Position or r.Position
        return (Vector3.new(p.X, 0, p.Z) - Vector3.new(goal.X, 0, goal.Z)).Magnitude <= (maxD or 45)
    end

    -- 1. plain teleport, then make sure the server did not pull us back
    SafeTeleport(cf)
    task.wait(0.7)
    if arrived() then
        task.wait(0.8)
        if arrived() then return true, "teleport" end
    end
    if not State.TeleportBypass or Cancelled(gen) then return false, "failed" end

    -- 2. stepped hops
    local char = LocalPlayer.Character
    local veh = TopVehicleModel()
    local root = SafeRoot()
    if char and root then
        local from = veh and veh:GetPivot().Position or root.Position
        local to = Vector3.new(goal.X, goal.Y + 3, goal.Z)
        local dist = (to - from).Magnitude
        if dist < 1800 then
            local steps = math.ceil(dist / 25)
            for i = 1, steps do
                if Cancelled(gen) then return false, "cancelled" end
                local p = from:Lerp(to, i / steps)
                local f = CFrame.new(p) * cf.Rotation
                if veh then
                    veh:PivotTo(f)
                    local sr = (veh.PrimaryPart or root)
                    sr.AssemblyLinearVelocity = Vector3.zero
                else
                    char:PivotTo(f)
                    root.AssemblyLinearVelocity = Vector3.zero
                end
                task.wait(0.15)
            end
            task.wait(0.5)
            if arrived() then
                SafeTeleport(cf) -- settle on the real floor
                task.wait(0.6)
                if arrived() then return true, "stepped" end
            end
        end
    end
    if Cancelled(gen) then return false, "cancelled" end

    -- 3. drive there
    SetStatus("Teleport blocked: driving there")
    Notify("Teleport", "Teleport was blocked, driving there instead", "Warning")
    local ok = SimRide(goal, nil, 420)
    return ok or arrived(60), "drive"
end

