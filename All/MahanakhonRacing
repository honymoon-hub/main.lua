-- FUEL: auto refuel + manual "refuel now". Both pause the farm, drive along the roads to the nearest pump,
-- fill up, then let the farm continue.
-- ═══════════════════════════════════════
local function MyVehicle()
    local m = TopVehicleModel()
    if m then return m end
    return OwnedVehicles()[1]
end

local function FindFuelPumps()
    local out = {}
    for _, inst in ipairs(CollectionService:GetTagged(CareShared.PUMP_TAG or "FuelPump")) do
        local pos = InstPos(inst)
        if pos then table.insert(out, { inst = inst, pos = pos }) end
    end
    if #out == 0 and MapConfig and MapConfig.TELEPORTS then
        for _, tp in ipairs(MapConfig.TELEPORTS) do
            if tostring(tp.id):lower() == "gas" or tostring(tp.id):lower():find("gas", 1, true) then
                local cf = tp.car or tp.foot
                if cf then table.insert(out, { pos = cf.Position }) end
            end
        end
    end
    return out
end

local function PumpPrompt(inst)
    if not inst then return nil end
    return inst:FindFirstChildWhichIsA("ProximityPrompt", true)
        or (inst.Parent and inst.Parent:FindFirstChildWhichIsA("ProximityPrompt", true))
end

local RefuelNow, EcuAutoTune
function RefuelNow(auto)
    if State.Refueling then return false end
    local veh = MyVehicle()
    if not veh then
        Notify("Fuel", "No vehicle spawned - spawn one first", "Warning")
        return false
    end

    State.Refueling = true -- the farm loop idles while this is true
    State.Gen = State.Gen + 1 -- stop whatever movement is running
    local gen = State.Gen
    State.RefuelInfo = "Pausing quests..."
    local t0 = os.clock()
    while State.StepBusy and os.clock() - t0 < 8 do task.wait(0.1) end
    StopMotion()

    local success = false
    local ok, err = pcall(function()
        local startFuel = CareShared.fuel(veh)
        local pumps = FindFuelPumps()
        if #pumps == 0 then error("no fuel pump found") end

        local function pivot() return veh:GetPivot().Position end
        table.sort(pumps, function(a, b)
            return (a.pos - pivot()).Magnitude < (b.pos - pivot()).Magnitude
        end)
        local pump = pumps[1]

        State.RefuelInfo = string.format("Driving to gas station (%d%%)", math.floor(startFuel))
        SetStatus("Refuel: driving to pump")
        MountVehicle(veh)

        local function near()
            return (Vector3.new(pivot().X, 0, pivot().Z) - Vector3.new(pump.pos.X, 0, pump.pos.Z)).Magnitude <= 14
        end
        for _ = 1, 2 do
            if near() or Cancelled(gen) then break end
            SimRide(pump.pos, nil, 420, true)
        end
        if not near() and not Cancelled(gen) then
            -- driving did not get us there: last resort teleport next to the pump
            SmartTeleport(CFrame.new(pump.pos + Vector3.new(0, 2, 6)))
        end
        if Cancelled(gen) then error("cancelled") end

