-- Fast lookup set for categories
local CATEGORY_SETS = {}
for cat, emojis in pairs(EMOJI_CATEGORIES) do
    CATEGORY_SETS[cat] = {}
    for _, em in ipairs(emojis) do
        CATEGORY_SETS[cat][em] = true
    end
end
local function SolveFarmCheck(data)
    local prompt = tostring(data.prompt or "")
    -- 1. Exact emoji in prompt
    for _, opt in ipairs(data.options or {}) do
        if opt.emoji and prompt:find(opt.emoji, 1, true) then
            return opt.id, opt.emoji, "exact"
        end
    end
    -- 2. Category matching by keywords
    for _, km in ipairs(KEYWORD_MAP) do
        for _, word in ipairs(km.words) do
            if prompt:find(word, 1, true) then
                local catSet = CATEGORY_SETS[km.category]
                if catSet then
                    for _, opt in ipairs(data.options or {}) do
                        if opt.emoji and catSet[opt.emoji] then
                            return opt.id, opt.emoji, km.category
                        end
                    end
                end
            end
        end
    end
    return nil, nil, "unknown"
end
local function SolveFarmCheckGui(promptText, candidateButtons)
    local prompt = tostring(promptText or "")
    -- 1. Exact emoji match
    for _, cand in ipairs(candidateButtons) do
        if cand.emoji and prompt:find(cand.emoji, 1, true) then
            return cand.button, cand.emoji, "exact"
        end
    end
    -- 2. Category keyword matching
    for _, km in ipairs(KEYWORD_MAP) do
        for _, word in ipairs(km.words) do
            if prompt:find(word, 1, true) then
                local catSet = CATEGORY_SETS[km.category]
                if catSet then
                    for _, cand in ipairs(candidateButtons) do
                        if cand.emoji and catSet[cand.emoji] then
                            return cand.button, cand.emoji, km.category
                        end
                    end
                end
            end
        end
    end
    return nil, nil, "unknown"
end
