local WORK_FALLBACK = {
    Mechanic_Board = Vector3.new(154.5, 3.42, -194),
    Builder_Board = Vector3.new(98, 2.6, 374),
    Builder_Mixer = Vector3.new(136, 2.6, 390.5),
}

local function ReadWorkTask()
    local raw = LocalPlayer:GetAttribute("WorkTask")
    if type(raw) == "string" and raw ~= "" then
        local ok, t = pcall(HttpService.JSONDecode, HttpService, raw)
        if ok and type(t) == "table" then return t end
    end
    return nil
end

-- Position of a work station: JobPlaces attribute -> tagged WorkStation -> hardcoded fallback
local function StationPos(job, id)
    local v = JobPlaces and JobPlaces:GetAttribute(job .. "_" .. id)
    if typeof(v) == "Vector3" then return v end
    for _, inst in ipairs(CollectionService:GetTagged("WorkStation")) do
        if inst:GetAttribute("StationId") == id then
            local j = inst:GetAttribute("Job")
            if j == nil or j == job then
                local p = InstPos(inst)
                if p then return p end
            end
        end
    end
    return WORK_FALLBACK[job .. "_" .. id]
end

-- Mechanic + Builder share the same flow: Take (board) -> go (Do at station) -> doing (wait) -> Done
local function RunWorkStep(job, moveMode)
    if GetJob() ~= job then
        SetStatus("Switching job -> " .. job)
        return SwitchJob(job)
    end
    local taskObj = ReadWorkTask()
    local gen = State.Gen
    local function Move(pos)
        Travel(pos, moveMode)
        task.wait(0.2)
        return not Cancelled(gen)
    end

    -- No task: wait for cooldown, then Take from the Job Board
    if not taskObj then
        local waitLeft = (LocalPlayer:GetAttribute("WorkNextAt") or 0) - Workspace:GetServerTimeNow()
        if waitLeft > 0 then
            SetStatus(string.format("%s: next task in %ds", job, math.ceil(waitLeft)))
            task.wait(math.min(waitLeft, 1))
            return true
        end
        local board = StationPos(job, "Board")
        if board then
            SetStatus(job .. ": taking a task")
            if not Move(board) then return true end
            Call(WorkRemote, "Take", nil)
            task.wait(0.4)
        end
        return true
    end

    -- Builder: carry cement from the pile to the mixer
    if taskObj.step == "carry" then
        local pos = StationPos(job, taskObj.station or "Mixer") or StationPos(job, "Mixer")
        if pos then
            SetStatus(job .. ": carrying")
            if not Move(pos) then return true end
            Call(WorkRemote, "Done", 1)
            task.wait(0.5)
        end
        return true
    end

    -- Go to the station and start the minigame
    if taskObj.step == "go" then
        local pos = StationPos(job, taskObj.station)
        if pos then
            SetStatus(job .. ": " .. tostring(taskObj.station))
            if not Move(pos) then return true end
            Call(WorkRemote, "Do", taskObj.station)
            task.wait(0.4)
        end
        return true
    end

    -- Minigame running: wait the minimum time then finish with a perfect score
    if taskObj.step == "doing" then
        SetStatus(job .. ": working")
        task.wait(math.max(State.MechanicDelay, (JobShared.MIN_TIME or 3) + 0.2))
        if Cancelled(gen) then return true end
        Call(WorkRemote, "Done", 1)
        task.wait(0.5)
        return true
    end
    return true
end

-- Delivery family: Delivery (food / ride), Courier (parcel), Grab (own-bike rides)
local DELIVERY_JOBS = {
    Delivery = { job = "Delivery", mode = "food" },
    Courier = { job = "Courier", mode = "parcel" },
    Grab = { job = "Grab", mode = "grab" },
}

local function DeliveryMove(target)
    if State.DeliveryMoveMode == "SimRide" then
        return SimRide(target, State.DeliveryRideSpeed)
    elseif State.DeliveryMoveMode == "SimWalk" then
        return SimWalk(target, State.DeliveryWalkSpeed)
    end
    return (SmartTeleport(target + Vector3.new(0, 1.5, 0)))
end

-- Go to the target, wait for the server to mark us "arrived" (stopped inside the radius), then confirm
local function DeliveryGoAndConfirm(target, label)
    local gen = State.Gen
    for _ = 1, 3 do
        if Cancelled(gen) then return false end
        SetStatus(label)
        DeliveryMove(target)
        local t0 = os.clock()
        while os.clock() - t0 < 3.5 do
            if Cancelled(gen) then return false end
            if LocalPlayer:GetAttribute("DeliveryArrived") == true then
                Call(DeliveryRemote, "Confirm", nil)
                task.wait(0.6)
                return true
            end
            task.wait(0.2)
        end
    end
    return false
end

local function RunDeliveryStep(jobName, mode)
    local gen = State.Gen
    local info = DELIVERY_JOBS[jobName] or DELIVERY_JOBS.Delivery
    mode = mode or info.mode

    if GetJob() ~= info.job then
        SetStatus("Switching job -> " .. info.job)
        return SwitchJob(info.job)
    end

    local delState = LocalPlayer:GetAttribute("DeliveryState") or "Off"
    local jobObj = DeliveryShared.decode(LocalPlayer:GetAttribute("DeliveryJob"))

    if delState == "Off" then
        -- Courier parcels are started at the depot
        if info.job == "Courier" and JobShared.DEPOT then
            local depot = Vector3.new(JobShared.DEPOT.x, (JobShared.DEPOT.y or 0) + 2, JobShared.DEPOT.z)
            local hrp = SafeRoot()
            if hrp and (Vector3.new(depot.X, hrp.Position.Y, depot.Z) - hrp.Position).Magnitude > 40 then
                SetStatus("Courier: going to the depot")
                DeliveryMove(depot)
            end
        end
        if Cancelled(gen) then return true end
        SetStatus(info.job .. ": starting (" .. mode .. ")")
        Call(DeliveryRemote, "Start", mode)
        task.wait(1)
        return true
    end

    if delState == "Searching" then
        SetStatus(info.job .. ": searching for orders")
        task.wait(0.5)
        return true
    end

    if delState == "Offer" then
        if State.MinFee > 0 and jobObj and (jobObj.fee or 0) < State.MinFee then
            Call(DeliveryRemote, "Skip", nil)
            task.wait(0.5)
        elseif State.AutoAcceptOffer then
            Call(DeliveryRemote, "Accept", nil)
            task.wait(0.5)
        end
        return true
    end

    if not jobObj then
        task.wait(0.3)
        return true
    end

    if delState == "ToShop" or delState == "ToHome" then
        local target = DeliveryShared.target(delState, jobObj)
        if target then
            local label = (delState == "ToShop" and info.job .. ": pick-up" or info.job .. ": drop-off")
            if jobObj.fee then label = label .. string.format(" (฿%s)", GameShared.formatNumber(jobObj.fee)) end
            DeliveryGoAndConfirm(target + Vector3.new(0, 2, 0), label)
        end
    end
    return true
end

-- ═══════════════════════════════════════
-- KAITUN (ALL-IN-ONE SCHEDULER)
-- Rotates through every money job, finishing the current order/task before switching.
-- ═══════════════════════════════════════
local KAITUN_ORDER = { "Grab", "Delivery", "Courier", "Mechanic", "Builder" }
local Kaitun = {
    current = nil,
    sliceStart = os.clock(),
    blocked = {},      -- job -> os.clock() until which it is skipped (failed to switch)
    failures = {},     -- job -> consecutive switch failures
    startCash = nil,
    activeJob = nil,   -- job we are currently clocked in as (rotation timer starts from here)
}
xDTaraZ.Kaitun = Kaitun

local function KaitunList()
    local list = {}
    for _, j in ipairs(KAITUN_ORDER) do
        local blockedUntil = Kaitun.blocked[j]
        if State.KaitunJobs[j] and not (blockedUntil and os.clock() < blockedUntil) then
            table.insert(list, j)
        end
    end
    return list
end

-- Safe to leave the current job: no task in progress / no order being carried
local function KaitunSafePoint(job)
    if job == "Mechanic" or job == "Builder" then
        return ReadWorkTask() == nil
    end
    local st = LocalPlayer:GetAttribute("DeliveryState") or "Off"
    return st == "Off" or st == "Searching" or st == "Offer"
end

local function RunActivity(job)
    if job == "Mechanic" or job == "Builder" then
        return RunWorkStep(job, State.KaitunMoveMode)
    end
    local mode = nil
    if job == "Delivery" then
        mode = (State.DeliveryMode == "ride") and "ride" or "food"
    end
    return RunDeliveryStep(job, mode)
end

local function RunKaitunStep()
    if not SafeRoot() then
        task.wait(1)
        return
    end
    if not Kaitun.startCash then
        Kaitun.startCash = LocalPlayer:GetAttribute("Cash") or 0
    end

    local list = KaitunList()
    if #list == 0 then
        SetStatus("Kaitun: no job selected")
        task.wait(1)
        return
    end

    local idx = table.find(list, Kaitun.current)
    if not idx then
        -- current job removed / blocked: leave any delivery cleanly, then move on
        if Kaitun.current and (LocalPlayer:GetAttribute("DeliveryState") or "Off") ~= "Off" and KaitunSafePoint(Kaitun.current) then
            Call(DeliveryRemote, "Stop")
        end
        Kaitun.current = list[1]
        Kaitun.sliceStart = os.clock()
        Kaitun.activeJob = nil
        idx = 1
    elseif #list > 1 and os.clock() - Kaitun.sliceStart >= State.KaitunSlice * 60 and KaitunSafePoint(Kaitun.current) then
        if (LocalPlayer:GetAttribute("DeliveryState") or "Off") ~= "Off" then
            Call(DeliveryRemote, "Stop")
            task.wait(0.4)
        end
        Kaitun.current = list[idx % #list + 1]
        Kaitun.sliceStart = os.clock()
        Kaitun.activeJob = nil
    end

    local job = Kaitun.current
    local before = GetJob()
    -- the rotation timer starts once we are actually in the job (not while walking to the locker)
    if before == job and Kaitun.activeJob ~= job then
        Kaitun.activeJob = job
        Kaitun.sliceStart = os.clock()
    end
    RunActivity(job)

    -- Could not become this job a few times in a row: skip it for 3 minutes
    if before ~= job and GetJob() ~= job then
        Kaitun.failures[job] = (Kaitun.failures[job] or 0) + 1
        if Kaitun.failures[job] >= 3 then
            Kaitun.failures[job] = 0
            Kaitun.blocked[job] = os.clock() + 180
            warn("[Honymoon Hub] Kaitun: could not switch to " .. job .. ", skipping for 3 min")
        end
    else
        Kaitun.failures[job] = 0
    end
end

