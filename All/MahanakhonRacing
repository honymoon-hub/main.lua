        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local seat = hum and hum.SeatPart
        if not (seat and seat:IsA("BasePart")) then
            return nil, T("Please sit in your vehicle first!", "กรุณานั่งขับรถของตัวเองก่อนใช้งาน!")
        end
        local spawned = Workspace:FindFirstChild("SpawnedVehicles")
        if spawned then
            for _, veh in ipairs(spawned:GetChildren()) do
                if seat:IsDescendantOf(veh) then
                    if veh:GetAttribute("OwnerUserId") == LocalPlayer.UserId then
                        return veh, nil
                    else
                        return nil, T("This is not your vehicle!", "รถคันนี้ไม่ใช่รถของคุณ!")
                    end
                end
            end
        end
        return nil, T("Please sit in your own vehicle first!", "กรุณานั่งขับรถของตัวเองก่อนใช้งาน!")
    end
