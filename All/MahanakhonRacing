-- NOCLIP + OBSTACLE AVOIDANCE
-- Small stuff (poles, fences, signs, props) is ghosted with NoCollisionConstraint,
-- big stuff (buildings, walls, big objects) is routed around with PathfindingService.
-- ═══════════════════════════════════════
local function ClearAvoid()
    local f = Workspace:FindFirstChild("MarioAvoid")
    if f then pcall(f.Destroy, f) end
end

-- returns "small" (already ghosted), "big" (needs a detour) or nil
local function AvoidAhead(root, dir, vehicle)
    if not State.NoclipAvoid then return nil end
    local char = LocalPlayer.Character
    if not (char and root) then return nil end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = vehicle and { char, vehicle } or { char }
    params.IgnoreWater = true

    local origin = root.Position + Vector3.new(0, vehicle and 0.6 or -1.2, 0)
    local side = Vector3.new(-dir.Z, 0, dir.X)
    local found
    for _, off in ipairs({ 0, 2.4, -2.4 }) do
        local hit = Workspace:Raycast(origin + side * off, dir * 16, params)
        if hit and hit.Instance:IsA("BasePart") and not hit.Instance:IsA("Terrain")
            and hit.Instance.CanCollide and hit.Normal.Y < 0.6 then
            found = hit.Instance
            break
        end
    end
    if not found then return nil end

    local sz = found.Size
    local small = sz.Magnitude <= 12 or (sz.Y <= 14 and math.min(sz.X, sz.Z) <= 3.2)
    if not small then return "big", found end

    local folder = Workspace:FindFirstChild("MarioAvoid")
    if not folder then
        folder = Instance.new("Folder")
        folder.Name = "MarioAvoid"
        folder.Parent = Workspace
    end
    if #folder:GetChildren() > 160 then folder:ClearAllChildren() end
    local n = 0
    for _, model in ipairs(vehicle and { char, vehicle } or { char }) do
        for _, p in ipairs(model:GetDescendants()) do
            if p:IsA("BasePart") and p.CanCollide and n < 70 then
                n = n + 1
                local c = Instance.new("NoCollisionConstraint")
                c.Part0 = p
                c.Part1 = found
                c.Parent = folder
            end
        end
    end
    return "small", found
end


--- Realistic humanoid walking simulation with stuck recovery (hop/sidestep, then slow ghost-through)
local function SimWalk(targetPos, speed, maxTimeout)
    local gen = State.Gen
    local char = LocalPlayer.Character
    if not char then return false end
    local hum = char:FindFirstChildWhichIsA("Humanoid")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hum or not hrp then return false end

    if hum.Sit then
        hum.Sit = false
        task.wait(0.2)
    end

    local walkSpeed = speed or State.MechanicWalkSpeed or 26
    local prevSpeed = hum.WalkSpeed
    hum.WalkSpeed = walkSpeed
    local function restore()
        if not State.WalkSpeedOn then hum.WalkSpeed = prevSpeed end
    end

    local targetV3 = typeof(targetPos) == "CFrame" and targetPos.Position or targetPos
    local flatDist = (Vector3.new(targetV3.X, hrp.Position.Y, targetV3.Z) - hrp.Position).Magnitude

    if flatDist <= 3.5 then
        CleanPathVisuals()
        restore()
        return true
    end

    local waypoints = ComputeNavigationPath(hrp.Position, targetV3, false)
    RenderPathVisuals(waypoints)

    local startTime = os.clock()
    local timeout = maxTimeout or ((flatDist / walkSpeed) + 8.0)

    for _, wp in ipairs(waypoints) do
        if Cancelled(gen) or os.clock() - startTime > timeout then break end
        local wpPos = wp.Position
        if wp.Action == Enum.PathWaypointAction.Jump then
            hum.Jump = true
        end

        local wpStart = os.clock()
        local lastPos, lastCheck, stuck = hrp.Position, os.clock(), 0
        while (Vector3.new(wpPos.X, hrp.Position.Y, wpPos.Z) - hrp.Position).Magnitude > 3.0 do
            if Cancelled(gen) or os.clock() - wpStart > 6.0 then break end

            local toWp = (wpPos - hrp.Position)
            if State.NoclipAvoid then
                local flat = Vector3.new(toWp.X, 0, toWp.Z)
                if flat.Magnitude > 0.5 then AvoidAhead(hrp, flat.Unit, nil) end
            end
            local _, jump, steer = ScanRadarObstacles(hrp, toWp)
            if jump then
                hum.Jump = true
            end
            hum:MoveTo(wpPos + steer)

            -- stuck detection: barely moved in 0.8s although we are walking
            if os.clock() - lastCheck >= 0.8 then
                local moved = (hrp.Position - lastPos).Magnitude
                lastPos, lastCheck = hrp.Position, os.clock()
                if moved < 1.5 then
                    stuck = stuck + 1
                    if stuck == 1 then
                        -- hop and sidestep around it
                        hum.Jump = true
                        local fwd = Vector3.new(toWp.X, 0, toWp.Z)
                        if fwd.Magnitude > 0.1 then
                            local side = Vector3.new(-fwd.Unit.Z, 0, fwd.Unit.X) * (math.random() < 0.5 and 6 or -6)
                            hum:MoveTo(hrp.Position + side + fwd.Unit * 3)
                            task.wait(0.5)
                        end
                    else
                        stuck = 0
                        if State.AntiStuck then
                            GhostThrough(hrp, wpPos, gen, nil)
                        end
                        wpStart = os.clock()
                    end
                else
                    stuck = 0
                end
            end
            task.wait(0.05)
        end
    end

    if Cancelled(gen) then
        StopMotion()
    end
    CleanPathVisuals()
    ClearAvoid()
    restore()

    return (Vector3.new(targetV3.X, hrp.Position.Y, targetV3.Z) - hrp.Position).Magnitude <= 5.0
end

