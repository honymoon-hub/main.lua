-- NetSeal.invoke returns (serverSuccess, data, extra). Call() hides the pcall and gives back (success, data, extra)
local function Call(remote, ...)
    local ok, success, data, extra = pcall(NetSeal.invoke, remote, ...)
    if not ok then return false, nil, nil end
    return success and true or false, data, extra
end

local function GetJob()
    return LocalPlayer:GetAttribute("Job") or JobShared.DEFAULT
end

local function SetStatus(text)
    State.Status = text
end

local function InstPos(inst)
    if not inst then return nil end
    if inst:IsA("BasePart") then return inst.Position end
    if inst:IsA("Model") then return inst:GetPivot().Position end
    local p = inst:FindFirstChildWhichIsA("BasePart", true)
    return p and p.Position or nil
end

-- Walk (or ride when far) to a place. Used for lockers / job boards / work stations
local function Travel(pos, mode)
    mode = mode or State.KaitunMoveMode
    if mode == "InstantTP" then
        return SafeTeleport(pos + Vector3.new(0, 1.5, 0))
    end
    local hrp = SafeRoot()
    if not hrp then return false end
    local flat = (Vector3.new(pos.X, hrp.Position.Y, pos.Z) - hrp.Position).Magnitude
    if mode == "SimRide" and flat > 75 then
        SimRide(pos, State.DeliveryRideSpeed)
        task.wait(0.3)
        local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildWhichIsA("Humanoid")
        if hum and hum.Sit then
            hum.Sit = false
            task.wait(0.3)
        end
    end
    return SimWalk(pos, State.MechanicWalkSpeed)
end

local function FindLocker(jobId)
    for _, inst in ipairs(CollectionService:GetTagged("JobLocker")) do
        if inst:GetAttribute("Job") == jobId then
            return inst
        end
    end
    local map = Workspace:FindFirstChild("Map")
    local folder = map and map:FindFirstChild("JobLockers")
    return folder and folder:FindFirstChild("Locker_" .. jobId) or nil
end

-- Walk to a job locker and press its prompt (toggles uniform on/off)
local function UseLocker(jobId)
    local locker = FindLocker(jobId)
    if not locker then return false end
    local prompt = locker:FindFirstChild("LockerPrompt", true)
    if not prompt then return false end
    local part = prompt.Parent
    if not (part and part:IsA("BasePart")) then
        part = locker:FindFirstChildWhichIsA("BasePart", true)
    end
    if not part then return false end

    local gen = State.Gen
    for attempt = 1, 2 do
        if Cancelled(gen) then return false end
        local stand = attempt == 1 and (part.CFrame * CFrame.new(0, 0, 2.5)).Position or part.Position
        Travel(stand)
        task.wait(0.2)
        local hrp = SafeRoot()
        if Cancelled(gen) then return false end
        if hrp and (hrp.Position - part.Position).Magnitude <= 14 then
            pcall(fireproximityprompt, prompt)
            task.wait(0.9)
            return true
        end
    end
    return false
end

-- Switch to a job: take off the old uniform, Plan the new job, put on the new uniform
local function SwitchJob(target)
    if GetJob() == target then return true end
    local def = JobShared.job(target)
    local gen = State.Gen
    for _ = 1, 3 do
        if Cancelled(gen) then return false end
        local cur = GetJob()
        if cur == target then return true end

        -- 1. take off whatever uniform we are wearing
        if cur ~= JobShared.DEFAULT then
            if (LocalPlayer:GetAttribute("DeliveryState") or "Off") ~= "Off" then
                Call(DeliveryRemote, "Stop")
                task.wait(0.4)
            end
            local curDef = JobShared.job(cur)
            if curDef and not curDef.noLocker then
                SetStatus("Taking off uniform: " .. cur)
                UseLocker(cur)
            end
        end

        -- 2. mark the new job as planned
        if LocalPlayer:GetAttribute("PlannedJob") ~= target then
            Call(JobRemote, "Plan", target)
            task.wait(0.5)
        end
        if Cancelled(gen) then return false end
        if GetJob() == target then return true end

        -- 3. put on the new uniform at its locker
        if def and not def.noLocker then
            SetStatus("Putting on uniform: " .. target)
            UseLocker(target)
        end
        task.wait(0.5)
    end
    return GetJob() == target
end

