    -- Every place is an entry { label, id, group, en, foot, car }. The dropdown label IS the lookup key,
    -- so the place you pick is always the place you land on.
    local TP_ENTRIES, TP_LABELS, TP_BY_LABEL, TP_BY_ID = {}, {}, {}, {}
    local function NormName(s)
        s = tostring(s or ""):lower()
        s = s:gsub("[%s%p]+", " ")
        s = s:gsub("^%s+", "")
        s = s:gsub("%s+$", "")
        return s
    end
