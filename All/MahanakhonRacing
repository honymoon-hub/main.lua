-- ECU AUTO TUNE
-- The ECU takes ONE changed map per send (2s cooldown) and answers with a 0..1 score per map.
-- We hill-climb each map: coarse sweep, then shrinking steps, then per-band refinement.
-- ═══════════════════════════════════════
local Ecu = { running = false, text = "ECU: idle", scores = {}, tunedFor = nil }
xDTaraZ.Ecu = Ecu

local function EcuQuantize(t, v)
    return math.clamp(math.round(v / t.step) * t.step, t.min, t.max)
end

local function EcuCopy(file)
    local out = {}
    for k, arr in pairs(file) do
        out[k] = table.clone(arr)
    end
    return out
end

local function EcuReadFile(veh)
    local ok, success, data = pcall(NetSeal.invoke, EcuRemote, "Get", veh)
    if ok and success and type(data) == "table" then
        local f = data.file or data
        local clean = EcuShared.clean and EcuShared.clean(f)
        if clean then return clean end
    end
    return EcuShared.stockFile()
end

function EcuAutoTune(veh)
    if Ecu.running then return false end
    Ecu.running = true
    Ecu.scores = {}
    local ok, err = pcall(function()
        State.ForceMaxEcu = false -- the fake x2.00 would hide the real result
        local cur = EcuReadFile(veh)
        local sends = 0
        local lastSend = 0

        local function send(key, arr)
            local wait = EcuShared.SEND_COOLDOWN + 0.2 - (os.clock() - lastSend)
            if wait > 0 then task.wait(wait) end
            local file = EcuCopy(cur)
            file[key] = arr
            lastSend = os.clock()
            sends = sends + 1
            local pok, success, msg, _, feedback = pcall(NetSeal.invoke, EcuRemote, "Send", veh, file, { k = EcuShared.sum(file) })
            if not (pok and success) then
                Ecu.lastError = tostring(msg or "ECU did not answer")
                return nil
            end
            cur = file
            local s = type(feedback) == "table" and tonumber(feedback[key]) or nil
            if s then Ecu.scores[key] = s end
            return s
        end

        local function uniform(v)
            local a = {}
            for i = 1, EcuShared.POINTS do a[i] = v end
            return a
        end

        local total = #EcuShared.TABLES
        for ti, t in ipairs(EcuShared.TABLES) do
            if not State.AutoEcuTune and not Ecu.manual then error("stopped") end
            local function say(extra)
                Ecu.text = string.format("Tuning %s (%d/%d) %s", t.label or t.key, ti, total, extra or "")
            end
            say("sweep")

            local lo, hi = t.recipeMin or t.min, t.recipeMax or t.max
            local bestV, bestS
            for k = 0, 4 do
                local v = EcuQuantize(t, lo + (hi - lo) * k / 4)
                local s = send(t.key, uniform(v))
                if not s then error(Ecu.lastError or "send failed") end
                if not bestS or s > bestS then bestV, bestS = v, s end
                say(string.format("best %.0f%%", bestS * 100))
                if bestS >= 0.98 then break end
            end

            -- refine with shrinking steps
            local d = (hi - lo) / 8
            local guard = 0
            while bestS < 0.98 and d >= t.step * 2 and guard < 12 do
                guard = guard + 1
                local improved = false
                for _, dir in ipairs({ 1, -1 }) do
                    local cand = EcuQuantize(t, bestV + dir * d)
                    if cand ~= bestV then
                        local s = send(t.key, uniform(cand))
                        if s and s > bestS then
                            bestV, bestS, improved = cand, s, true
                            break
                        end
                    end
                end
                if not improved then d = d / 2 end
                say(string.format("best %.0f%%", bestS * 100))
            end

            -- per-band refinement when a single value is not enough
            local arr = uniform(bestV)
            if bestS < 0.95 then
                for bi, band in ipairs(EcuShared.BANDS) do
                    local bd = (hi - lo) / 10
                    local bandV = bestV
                    for _ = 1, 6 do
                        local improved = false
                        for _, dir in ipairs({ 1, -1 }) do
                            local cand = EcuQuantize(t, bandV + dir * bd)
                            if cand ~= bandV then
                                local trial = table.clone(arr)
                                for i = band[1], band[2] do trial[i] = cand end
                                local s = send(t.key, trial)
                                if s and s > bestS then
                                    bestS, bandV, arr, improved = s, cand, trial, true
                                    break
                                end
                            end
                        end
                        if not improved then bd = bd / 2 end
                        if bd < t.step * 2 then break end
                    end
                    say(string.format("band %d/3 best %.0f%%", bi, bestS * 100))
                end
            end

            -- make sure the best map is the one that stays flashed
            if cur[t.key][1] ~= arr[1] or cur[t.key][#arr] ~= arr[#arr] then
                send(t.key, arr)
            end
            Ecu.scores[t.key] = bestS
        end
    end)
    Ecu.running = false
    Ecu.manual = false
    Ecu.tunedFor = veh
    if ok then
        local sum, n = 0, 0
        for _, s in pairs(Ecu.scores) do sum = sum + s n = n + 1 end
        Ecu.text = string.format("ECU tuned ✓ avg %.0f%%", (n > 0 and sum / n or 0) * 100)
    else
        Ecu.text = "ECU tune stopped: " .. tostring(err)
    end
    return ok
end

