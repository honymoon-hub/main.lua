local WORK_FALLBACK = {
    Mechanic_Board = Vector3.new(154.5, 3.42, -194),
    Builder_Board = Vector3.new(98, 2.6, 374),
    Builder_Mixer = Vector3.new(136, 2.6, 390.5),
}

local function ReadWorkTask()
    local raw = LocalPlayer:GetAttribute("WorkTask")
    if type(raw) == "string" and raw ~= "" then
        local ok, t = pcall(HttpService.JSONDecode, HttpService, raw)
        if ok and type(t) == "table" then return t end
    end
    return nil
end

-- Position of a work station: JobPlaces attribute -> tagged WorkStation -> hardcoded fallback
local function StationPos(job, id)
    local v = JobPlaces and JobPlaces:GetAttribute(job .. "_" .. id)
    if typeof(v) == "Vector3" then return v end
    for _, inst in ipairs(CollectionService:GetTagged("WorkStation")) do
        if inst:GetAttribute("StationId") == id then
            local j = inst:GetAttribute("Job")
            if j == nil or j == job then
                local p = InstPos(inst)
                if p then return p end
            end
        end
    end
    return WORK_FALLBACK[job .. "_" .. id]
end

-- Mechanic + Builder share the same flow: Take (board) -> go (Do at station) -> doing (wait) -> Done
local function RunWorkStep(job, moveMode)
    if GetJob() ~= job then
        SetStatus("Switching job -> " .. job)
        return SwitchJob(job)
    end
    local taskObj = ReadWorkTask()
    local gen = State.Gen
    local function Move(pos)
        Travel(pos, moveMode)
        task.wait(0.2)
        return not Cancelled(gen)
    end

    -- No task: wait for cooldown, then Take from the Job Board
    if not taskObj then
        local waitLeft = (LocalPlayer:GetAttribute("WorkNextAt") or 0) - Workspace:GetServerTimeNow()
        if waitLeft > 0 then
            SetStatus(string.format("%s: next task in %ds", job, math.ceil(waitLeft)))
            task.wait(math.min(waitLeft, 1))
            return true
        end
        local board = StationPos(job, "Board")
        if board then
            SetStatus(job .. ": taking a task")
            if not Move(board) then return true end
            Call(WorkRemote, "Take", nil)
            task.wait(0.4)
        end
        return true
    end

    -- Builder: carry cement from the pile to the mixer
    if taskObj.step == "carry" then
        local pos = StationPos(job, taskObj.station or "Mixer") or StationPos(job, "Mixer")
        if pos then
            SetStatus(job .. ": carrying")
            if not Move(pos) then return true end
            Call(WorkRemote, "Done", 1)
            task.wait(0.5)
        end
        return true
    end

    -- Go to the station and start the minigame
    if taskObj.step == "go" then
        local pos = StationPos(job, taskObj.station)
        if pos then
            SetStatus(job .. ": " .. tostring(taskObj.station))
            if not Move(pos) then return true end
            Call(WorkRemote, "Do", taskObj.station)
            task.wait(0.4)
        end
        return true
    end

    -- Minigame running: wait the minimum time then finish with a perfect score
    if taskObj.step == "doing" then
        SetStatus(job .. ": working")
        task.wait(math.max(State.MechanicDelay, (JobShared.MIN_TIME or 3) + 0.2))
        if Cancelled(gen) then return true end
