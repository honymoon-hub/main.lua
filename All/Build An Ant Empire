do
    xDTaraZ.Data.ClaimRarities = {}
    local ctx = xDTaraZ.GameLib.Apis.Context
    local unitConfig = ctx and ctx.Config and ctx.Config.UnitConfig or {}

    -- ลำดับขั้น Rarity จากต่ำไปสูง อ้างอิงจาก modmix.lua
    local ALL_RARITIES = {
        "Common",
        "Uncommon",
        "Rare",
        "Epic",
        "Legendary",
        "Mythic",
        "Exotic",
        "Secret",
        "Divine",
        "OP",
        "Celestial",
        "Eternal",
        "Limited",
    }

    local RARITY_TIER = {}
    for i, r in ipairs(ALL_RARITIES) do
        RARITY_TIER[r:lower()] = i
    end
    xDTaraZ.Data.RarityTier = RARITY_TIER

    local rarityStats = {}
    local seen = {}
    for id, entry in pairs(unitConfig) do
        if type(entry) == "table" and type(entry.Rarity) == "string" then
            local r = entry.Rarity
            if not seen[r] then
                seen[r] = true
                xDTaraZ.Data.ClaimRarities[#xDTaraZ.Data.ClaimRarities + 1] = r
            end
            local num = tonumber(string.match(entry.Id or tostring(id), "%d+")) or 9999
            local price = tonumber(entry.Price) or 0
            if not rarityStats[r] then
                rarityStats[r] = { MinNum = num, MinPrice = price }
            else
                if num < rarityStats[r].MinNum then rarityStats[r].MinNum = num end
                if price > 0 and (rarityStats[r].MinPrice == 0 or price < rarityStats[r].MinPrice) then
                    rarityStats[r].MinPrice = price
                end
            end
        end
    end

    -- เรียงตาม Index / Tier จาก modmix.lua และรองรับ Rarity ใหม่ในอนาคตตาม Unit Index / Price
    table.sort(xDTaraZ.Data.ClaimRarities, function(a, b)
        local tierA = RARITY_TIER[a:lower()]
        local tierB = RARITY_TIER[b:lower()]
        if tierA and tierB then
            return tierA < tierB
        elseif tierA then
            return true
        elseif tierB then
            return false
        else
            local statA = rarityStats[a]
            local statB = rarityStats[b]
            if statA and statB then
                if statA.MinNum ~= statB.MinNum then
                    return statA.MinNum < statB.MinNum
                end
                if statA.MinPrice ~= statB.MinPrice then
                    return statA.MinPrice < statB.MinPrice
                end
            end
            return a < b
        end
    end)
end

