function xDTaraZ.Colony.GetPotionCount(itemId)
    local done, count = false, 0
    task.spawn(function()
        pcall(function()
            local bpsModule = ReplicatedStorage:FindFirstChild("WuKongHooks") and ReplicatedStorage.WuKongHooks:FindFirstChild("BackPackStore")
            if not bpsModule then return end
            local bps = require(bpsModule)
            if bps and bps.GetItemCount then
                count = tonumber(bps:GetItemCount(itemId)) or 0
            end
        end)
        done = true
    end)
    local deadline = os.clock() + 2
    while not done and os.clock() < deadline do
        task.wait()
    end
    return count
end

function xDTaraZ.Colony.GetHolesData()
    local room = xDTaraZ.Colony.Room()
    if not room or not room.LastAntsInfo then return {} end
    local unitConfig = ReplicatedStorage:FindFirstChild("_genConfigs")
        and ReplicatedStorage._genConfigs:FindFirstChild("battle_tbunit")
        and xDTaraZ.GameLib.Require(ReplicatedStorage._genConfigs.battle_tbunit) or {}

    local list = {}
    for _, info in ipairs(room.LastAntsInfo) do
        local uData = unitConfig[info.UnitId] or {}
        local tag = info.Tag
        if not tag or tag == "" or info.TagId == 0 then
            tag = "None"
        end
        table.insert(list, {
            Slot = info.SlotIndex or 0,
            UnitId = info.UnitId or "Unknown",
            Name = uData.DisplayName or info.UnitId or "Ant",
            Rarity = uData.Rarity or "Unknown",
            Tag = tag,
            TagId = info.TagId or 0,
            Level = info.Level or 1,
            V = info.V or 0,
        })
    end
    table.sort(list, function(a, b) return a.Slot < b.Slot end)
    return list
end

function xDTaraZ.Colony.FindSlotModel(slotIndex)
    local roomIndex = xDTaraZ.Colony.GetRoomIndex()
    local room = workspace:FindFirstChild("Rooms") and workspace.Rooms:FindFirstChild(tostring(roomIndex))
    if not room then return nil end
    local antPos = room:FindFirstChild("AntPos")
    if not antPos then return nil end
    local sName = tostring(slotIndex)
    local direct = antPos:FindFirstChild(sName)
    if direct and direct:FindFirstChild("AntInfo") then
        return direct
    end
    for _, layer in ipairs(antPos:GetChildren()) do
        local slot = layer:FindFirstChild(sName)
        if slot and slot:FindFirstChild("AntInfo") then
            return slot
        end
    end
    return nil
end

function xDTaraZ.Colony.UsePotionOnSlot(slotIndex, itemId)
    local roomIndex = xDTaraZ.Colony.GetRoomIndex()
    if not EventRE then return false end
    local slotModel = xDTaraZ.Colony.FindSlotModel(slotIndex)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local origCF = hrp and hrp.CFrame

    print(string.format("[UsePotionOnSlot] slot=%s item=%s foundModel=%s", tostring(slotIndex), tostring(itemId), tostring(slotModel and slotModel:GetFullName())))

    local success = false
    pcall(function()
        -- 1. Hold item in hand (sets BackpackHeldItemId on server)
        EventRE:FireServer("SetBackpackHeldEntry", {
            Kind = "Item",
            EntryKey = "Item:" .. itemId,
            ItemId = itemId,
        })

        -- 2. Teleport close to slot
        if hrp and slotModel then
            hrp.CFrame = slotModel:GetPivot() + Vector3.new(0, 3, 0)
            task.wait(0.2)
        end

        -- 3. Fire server mutation remote
        EventRE:FireServer("UsePotionOnRoomSlot", {
            RoomIndex = roomIndex,
            SlotIndex = tonumber(slotIndex),
            ItemId = itemId,
        })

        task.wait(0.3)

        -- 4. Unequip item in hand
        EventRE:FireServer("SetBackpackHeldEntry", {})

        -- 5. Restore original position
        if hrp and origCF then
            hrp.CFrame = origCF
        end
        success = true
    end)
    return success
end

function xDTaraZ.Colony.MutateStep()
    -- Safety check: disable conflicting auto-equips
    if State.Opt.AutoEquipBest then
        State.Opt.AutoEquipBest = false
        if Library and Library.Options and Library.Options.AutoEquipBest then
            Library.Options.AutoEquipBest:SetValue(false)
        end
        if Library and Library.Notify then
            Library:Notify("Honymoon Hub", "Auto Equip Best disabled to avoid mutating wrong ants!", 4, "Warning")
        end
    end
    if State.Opt.AutoPlaceAnts then
        State.Opt.AutoPlaceAnts = false
        if Library and Library.Options and Library.Options.AutoPlaceAnts then
            Library.Options.AutoPlaceAnts:SetValue(false)
        end
    end

    local targetPotionId = State.Opt.MutateTargetPotion or "HalloweenCs"
    local targetPotionInfo = nil
    for _, p in ipairs(xDTaraZ.Colony.MutationPotions) do
        if p.Id == targetPotionId then
            targetPotionInfo = p
            break
        end
    end
    local targetTagName = targetPotionInfo and targetPotionInfo.Tag or "Halloween"

    local holes = xDTaraZ.Colony.GetHolesData()
    if #holes == 0 then return false end

    local removeCount = xDTaraZ.Colony.GetPotionCount("RemoveMuCs")
    local targetCount = xDTaraZ.Colony.GetPotionCount(targetPotionId)

    for _, ant in ipairs(holes) do
        local rMatch = State.Opt.MutateSelectedRarities and State.Opt.MutateSelectedRarities[ant.Rarity]
        if rMatch then
            -- Check if already has target buff
            if ant.Tag ~= targetTagName then
                -- Check if current buff is in allowed replace list
                local canReplace = State.Opt.MutateReplaceBuffs and State.Opt.MutateReplaceBuffs[ant.Tag]
                if canReplace then
                    print(string.format("[MutateStep] Target slot %d: %s [%s] currentBuff=%s (TagId=%d)", ant.Slot, ant.Name, ant.Rarity, ant.Tag, ant.TagId))
                    -- If has an existing buff (TagId > 0), must remove first
                    if ant.TagId and ant.TagId > 0 then
                        if removeCount <= 0 then
                            State.Opt.AutoMutateAnts = false
                            if Library and Library.Options and Library.Options.AutoMutateAnts then
                                Library.Options.AutoMutateAnts:SetValue(false)
                            end
                            if Library and Library.Notify then
                                Library:Notify("Mutation Manager", "Auto Mutate stopped: No Mutation Removal Potions left!", 5, "Warning")
                            end
                            return false
                        end
                        xDTaraZ.Colony.UsePotionOnSlot(ant.Slot, "RemoveMuCs")
                        task.wait(State.Opt.MutateDelay or 0.5)
                        return true
                    else
                        -- No buff on ant (TagId == 0), apply target potion!
                        if targetCount <= 0 then
                            State.Opt.AutoMutateAnts = false
                            if Library and Library.Options and Library.Options.AutoMutateAnts then
                                Library.Options.AutoMutateAnts:SetValue(false)
                            end
                            if Library and Library.Notify then
                                Library:Notify("Mutation Manager", "Auto Mutate stopped: No " .. (targetPotionInfo and targetPotionInfo.Name or "Target") .. " left!", 5, "Warning")
                            end
                            return false
                        end
                        xDTaraZ.Colony.UsePotionOnSlot(ant.Slot, targetPotionId)
                        task.wait(State.Opt.MutateDelay or 0.5)
                        return true
                    end
                end
            end
        end
    end
    return false
end

