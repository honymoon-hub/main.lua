function xDTaraZ.Colony.IsFreeEventOffer(offer)
    if type(offer) ~= "table" then return false end
    local costNum = tonumber(offer.Cost)
    local isZeroCost = (costNum == 0) or (offer.Cost == nil and offer.Currency == nil)
    local isFreeCurrency = (offer.Currency == "Free" or offer.Currency == "免费" or offer.Currency == "ฟรี" or offer.Currency == "")

    local isItem = offer.ResultType == "Item"
        or (type(offer.ItemId) == "string" and offer.ItemId ~= "")
        or offer.PresentationType == "Star"
        or offer.PresentationType == "Clock"
        or offer.PresentationType == "Wisp"
        or (type(offer.PresentationType) == "string" and offer.PresentationType ~= "Normal" and not offer.PresentationType:find("^Luck%d+$"))

    if isItem and (isZeroCost or isFreeCurrency or costNum == 0) then
        return true
    end
    if isZeroCost and (isFreeCurrency or not offer.UnitId or isItem) then
        return true
    end
    if costNum == 0 and offer.Currency ~= "金币" then
        return true
    end
    if offer.ResultType == "Item" or (type(offer.ItemId) == "string" and not offer.UnitId) then
        return true
    end
    return false
end

function xDTaraZ.Colony.ClaimRolled(claimId)
    if not claimId or xDTaraZ.Colony.ClaimsInFlight() then return false end
    local spending = State.Actions.Spend
    if spending and coroutine.status(spending) ~= "dead" then return false end
    local offer = State.PendingRolls[claimId]
    if not offer then return false end

    local isFreeEvent = xDTaraZ.Colony.IsFreeEventOffer(offer)
    if isFreeEvent then
        if not (State.Opt.AutoClaimEventItem or State.Opt.AutoClaimRolled or State.Opt.Kaitun) then
            return false
        end
        State.InFlight[claimId] = os.clock()
        return xDTaraZ.Util.FireEcs("ClaimRolledAnt", { ClaimId = claimId })
    end

    local shouldClaim = false
    if State.Opt.AutoClaimRolled or State.Opt.Kaitun then
        if not next(State.Opt.ClaimRarities) or State.Opt.ClaimRarities[offer.Rarity] then
            shouldClaim = true
        end
    end
    if not shouldClaim and State.Opt.AutoClaimNewIndex and offer.UnitId then
        if not xDTaraZ.Colony.IsAntDiscovered(offer.UnitId) then
            shouldClaim = true
        end
    end
    if not shouldClaim and State.Opt.AutoRollMissingCoCreation and offer.UnitId then
        local needed = xDTaraZ.CoCreation and xDTaraZ.CoCreation.GetNeededAntInfo and xDTaraZ.CoCreation.GetNeededAntInfo()
        if needed and offer.UnitId == needed.UnitId then
            shouldClaim = true
        end
    end
    if not shouldClaim then return false end

    local gold = xDTaraZ.Data.Snapshot().Gold
    local cost = tonumber(offer.Cost)
    if not cost or cost ~= cost or cost < 0 or cost == math.huge then return false end
    if offer.Currency and offer.Currency ~= "金币" then return false end
    if cost > math.max(0, gold - State.Opt.KeepGold) then return false end
    State.InFlight[claimId] = os.clock()
    return xDTaraZ.Util.FireEcs("ClaimRolledAnt", { ClaimId = claimId })
end

function xDTaraZ.Colony.ClaimPending()
    if xDTaraZ.Colony.ClaimsInFlight() or not next(State.PendingRolls) then return end
    local offers = {}
    for claimId, offer in pairs(State.PendingRolls) do
        local isEvent = xDTaraZ.Colony.IsFreeEventOffer(offer)
        local backpack = xDTaraZ.GameLib.Apis.Backpack
        local entry = backpack and xDTaraZ.GameLib.Call(backpack.BuildEntry, backpack, {
            Ecs = { Context = xDTaraZ.GameLib.Apis.Context },
        }, "Backpack", offer.V, 1, 0)
        offers[#offers + 1] = {
            Id = claimId,
            Offer = offer,
            IsEvent = isEvent,
            Attack = entry and entry.Attack or 0,
        }
    end
    table.sort(offers, function(a, b)
        if a.IsEvent ~= b.IsEvent then
            return a.IsEvent == true
        end
        if a.Attack ~= b.Attack then return a.Attack > b.Attack end
        return (a.Offer.Cost or 0) < (b.Offer.Cost or 0)
    end)
    for _, entry in ipairs(offers) do
        if xDTaraZ.Colony.ClaimRolled(entry.Id) then break end
    end
end

function xDTaraZ.Colony.QueueClaims()
    if not State.Alive or not (State.Opt.AutoClaimRolled or State.Opt.Kaitun or State.Opt.AutoClaimEventItem or State.Opt.AutoClaimNewIndex or State.Opt.AutoRollMissingCoCreation) then return end
    local queued = State.ClaimThread
    if queued and coroutine.status(queued) ~= "dead" then return end
    State.ClaimThread = xDTaraZ.Util.Child(function()
        if not State.Alive or not xDTaraZ.Util.Current() then return end
        if State.Opt.AutoClaimRolled or State.Opt.Kaitun or State.Opt.AutoClaimEventItem or State.Opt.AutoClaimNewIndex or State.Opt.AutoRollMissingCoCreation then
            xDTaraZ.Util.Try(xDTaraZ.Colony.ClaimPending)
        end
    end)
end

