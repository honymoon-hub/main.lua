function xDTaraZ.Halloween.EnterDungeon()
    return xDTaraZ.Util.Action("HalloweenDungeon", function()
        -- 1. เช็คว่าอยู่ในดันเจี้ยนอยู่แล้วหรือไม่
        local sessionId = LocalPlayer:GetAttribute("DungeonSessionId")
        local inDungeon = type(sessionId) == "string" and sessionId ~= ""

        if not inDungeon then
            local entrance = workspace:FindFirstChild("HalloweenDungeonEntrance")
            if not entrance then return false, "Dungeon entrance not found" end
            local hrp = xDTaraZ.Util.GetHRP()
            if not hrp then return false end

            local origCF = hrp.CFrame
            local pos = entrance:IsA("BasePart") and entrance.Position or entrance:GetPivot().Position
            hrp.CFrame = CFrame.new(pos + Vector3.new(0, 2, 2.5))
            task.wait(0.3)

            -- 2. กดย้ำๆ ส่ง Will-o'-Wisps (0/40) จนกว่าจะเต็มหรือเปิด
            local isOpen = entrance:GetAttribute("IsOpen") == true
            local submitted = tonumber(entrance:GetAttribute("SubmittedCount")) or 0

            if not isOpen and submitted < 40 then
                local lastSubmitted = submitted
                local noChangeTicks = 0

                for i = 1, 50 do
                    if not State.Alive or not xDTaraZ.Util.Current() then break end
                    isOpen = entrance:GetAttribute("IsOpen") == true
                    submitted = tonumber(entrance:GetAttribute("SubmittedCount")) or 0
                    if isOpen or submitted >= 40 then break end

                    if (hrp.Position - pos).Magnitude > 6 then
                        hrp.CFrame = CFrame.new(pos + Vector3.new(0, 2, 2.5))
                        task.wait(0.2)
                    end

                    local prompt = entrance:FindFirstChildWhichIsA("ProximityPrompt", true)
                    if prompt and prompt.Enabled and fireproximityprompt then
                        fireproximityprompt(prompt)
                    end
                    task.wait(0.25)

                    submitted = tonumber(entrance:GetAttribute("SubmittedCount")) or 0
                    if submitted == lastSubmitted then
                        noChangeTicks += 1
                        if noChangeTicks >= 8 then
                            break
                        end
                    else
                        lastSubmitted = submitted
                        noChangeTicks = 0
                    end
                end
            end

            -- 3. เมื่อประตูเปิดแล้ว (IsOpen == true) -> กด Enter เพื่อเข้าดันเจี้ยน
            isOpen = entrance:GetAttribute("IsOpen") == true
            if isOpen then
                for i = 1, 10 do
                    if not State.Alive or not xDTaraZ.Util.Current() then break end
                    local currentSession = LocalPlayer:GetAttribute("DungeonSessionId")
                    if type(currentSession) == "string" and currentSession ~= "" then
                        inDungeon = true
                        break
                    end

                    if (hrp.Position - pos).Magnitude > 6 then
                        hrp.CFrame = CFrame.new(pos + Vector3.new(0, 2, 2.5))
                        task.wait(0.2)
                    end

                    local prompt = entrance:FindFirstChildWhichIsA("ProximityPrompt", true)
                    if prompt and prompt.Enabled and fireproximityprompt then
                        fireproximityprompt(prompt)
                    end
                    task.wait(0.5)
                end
            end
        end

        -- 4. รอเข้าดันเจี้ยนสมบูรณ์ (โหลดฉาก / SessionId ขึ้น)
        local entered = false
        for i = 1, 20 do
            local currentSession = LocalPlayer:GetAttribute("DungeonSessionId")
            if type(currentSession) == "string" and currentSession ~= "" then
                entered = true
                break
            end
            task.wait(0.4)
        end

        if not entered then
            return false, "Failed to enter dungeon"
        end

        -- 5. เมื่อเข้าดันเจี้ยนแล้ว: กดปุ่ม Start
        task.wait(1.0)
        for i = 1, 15 do
            if not State.Alive or not xDTaraZ.Util.Current() then break end
            local currentSession = LocalPlayer:GetAttribute("DungeonSessionId")
            if not currentSession or currentSession == "" then break end

            local pgui = LocalPlayer:FindFirstChild("PlayerGui")
            local hud = pgui and pgui:FindFirstChild("HUDContainer")
            local panel = hud and hud:FindFirstChild("DungeonPanel")
            local startBtn = panel and panel:FindFirstChild("StartBtn")

            if startBtn and startBtn.Visible then
                xDTaraZ.Halloween.PressStart()
                task.wait(0.5)
            else
                break
            end
        end

        -- 6. ระหว่างต่อสู้: ช่วยเก็บไอคอนเพิ่มเวลา (+15s) และรอจนจบ หรือจนกดออก
        local sessionActive = true
        while sessionActive and State.Alive and xDTaraZ.Util.Current() do
            local currentSession = LocalPlayer:GetAttribute("DungeonSessionId")
            if not currentSession or currentSession == "" then
                sessionActive = false
                break
            end

            -- เก็บไอคอน +15s (TimeIcon) อัตโนมัติรอบห้องดัน
            pcall(function()
                for _, obj in ipairs(workspace:GetChildren()) do
                    if obj.Name:find("DungeonVisuals") then
                        for _, d in ipairs(obj:GetDescendants()) do
                            if d:IsA("ProximityPrompt") and d.Enabled and d.ActionText:find("%+15s") then
                                if fireproximityprompt then
                                    fireproximityprompt(d)
                                end
                            end
                        end
                    end
                end
            end)

            task.wait(0.5)
        end

        return true
    end)
end

