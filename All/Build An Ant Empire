    local hud = pgui and pgui:FindFirstChild("HUDContainer")
    local panel = hud and hud:FindFirstChild("DungeonPanel")
    local quitBtn = panel and panel:FindFirstChild("QuitBtns") and panel.QuitBtns:FindFirstChild("Surrender") and panel.QuitBtns.Surrender:FindFirstChild("Btn")

