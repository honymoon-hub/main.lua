function xDTaraZ.Esp.CreateHighlight(inst, color, fill)
    local highlight = Instance.new("Highlight")
    highlight.Name = "MarioEsp"
    highlight.Adornee = inst
    highlight.OutlineColor = color
    highlight.FillColor = fill
    highlight.FillTransparency = 0.5
    highlight.OutlineTransparency = 0
    highlight.Parent = inst
    return highlight
end

function xDTaraZ.Esp.Clear()
    for target, highlight in pairs(State.EspObjects or {}) do
        highlight:Destroy()
        State.EspObjects[target] = nil
    end
end

function xDTaraZ.Esp.Update()
    local wanted = {}
    State.EspObjects = State.EspObjects or {}
    local myHrp = xDTaraZ.Util.GetHRP()
    local myPos = myHrp and myHrp.Position or Vector3.zero

    if State.Opt.EspBoss then
        local boss = workspace:FindFirstChild("StrawberryKing") or workspace:FindFirstChild("StrawberryKingPart")
        if boss then
            wanted[boss] = Color3.fromRGB(255, 60, 60)
        end
    end

    if State.Opt.EspDungeon then
        local entrances = workspace:FindFirstChild("DungeonEntrances")
        if entrances then
            for _, ent in ipairs(entrances:GetChildren()) do
                wanted[ent] = Color3.fromRGB(80, 200, 255)
            end
        end
    end

    if State.Opt.EspPlayers then
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer and plr.Character then
                local pHrp = plr.Character:FindFirstChild("HumanoidRootPart")
                if pHrp and (pHrp.Position - myPos).Magnitude <= State.Opt.EspDist then
                    wanted[plr.Character] = Color3.fromRGB(100, 255, 100)
                end
            end
        end
    end
    for target, highlight in pairs(State.EspObjects) do
        if not target.Parent or not wanted[target] then
            highlight:Destroy()
            State.EspObjects[target] = nil
        end
    end
    for target, color in pairs(wanted) do
        if not State.EspObjects[target] then
            State.EspObjects[target] = xDTaraZ.Esp.CreateHighlight(target, color, color)
        end
    end
end

function xDTaraZ.Collect.ClaimDailyEvents()
    local model = xDTaraZ.GameLib.Apis.SevenDay
    if not model or not xDTaraZ.GameLib.Call(model.IsAward, model) then return false end
    return xDTaraZ.GameLib.Call(model.GetReward, model) == true
end

function xDTaraZ.Collect.ClaimAllOnlineAwards()
    local claimed = 0
    for _ = 1, xDTaraZ.Data.OnlineAwardCount do
        if not State.Alive or not xDTaraZ.Rewards.ClaimOnline() then break end
        claimed += 1
    end
    return claimed
end

function xDTaraZ.Collect.ClaimAllAntRewards()
    local room = xDTaraZ.Colony.Room()
    if not room then return false end
    local indices = {}
    for slot, ant in pairs(room.AntObjects or {}) do
        if ant.HasCarriedRewards and xDTaraZ.GameLib.Call(ant.HasCarriedRewards, ant) then
            indices[#indices + 1] = slot
        end
    end
    if #indices == 0 then return false end
    return xDTaraZ.Util.FireEcs("ClaimAntReward", { AntIndices = indices })
end

function xDTaraZ.Collect.ClaimAllWorkerFood()
    local room = xDTaraZ.Colony.Room()
    if not room then return false end
    local claims = {}
    for slot, ant in pairs(room.AntObjects or {}) do
        local amount = ant.info and tonumber(ant.info.Food) or 0
        if amount > 0 then claims[#claims + 1] = { SlotIndex = slot, Amount = math.floor(amount) } end
    end
    if #claims == 0 then return false end
    return xDTaraZ.Util.FireEcs("ClaimWorkerAntFood", { SubmissionId = HttpService:GenerateGUID(false), Claims = claims })
end

function xDTaraZ.Collect.UpgradeAllEquippedAnts()
    local room = xDTaraZ.Colony.Room()
    if not room then return 0 end
    local count = 0
    for slot in pairs(room.AntObjects or {}) do
        if not State.Alive then break end
        xDTaraZ.Util.FireEcs("UpgradeEquippedAnt", { AntIndex = slot })
        count += 1
    end
    return count
end

function xDTaraZ.Halloween.CheckIn()
    return xDTaraZ.Util.Action("HalloweenCheckIn", function()
        local checkInPart = workspace:FindFirstChild("HalloweenCheckIn")
        if not checkInPart then return false, "No CheckIn part found" end
        local hrp = xDTaraZ.Util.GetHRP()
        if not hrp then return false, "Character not ready" end
        local prompt = checkInPart:FindFirstChildWhichIsA("ProximityPrompt", true)
        if prompt and not prompt.Enabled then
            return false, "CheckIn not ready"
        end
        local pos = checkInPart:IsA("BasePart") and checkInPart.Position or checkInPart:GetPivot().Position
        local origCF = hrp.CFrame
        hrp.CFrame = CFrame.new(pos + Vector3.new(0, 1.5, 3))
        task.wait(0.25)
        if prompt and fireproximityprompt then
            fireproximityprompt(prompt)
        end
        task.wait(0.4)
        hrp.CFrame = origCF
        return true
    end)
end

function xDTaraZ.Halloween.CollectTreasure()
    return xDTaraZ.Util.Action("HalloweenTreasure", function()
        local hrp = xDTaraZ.Util.GetHRP()
        if not hrp then return false end
        local RS = game:GetService("ReplicatedStorage")
        local EventBus = nil
        pcall(function() EventBus = require(RS.Packages.EventBus) end)
        local vt = nil
        pcall(function() vt = require(RS.UI.Halloween.View.Treasure) end)

        local chests = {}
        if vt and vt.Chests then
            for id, info in pairs(vt.Chests) do
                if info.Model and info.Model:FindFirstChild("RootPart") then
                    local prompt = info.Prompt or info.Model.RootPart:FindFirstChildOfClass("ProximityPrompt")
                    table.insert(chests, { id = id, model = info.Model, root = info.Model.RootPart, prompt = prompt })
                end
            end
        end

        if #chests == 0 then
            for _, c in ipairs(workspace:GetChildren()) do
                if c.Name == "Treasure" and c:FindFirstChild("RootPart") then
                    local prompt = c.RootPart:FindFirstChildOfClass("ProximityPrompt")
                    table.insert(chests, { id = nil, model = c, root = c.RootPart, prompt = prompt })
                end
            end
        end

        if #chests == 0 then return false end

        local origCF = hrp.CFrame
        local collected = 0
        for _, ch in ipairs(chests) do
            if not State.Alive or not xDTaraZ.Util.Current() then break end
            if not State.Opt.AutoHalloweenTreasure then break end
            if ch.root and ch.root.Parent then
                hrp.CFrame = CFrame.new(ch.root.Position + Vector3.new(0, 1.5, 2.5))
                task.wait(0.25)
                if ch.prompt and fireproximityprompt then
                    fireproximityprompt(ch.prompt)
                end
                if EventBus and ch.id then
                    pcall(function() EventBus.FireServer("HalloweenTreasureRequest", "Open", ch.id) end)
                end
                collected += 1
                task.wait(0.35)
            end
        end
        hrp.CFrame = origCF
        return collected > 0
    end)
end

local function clickGui(btn)
    if not btn then return false end
    pcall(function()
        if btn:IsA("GuiButton") and btn.Active then
            btn.Selected = true
        end
    end)
    if firesignal then
        pcall(function() firesignal(btn.MouseButton1Click) end)
        pcall(function() firesignal(btn.Activated) end)
        pcall(function() firesignal(btn.MouseButton1Down) end)
        pcall(function() firesignal(btn.MouseButton1Up) end)
    end
    pcall(function()
        local vim = game:GetService("VirtualInputManager")
        if vim and btn.AbsolutePosition and btn.AbsoluteSize then
            local center = btn.AbsolutePosition + (btn.AbsoluteSize / 2)
            if center.X > 0 and center.Y > 0 then
                vim:SendMouseMoveEvent(center.X, center.Y, game)
                task.wait(0.02)
                vim:SendMouseButtonEvent(center.X, center.Y, 0, true, game, 1)
                task.wait(0.04)
                vim:SendMouseButtonEvent(center.X, center.Y, 0, false, game, 1)
            end
        end
    end)
    return true
end

function xDTaraZ.Halloween.PressStart()
    local pgui = LocalPlayer:FindFirstChild("PlayerGui")
    local hud = pgui and pgui:FindFirstChild("HUDContainer")
    local panel = hud and hud:FindFirstChild("DungeonPanel")
    local btn = panel and panel:FindFirstChild("StartBtn")

    pcall(function()
        local EventBus = require(ReplicatedStorage.Packages.EventBus)
        EventBus.Fire("DungeonStartRequested")
    end)

    if btn and btn.Visible then
        clickGui(btn)
        local img = btn:FindFirstChildOfClass("ImageLabel") or btn:FindFirstChild("ImageLabel")
        if img then clickGui(img) end
        return true
    end
    return false
end

function xDTaraZ.Halloween.ExitDungeon()
