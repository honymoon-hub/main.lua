function xDTaraZ.CoCreation.GetState()
    local attr = LocalPlayer:GetAttribute("ActivityData2")
    if type(attr) ~= "string" or attr == "" then return nil end
    local ok, data = pcall(HttpService.JSONDecode, HttpService, attr)
    return ok and type(data) == "table" and data or nil
end

function xDTaraZ.CoCreation.GetConfig()
    local cfgMod = ReplicatedStorage:FindFirstChild("Helper")
        and ReplicatedStorage.Helper:FindFirstChild("PublicVote")
        and ReplicatedStorage.Helper.PublicVote:FindFirstChild("Config")
    if cfgMod then
        local ok, cfg = pcall(require, cfgMod)
        if ok then return cfg end
    end
    return nil
end

function xDTaraZ.CoCreation.GetRequirements(state)
    local cfg = xDTaraZ.CoCreation.GetConfig()
    if not cfg or not state then return nil end
    return cfg.GetRequirements(LocalPlayer.UserId, state.RequirementRoll, state.RequirementQueenLevel)
end

function xDTaraZ.CoCreation.GetPositionForOption(option)
    local cfg = xDTaraZ.CoCreation.GetConfig()
    local nodeName = cfg and cfg.NodeName or "投票"
    local node = workspace:FindFirstChild("NodeFold") and workspace.NodeFold:FindFirstChild(nodeName)
    local modelName = cfg and cfg.OptionModels and cfg.OptionModels[option] or (option == "Option1" and "Active1" or "Active2")
    local optModel = node and node:FindFirstChild(modelName)
    local part = optModel and optModel:FindFirstChild("part")
    if part then
        return part.Position
    end
    if option == "Option1" then
        return Vector3.new(224.31, 13.14, 264.72)
    else
        return Vector3.new(196.83, 13.14, 230.07)
    end
end

function xDTaraZ.CoCreation.FindAntsInBackpack(unitId)
    local bmMod = ReplicatedStorage:FindFirstChild("UI")
        and ReplicatedStorage.UI:FindFirstChild("Backpack")
        and ReplicatedStorage.UI.Backpack:FindFirstChild("Model")
        and ReplicatedStorage.UI.Backpack.Model:FindFirstChild("BackpackModel")
    local bpsMod = ReplicatedStorage:FindFirstChild("WuKongHooks") and ReplicatedStorage.WuKongHooks:FindFirstChild("BackPackStore")
    if not bmMod or not bpsMod then return {} end
    local ok1, bm = pcall(require, bmMod)
    local ok2, bps = pcall(require, bpsMod)
    if not ok1 or not ok2 or not bm or not bm.BackPackData or not bm.BackPackData.Stacks then return {} end

    local unitNum = tonumber(string.match(tostring(unitId), "^Unit(%d+)$"))
    if not unitNum then return {} end

    local matches = {}
    for valStr, count in pairs(bm.BackPackData.Stacks) do
        local val = tonumber(valStr)
        if val and count and count > 0 then
            local u, t, exp = bps.DecodeValue(val)
            if u == unitNum then
                table.insert(matches, {
                    val = val,
                    count = count,
                    tag = t or 0,
                    exp = exp or 0,
                })
            end
        end
    end
    table.sort(matches, function(a, b)
        if a.tag ~= b.tag then return a.tag < b.tag end
        return a.exp < b.exp
    end)
    return matches
end

function xDTaraZ.CoCreation.GetNeededAntInfo()
    local state = xDTaraZ.CoCreation.GetState()
    if not state then return nil end
    local reqs = xDTaraZ.CoCreation.GetRequirements(state)
    if not reqs or #reqs == 0 then return nil end

    for i, req in ipairs(reqs) do
        local submitted = (state.SubmittedCounts and state.SubmittedCounts[i]) or 0
        if submitted < req.Amount then
            local ants = xDTaraZ.CoCreation.FindAntsInBackpack(req.UnitId)
            local totalAvailable = 0
            for _, a in ipairs(ants) do totalAvailable = totalAvailable + a.count end
            return {
                ReqIndex = i,
                UnitId = req.UnitId,
                AmountNeeded = req.Amount - submitted,
                TotalRequired = req.Amount,
                Submitted = submitted,
                Available = totalAvailable,
                Ants = ants,
                Option = state.VotedOption or State.Opt.CoCreationFavoriteOption or "Option2"
            }
        end
    end
    return nil
end

function xDTaraZ.CoCreation.Vote(option)
    return xDTaraZ.Util.Action("CoCreationVote", function()
        local state = xDTaraZ.CoCreation.GetState()
        local now = math.floor(workspace:GetServerTimeNow())
        local nextVoteAt = state and tonumber(state.NextVoteAt) or 0
        if nextVoteAt > now then
            return false, "Cooldown: Next vote at " .. os.date("%X", nextVoteAt)
        end

        local opt = option or State.Opt.CoCreationFavoriteOption or "Option2"
        local hrp = xDTaraZ.Util.GetHRP()
        if not hrp then return false, "No character" end
        local origCF = hrp.CFrame
        local targetPos = xDTaraZ.CoCreation.GetPositionForOption(opt)

        hrp.CFrame = CFrame.new(targetPos + Vector3.new(0, 2, 0))
        task.wait(0.3)

        local okEB, EventBus = pcall(require, ReplicatedStorage.Packages.EventBus)
        if okEB and EventBus then
            EventBus.FireServer("PublicVote.Request", {
                Action = "Vote",
                Option = opt
            })
            task.wait(0.5)
        end

        if hrp and origCF then hrp.CFrame = origCF end
        return true
    end)
end

function xDTaraZ.CoCreation.SubmitStep()
    return xDTaraZ.Util.Action("CoCreationSubmit", function()
        local needed = xDTaraZ.CoCreation.GetNeededAntInfo()
        if not needed then return false, "No pending requirement" end
        if needed.Available < 1 or #needed.Ants == 0 then
            return false, "MissingAnt"
        end

        local hrp = xDTaraZ.Util.GetHRP()
        if not hrp then return false, "No character" end
        local origCF = hrp.CFrame
        local targetPos = xDTaraZ.CoCreation.GetPositionForOption(needed.Option)

        hrp.CFrame = CFrame.new(targetPos + Vector3.new(0, 2, 0))
        task.wait(0.25)

        local okEB, EventBus = pcall(require, ReplicatedStorage.Packages.EventBus)
        if not okEB or not EventBus then
            if hrp and origCF then hrp.CFrame = origCF end
            return false, "EventBus unavailable"
        end

        local antToSubmit = needed.Ants[1]

        -- 1. Hold Ant
        EventBus.FireServer("SetBackpackHeldEntry", {
            Kind = "Ant",
            EntryKey = "Ant:" .. tostring(antToSubmit.val),
            V = antToSubmit.val
        })
        task.wait(0.25)

        -- 2. Submit
        EventBus.FireServer("PublicVote.Request", {
            Action = "Submit",
            Option = needed.Option,
            ExpectedValue = antToSubmit.val,
            RequirementIndex = needed.ReqIndex,
            SkipSubmitConfirmation = true
        })
        task.wait(0.3)

        -- 3. Clear held
        EventBus.FireServer("SetBackpackHeldEntry", {})
        task.wait(0.1)

        -- 4. Restore position
        if hrp and origCF then hrp.CFrame = origCF end
        return true
    end)
end

function xDTaraZ.CoCreation.DisableAntSummoning()
    if State.Opt.AutoRoll then
        State.Opt.AutoRoll = false
        if Library and Library.Toggles and Library.Toggles.AutoRoll then
            pcall(function() Library.Toggles.AutoRoll:SetValue(false) end)
        end
    end
    pcall(function()
        local arState = require(ReplicatedStorage.UI.AutoRoll.Model.State)
        if arState and arState.Settings and arState.Settings.AutoRollEnabled then
            arState:SetAutoRollEnabled(false)
            arState:ClearTargetBeams()
        end
    end)
end

function xDTaraZ.CoCreation.Step()
    if not State.Alive or not xDTaraZ.Util.Current() then return false end

    -- 1. Check Auto Vote
    if State.Opt.AutoVoteCoCreation then
        local state = xDTaraZ.CoCreation.GetState()
        local now = math.floor(workspace:GetServerTimeNow())
        local nextVoteAt = state and tonumber(state.NextVoteAt) or 0
        if nextVoteAt <= now then
            xDTaraZ.CoCreation.Vote(State.Opt.CoCreationFavoriteOption or "Option2")
            return true
        end
    end

    -- 2. Check Auto Submit & Auto Roll Missing
    if State.Opt.AutoSubmitCoCreation or State.Opt.AutoRollMissingCoCreation then
        local needed = xDTaraZ.CoCreation.GetNeededAntInfo()
        if needed then
            if needed.Available >= 1 and State.Opt.AutoSubmitCoCreation then
                xDTaraZ.CoCreation.SubmitStep()
                return true
            elseif needed.Available < 1 and State.Opt.AutoRollMissingCoCreation then
                xDTaraZ.CoCreation.DisableAntSummoning()
                xDTaraZ.Colony.RollAnt(nil)
                return true
            end
        end
    end
    return false
end

function xDTaraZ.Economy.Step()
    if State.Actions.Economy then return false end
    local auto = State.Opt.Kaitun
    return xDTaraZ.Util.Action("Economy", function()
        xDTaraZ.Collect.ClaimAllWorkerFood()
        xDTaraZ.Farm.CollectFood()
        if not State.Alive then return false end
        xDTaraZ.Farm.SellFood()
        if not State.Alive then return false end
        local poolCost = xDTaraZ.Progression.PoolCost()
        local balance = xDTaraZ.Data.Snapshot().Gold - State.Opt.KeepGold
        if auto and not State.Opt.Kaitun then return false end
        if State.Opt.UpgradePriority == "Stats first" and xDTaraZ.Progression.UpgradeAll() then
            xDTaraZ.Util.PushStatus("Progression", "Upgraded an affordable stat")
        elseif poolCost and balance >= poolCost then
            xDTaraZ.Progression.UpgradePool()
        elseif State.Opt.UpgradeAllAttr then
            xDTaraZ.Progression.UpgradeAll()
        else
            xDTaraZ.Progression.UpgradeAttribute(State.Opt.AttrTarget)
        end
        if not State.Alive or (auto and not State.Opt.Kaitun) then return false end
        xDTaraZ.Colony.ClaimPending()
        xDTaraZ.Colony.RollAnt()
        xDTaraZ.Colony.EquipBest()
        xDTaraZ.Rewards.ClaimOnline()
        return true
    end)
end

xDTaraZ:Connect(EventRE.OnClientEvent, function(event, data)
    if not State.Alive then return end
    State.Replies[event] = { At = os.clock(), Payload = data }
    if event == "RollAntResult" and type(data) == "table" and type(data.Results) == "table" then
        State.PendingRolls = {}
        State.Metrics.Rolls += 1
        for _, offer in ipairs(data.Results or {}) do
            if type(offer) == "table" and type(offer.ClaimId) == "string" then State.PendingRolls[offer.ClaimId] = offer end
        end
        xDTaraZ.Colony.QueueClaims()
    elseif event == "ClaimRolledAntResult" and type(data) == "table" and type(data.ClaimId) == "string" then
        local requested = State.InFlight[data.ClaimId] ~= nil
        State.InFlight[data.ClaimId] = nil
        if data.Success then
            State.PendingRolls[data.ClaimId] = nil
            if requested then State.Metrics.Claims += 1 end
            if data.ResultType == "Item" or data.ItemId then
                local itemName = tostring(data.ItemId or "Event Item")
                if Library and Library.Notify then
                    xDTaraZ.Util.Later(function()
                        Library:Notify("Honymoon Hub", "Claimed Event Item: " .. itemName, 3, "Success")
                    end)
                end
            end
            xDTaraZ.Colony.QueueClaims()
        elseif data.Reason == "Expired" or data.Reason == "Replaced" then
            State.PendingRolls[data.ClaimId] = nil
        elseif requested then
            State.InFlight[data.ClaimId] = os.clock()
        end
    elseif event == "SellResuit" and type(data) == "table" and data.Success then
        State.Metrics.Sales += 1
        State.Metrics.Gold += type(data.Result) == "table" and tonumber(data.Result.GoldAmount) or 0
    elseif event == "SellFoodPriceUpdate" and type(data) == "table" then
        if data.GoldPerFood then
            State.FoodPrice = data.GoldPerFood
            State.PriceTime = os.clock()
        end
    elseif event == "StrawberryKingState" and type(data) == "table" then
        State.BossActive = data.Active == true
    end
end)

