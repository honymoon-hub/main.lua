-- Real-time Heartbeat Pump
local lastRenderPets = 0
local lastRenderCages = 0
local lastRenderBag = 0
local lastRenderRadar = 0
local lastAutoStore = 0
local lastAutoSteal = 0
local lastStats = 0
local lastAutoFuse = 0
local lastHalloweenUpdate = 0
local lastAutoBuyCandy = 0

local heartbeatConn = RunService.Heartbeat:Connect(function()
    local now = os.clock()

    -- Auto Steal (Simwalk) loop every 1.5s
    if State.AutoStealCages and not State.IsStealingCycleRunning and (now - lastAutoSteal >= 1.5) then
        lastAutoSteal = now
        pcall(RunStealCycle)
    end

    -- Auto Store Pets every 1.5s
    if State.AutoStorePets and (now - lastAutoStore >= 1.5) then
        lastAutoStore = now
        pcall(ProcessAutoStorePets)
    end

    -- Update World Cages Radar every 3s
    if State.NeedsRadarRefresh or (now - lastRenderRadar >= 3) then
        State.NeedsRadarRefresh = false
        lastRenderRadar = now
        pcall(RenderRadarList)
    end

    -- Update Pet cards when requested or every 4s
    if State.NeedsPetRefresh or (now - lastRenderPets >= 4) then
        State.NeedsPetRefresh = false
        lastRenderPets = now
        pcall(RenderPetsList)
    end

    -- Update Cage countdowns every 1s
    if State.NeedsCageRefresh or (now - lastRenderCages >= 1) then
        State.NeedsCageRefresh = false
        lastRenderCages = now
        pcall(RenderCagesList)
    end

    -- Update Bag Cages every 2s
    if State.NeedsBagRefresh or (now - lastRenderBag >= 2) then
        State.NeedsBagRefresh = false
        lastRenderBag = now
        pcall(RenderBagCagesList)
    end

    -- Update Overview stats every 3s
    if now - lastStats >= 3 then
        lastStats = now
        pcall(UpdateOverviewStats)
    end

    -- Auto Fuse background loop every 15s
    if State.AutoFuse and not State.IsAutoFusing and not State.IsStealingActive and not State.IsAutoPlacing then
        if now - lastAutoFuse >= 15 then
            lastAutoFuse = now
            RunAutoFuse(false)
        end
    end

    -- Update Halloween Candy stats every 2s
    if State.NeedsHalloweenRefresh or (now - lastHalloweenUpdate >= 2) then
        State.NeedsHalloweenRefresh = false
        lastHalloweenUpdate = now
        pcall(UpdateHalloweenStats)
    end

    -- Auto Buy Selected Candy Item every 5s
    if State.AutoBuyCandy and (now - lastAutoBuyCandy >= 5) then
        lastAutoBuyCandy = now
        pcall(function()
            local candy = GetPlayerCandy()
            local item = CandyShopItems[State.SelectedCandyItem]
            if item and candy >= item.Price then
                BuyCandyShopItem(State.SelectedCandyItem)
            end
        end)
    end
end)

-- Unload handler
local function Teardown()
    if heartbeatConn then
        heartbeatConn:Disconnect()
        heartbeatConn = nil
    end
    for _, m in pairs(LookCache.Pets) do pcall(function() m:Destroy() end) end
    for _, m in pairs(LookCache.Cages) do pcall(function() m:Destroy() end) end
    table.clear(LookCache.Pets)
    table.clear(LookCache.Cages)
    pcall(function() Library:Unload() end)
    print("[Honymoon Hub] Steal A Pet Inspector unloaded cleanly.")
end

getgenv().StealAPetUnload = Teardown
Library:OnUnload(Teardown)

