local function RenderPetsList()
    local filtered, _ = CollectPets()

    local seen = {}
    for i, pet in ipairs(filtered) do
        local cardName = "PetCard_" .. pet.Id
        seen[cardName] = true
        local card = PetScroll:FindFirstChild(cardName)

        local rarityColor = RarityColors[pet.Rarity] or Color3.fromRGB(196, 202, 214)
        local qualityColor = QualityColors[pet.Quality] or Color3.fromRGB(175, 185, 200)

        if not card then
            card = Instance.new("Frame")
            card.Name = cardName
            card.Size = UDim2.new(1, -6, 0, 72)
            card.BackgroundColor3 = Color3.fromRGB(18, 20, 28)
            card.BorderSizePixel = 0
            card.LayoutOrder = i

            local corner = Instance.new("UICorner", card)
            corner.CornerRadius = UDim.new(0, 8)

            local stroke = Instance.new("UIStroke", card)
            stroke.Color = rarityColor
            stroke.Thickness = 1.2
            stroke.Transparency = 0.5
            stroke.Name = "CardStroke"

            -- 3D Viewport Preview
            local vpf = Instance.new("ViewportFrame", card)
            vpf.Name = "Preview"
            vpf.Size = UDim2.new(0, 62, 0, 62)
            vpf.Position = UDim2.new(0, 5, 0.5, -31)
            vpf.BackgroundColor3 = Color3.fromRGB(12, 14, 20)
            vpf.BorderSizePixel = 0
            local vpfCorner = Instance.new("UICorner", vpf)
            vpfCorner.CornerRadius = UDim.new(0, 6)

            -- Pet Name
            local nameLbl = Instance.new("TextLabel", card)
            nameLbl.Name = "PetName"
            nameLbl.Size = UDim2.new(1, -145, 0, 18)
            nameLbl.Position = UDim2.new(0, 74, 0, 6)
            nameLbl.BackgroundTransparency = 1
            nameLbl.Font = Enum.Font.GothamBold
            nameLbl.TextSize = 13
            nameLbl.TextColor3 = qualityColor
            nameLbl.TextXAlignment = Enum.TextXAlignment.Left
            nameLbl.TextTruncate = Enum.TextTruncate.AtEnd
            nameLbl.Text = (pet.Quality ~= "Normal" and (pet.Quality .. " ") or "") .. pet.Kind

            -- Income Label
            local incomeLbl = Instance.new("TextLabel", card)
            incomeLbl.Name = "IncomeLbl"
            incomeLbl.Size = UDim2.new(1, -145, 0, 16)
            incomeLbl.Position = UDim2.new(0, 74, 0, 26)
            incomeLbl.BackgroundTransparency = 1
            incomeLbl.Font = Enum.Font.Code
            incomeLbl.TextSize = 12
            incomeLbl.TextColor3 = Color3.fromRGB(120, 255, 120)
            incomeLbl.TextXAlignment = Enum.TextXAlignment.Left
            incomeLbl.Text = string.format("💰 Cash: $%s /s", FormatNumber(pet.Income))

            -- Location & Rarity Badge
            local badgeLbl = Instance.new("TextLabel", card)
            badgeLbl.Name = "BadgeLbl"
            badgeLbl.Size = UDim2.new(1, -145, 0, 16)
            badgeLbl.Position = UDim2.new(0, 74, 0, 46)
            badgeLbl.BackgroundTransparency = 1
            badgeLbl.Font = Enum.Font.Gotham
            badgeLbl.TextSize = 11
            badgeLbl.TextColor3 = Color3.fromRGB(160, 170, 185)
            badgeLbl.TextXAlignment = Enum.TextXAlignment.Left
            local locText = pet.InStall and string.format("📍 Stall #%s", tostring(pet.Stall)) or "🎒 Backpack"
            badgeLbl.Text = string.format("%s  •  %s", pet.Rarity, locText)

            -- Store / Unequip Button on Card
            local storeBtn = Instance.new("TextButton", card)
            storeBtn.Name = "StoreBtn"
            storeBtn.Size = UDim2.new(0, 58, 0, 30)
            storeBtn.Position = UDim2.new(1, -64, 0.5, -15)
            storeBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
            storeBtn.BorderSizePixel = 0
            storeBtn.Font = Enum.Font.GothamBold
            storeBtn.TextSize = 11
            storeBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
            storeBtn.Text = "STORE"
            storeBtn.Visible = pet.InStall
            local btnCorner = Instance.new("UICorner", storeBtn)
            btnCorner.CornerRadius = UDim.new(0, 6)

            storeBtn.Activated:Connect(function()
                if pet.Stall and StorePetRemote then
                    storeBtn.Text = "..."
                    StorePetRemote:FireServer(pet.Stall)
                    Library:Notify("Store Pet", string.format("Stored %s from Stall #%d", pet.Kind, pet.Stall), 2, "Success")
                    State.NeedsPetRefresh = true
                    State.NeedsBagRefresh = true
                end
            end)

            card.Parent = PetScroll
        else
            card.LayoutOrder = i
            local stroke = card:FindFirstChild("CardStroke")
            if stroke then stroke.Color = rarityColor end
            local nameLbl = card:FindFirstChild("PetName")
            if nameLbl then
                nameLbl.TextColor3 = qualityColor
                nameLbl.Text = (pet.Quality ~= "Normal" and (pet.Quality .. " ") or "") .. pet.Kind
            end
            local incomeLbl = card:FindFirstChild("IncomeLbl")
            if incomeLbl then
                incomeLbl.Text = string.format("💰 Cash: $%s /s", FormatNumber(pet.Income))
            end
            local badgeLbl = card:FindFirstChild("BadgeLbl")
            if badgeLbl then
                local locText = pet.InStall and string.format("📍 Stall #%s", tostring(pet.Stall)) or "🎒 Backpack"
                badgeLbl.Text = string.format("%s  •  %s", pet.Rarity, locText)
            end
            local storeBtn = card:FindFirstChild("StoreBtn")
            if storeBtn then
                storeBtn.Visible = pet.InStall
                storeBtn.Text = "STORE"
            end
        end

        -- Populate ViewportFrame with Cached 3D Model
        local vpf = card:FindFirstChild("Preview")
        if vpf then
            local cacheKey = pet.Kind .. "_" .. pet.Quality
            PopulateViewport(vpf, "Pets", cacheKey, pet.Kind)
        end
    end

    -- Remove unused cards
    for _, ch in ipairs(PetScroll:GetChildren()) do
        if ch:IsA("Frame") and ch.Name:find("PetCard_") and not seen[ch.Name] then
            ch:Destroy()
        end
    end
end

