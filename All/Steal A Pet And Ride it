local function SimwalkTo(destination, stopDist)
    stopDist = stopDist or 5
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChild("Humanoid")
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not (char and hum and hrp) then return false, {} end
    if hum.Health <= 0 then return false, {} end

    local path = PathfindingService:CreatePath({
        AgentRadius = 2.5,
        AgentHeight = 5,
        AgentCanJump = true,
        AgentCanClimb = true,
        WaypointSpacing = 6,
    })

    local ok, _ = pcall(function()
        path:ComputeAsync(hrp.Position, destination)
    end)

    if not ok or path.Status ~= Enum.PathStatus.Success then
        -- Fallback direct MoveTo
        hum:MoveTo(destination)
        local t0 = os.clock()
        while State.IsStealingActive and (hrp.Position - destination).Magnitude > stopDist and (os.clock() - t0) < 3 do
            task.wait(0.05)
        end
        return (hrp.Position - destination).Magnitude <= (stopDist + 4), {}
    end

    local waypoints = path:GetWaypoints()
    for _, wp in ipairs(waypoints) do
        if not State.IsStealingActive then break end
        if (hrp.Position - destination).Magnitude <= stopDist then break end
        if wp.Action == Enum.PathWaypointAction.Jump then
            hum.Jump = true
        end
        hum:MoveTo(wp.Position)
        local t0 = os.clock()
        while State.IsStealingActive and (hrp.Position - wp.Position).Magnitude > 5 and (os.clock() - t0) < 1.0 do
            if (hrp.Position - destination).Magnitude <= stopDist then break end
            task.wait(0.015)
        end
    end

    -- Final approach directly to target
    local t0 = os.clock()
    while State.IsStealingActive and (hrp.Position - destination).Magnitude > stopDist and (os.clock() - t0) < 1.0 do
        hum:MoveTo(destination)
        task.wait(0.03)
    end

    local finalDist = (hrp.Position - destination).Magnitude
    return finalDist <= (stopDist + 3), waypoints
end

local function WalkToCage(targetPos)
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChild("Humanoid")
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not (char and hum and hrp) then return false end

    local isWorld2 = (hrp.Position.X > 2000)
    local checkpoints = isWorld2 and World2Checkpoints or World1Checkpoints

    -- Step forward through checkpoints if target is far away (> 400 studs)
    for i = #checkpoints, 1, -1 do
        if not State.IsStealingActive then break end
        local cp = checkpoints[i]
        if cp.Z < (hrp.Position.Z - 30) and cp.Z > (targetPos.Z + 40) then
            hum:MoveTo(cp)
            local t0 = os.clock()
            while State.IsStealingActive and (hrp.Position - cp).Magnitude > 18 and (os.clock() - t0) < 4 do
                hum:MoveTo(cp)
                task.wait(0.03)
            end
        end
    end

    -- For final approach, use PathfindingService to get directly to the cage
    local arrived, _ = SimwalkTo(targetPos, 4.5)
    return arrived
end

local function SprintBackToBase()
    local char = LocalPlayer.Character
    local hum = char and char:FindFirstChild("Humanoid")
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not (char and hum and hrp) then return false end

    local myPlot = GetPlayerPlot()
    local barn = myPlot and myPlot:FindFirstChild("Barn")
    local barnPos = barn and barn:GetPivot().Position or (myPlot and myPlot:GetPivot().Position) or Vector3.new(5904, 5, 133)

    local isWorld2 = (hrp.Position.X > 2000)
    local checkpoints = isWorld2 and World2Checkpoints or World1Checkpoints

    -- 1. INSTANT 1ST FRAME MOVE: rotate and run towards base immediately!
    hum:MoveTo(barnPos)

    -- 2. Traverse through checkpoints on the way back to base
    for _, cp in ipairs(checkpoints) do
        if not State.IsStealingActive then break end
        if cp.Z > (hrp.Position.Z + 20) and cp.Z < (barnPos.Z - 10) then
            hum:MoveTo(cp)
            local t0 = os.clock()
            while State.IsStealingActive and (hrp.Position - cp).Magnitude > 18 and (os.clock() - t0) < 4 do
                hum:MoveTo(cp)
                task.wait(0.03)
            end
        end
    end

    -- 3. Final sprint directly to the barn / plot
    hum:MoveTo(barnPos)
    local tEnd = os.clock()
    while State.IsStealingActive and (hrp.Position - barnPos).Magnitude > 8 and (os.clock() - tEnd) < 3 do
        hum:MoveTo(barnPos)
        task.wait(0.04)
    end

    return (hrp.Position - barnPos).Magnitude <= 15
end

local function ParseWorldPrompt(p)
    if not p or not p.Parent then return nil end
    local parent = p.Parent
    local model = parent:IsA("Model") and parent or parent.Parent
    if not (model and model:IsA("Model")) then return nil end

    local kind = model:GetAttribute("Kind") or model.Name:gsub("Cage$", ""):gsub("Cage%+$", "+")
    if p.ObjectText and p.ObjectText ~= "" then
        local fromObj = p.ObjectText:gsub("%s*Cage%s*$", "")
        if fromObj ~= "" then kind = fromObj end
    end

    local pathNum = model:GetAttribute("Path")
    if not pathNum and model.Parent then
        local pName = model.Parent.Name
        if pName == "Cages" and model.Parent.Parent then
            pName = model.Parent.Parent.Name
        end
        pathNum = tonumber(pName:match("%d+"))
    end

    local root = model:FindFirstChild("Root") or model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart")
    if not root then return nil end

    return {
        Prompt = p,
        Model = model,
        Root = root,
        Kind = kind,
        Path = pathNum or 1,
        Position = root.Position,
        HoldDuration = p.HoldDuration or 1,
    }
end

local function GetAvailableWorldCages()
    local list = {}
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return list end

    local myWorld = (hrp.Position.X > 2000) and 2 or 1
    local prompts = CollectionService:GetTagged("StealPrompt")

    for _, p in ipairs(prompts) do
        if p.Enabled and p.Parent then
            local data = ParseWorldPrompt(p)
            if data and data.Root and data.Root.Parent then
                local cageWorld = (data.Position.X > 2000) and 2 or 1
                if cageWorld == myWorld then
                    data.Distance = (hrp.Position - data.Position).Magnitude
                    table.insert(list, data)
                end
            end
        end
    end

    return list
end

local function StopStealWalking()
    State.IsStealingActive = false
    State.IsStealingCycleRunning = false
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
        LocalPlayer.Character.Humanoid:MoveTo(LocalPlayer.Character.HumanoidRootPart.Position)
    end
    if LblStealStatus then
        LblStealStatus:SetText("Status: Stopped (Idle)")
    end
    if LblStealTargetInfo then
        LblStealTargetInfo:SetText("Target: None")
    end
    Library:Notify("Auto Steal", "Walking stopped.", 2, "Info")
end

local function RunStealCycle(specificTarget, isManual)
    if State.IsStealingCycleRunning then return end
    State.IsStealingCycleRunning = true
    State.IsStealingActive = true

    task.spawn(function()
        local target = specificTarget

        if not target then
            local cages = GetAvailableWorldCages()
            local filtered = {}
            local minPathNum = tonumber(State.StealMinPath:match("%d+")) or 1

            for _, cage in ipairs(cages) do
                local matchRarity = (State.StealTargetRarity == "All" or State.StealTargetRarity == "Any") or (cage.Kind == State.StealTargetRarity)
                local matchPath = cage.Path >= minPathNum
                if matchRarity and matchPath then
                    table.insert(filtered, cage)
                end
            end

            if #filtered == 0 then
                if LblStealStatus then
                    LblStealStatus:SetText("Status: No matching cages found. Retrying...")
                end
                task.wait(2)
                State.IsStealingCycleRunning = false
                return
            end

            -- Sort by strategy
            if State.StealStrategy == "Highest Tier First" then
                table.sort(filtered, function(a, b)
                    if a.Path ~= b.Path then
                        return a.Path > b.Path
                    end
                    return a.Distance < b.Distance
                end)
            else
                table.sort(filtered, function(a, b)
                    return a.Distance < b.Distance
                end)
            end

            target = filtered[1]
        end

        if not target or not target.Prompt or not target.Root or not target.Root.Parent then
            if LblStealStatus then
                LblStealStatus:SetText("Status: Target no longer valid.")
            end
            task.wait(1)
            State.IsStealingCycleRunning = false
            return
        end

        if LblStealTargetInfo then
            LblStealTargetInfo:SetText(string.format("Target: %s (Path %d • %.0f studs)", target.Kind, target.Path, target.Distance or 0))
        end

        -- Step 1: Walk to cage (Ban-Free, Strictly No Teleport)
        if LblStealStatus then
            LblStealStatus:SetText(string.format("Status: 🏃 Walking to %s (Path %d)...", target.Kind, target.Path))
        end
        local arrived = WalkToCage(target.Position)
        if not arrived or not State.IsStealingActive then
            if LblStealStatus then
                LblStealStatus:SetText("Status: Walk interrupted or unreachable.")
            end
            State.IsStealingCycleRunning = false
            return
        end

        -- Step 2: Instant Steal & Immediate Turnaround (ห้ามค้าง รีบเดินกลับทันที!)
        if LblStealStatus then
            LblStealStatus:SetText(string.format("Status: 🤏 Stealing %s...", target.Kind))
        end

        local myPlot = GetPlayerPlot()
        local barn = myPlot and myPlot:FindFirstChild("Barn")
        local barnPos = barn and barn:GetPivot().Position or (myPlot and myPlot:GetPivot().Position) or Vector3.new(5904, 5, 133)

        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChild("Humanoid")
        local hrp = char and char:FindFirstChild("HumanoidRootPart")

        local grabbed = false
        local grabConn1, grabConn2

        local function OnGrabbed()
            if grabbed then return end
            grabbed = true
            if hum then
                -- INSTANT 1ST FRAME MOVE: rotate 180 and bolt towards base immediately!
                hum:MoveTo(barnPos)
            end
        end

        if char then
            grabConn1 = char.ChildAdded:Connect(function(child)
                if child.Name == "Held" or child:IsA("Model") or child:IsA("Tool") then
                    OnGrabbed()
                end
            end)
        end
        if LocalPlayer:FindFirstChild("Backpack") then
            grabConn2 = LocalPlayer.Backpack.ChildAdded:Connect(function()
                OnGrabbed()
            end)
        end

        -- Trigger proximity prompt
        if fireproximityprompt and target.Prompt and target.Prompt.Parent then
            fireproximityprompt(target.Prompt, target.HoldDuration or 1)
        end

        -- Wait ONLY until grab is detected, or cage is removed, or max hold duration
        local tStart = os.clock()
        local maxWait = (target.HoldDuration or 1) + 0.12
        while not grabbed and (os.clock() - tStart) < maxWait do
            if not target.Prompt or not target.Prompt.Parent or not target.Model.Parent then
                OnGrabbed()
                break
            end
            task.wait(0.015)
        end

        if grabConn1 then grabConn1:Disconnect() end
        if grabConn2 then grabConn2:Disconnect() end

        -- Step 3: INSTANT SPRINT BACK TO BASE (Zero hesitation, zero lag!)
        if LblStealStatus then
            LblStealStatus:SetText("Status: 🏃 Sprinting back to Base (Zero Delay)!")
        end

        local returned = SprintBackToBase()

        if returned then
            if LblStealStatus then
                LblStealStatus:SetText("Status: 🏡 Returned home safely!")
            end
            if State.StealAutoPlace then
                if LblStealStatus then
                    LblStealStatus:SetText("Status: 🥚 Placing newly stolen cages...")
                end
                task.wait(0.15)
                pcall(AutoPlaceAllCages)
            end
        else
            if LblStealStatus then
                LblStealStatus:SetText("Status: Return path interrupted.")
            end
        end

        task.wait(0.4)
        if not State.AutoStealCages then
            if LblStealStatus then
                LblStealStatus:SetText("Status: Idle")
            end
        end
        State.IsStealingCycleRunning = false
    end)
end

