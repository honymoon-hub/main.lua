local function ProcessAutoStorePets()
    if not State.AutoStorePets or not StorePetRemote then return end

    local emptyStalls, petStalls = GetStallStates()
    if #petStalls == 0 then return end

    if State.AutoStorePetsMode == "All Pets in Stalls" then
        for _, entry in ipairs(petStalls) do
            StorePetRemote:FireServer(entry.Index)
        end
        State.NeedsPetRefresh = true
        State.NeedsBagRefresh = true
    elseif State.AutoStorePetsMode == "When Cages Need Room" then
        local bagCages = CollectBagCages()
        local needed = #bagCages - #emptyStalls
        if needed > 0 then
            for i = 1, math.min(needed, #petStalls) do
                StorePetRemote:FireServer(petStalls[i].Index)
            end
            State.NeedsPetRefresh = true
            State.NeedsBagRefresh = true
        end
    elseif State.AutoStorePetsMode == "Lowest Income First (Keep Top 5)" then
        local totalInStalls = #petStalls
        local toRemove = math.max(0, totalInStalls - 5)
        if toRemove > 0 then
            for i = 1, toRemove do
                StorePetRemote:FireServer(petStalls[i].Index)
            end
            State.NeedsPetRefresh = true
            State.NeedsBagRefresh = true
        end
    end
end

