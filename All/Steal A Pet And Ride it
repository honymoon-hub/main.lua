local Suffixes = {"", "K", "M", "B", "T", "Qa", "Qi", "Sx", "Sp", "Oc", "No", "Dc"}
local function FormatNumber(n)
    if not n or n ~= n or n <= 0 then return "0" end
    local exp = math.floor(math.log(n, 10))
    local idx = math.floor(exp / 3)
    if idx <= 0 then return string.format("%.0f", n) end
    if idx > #Suffixes - 1 then idx = #Suffixes - 1 end
    local div = 10 ^ (idx * 3)
    return string.format("%.2f %s", n / div, Suffixes[idx + 1])
end

local function FormatTime(secs)
    if secs <= 0 then return "00:00" end
    local h = math.floor(secs / 3600)
    local m = math.floor((secs % 3600) / 60)
    local s = math.floor(secs % 60)
    if h > 0 then
        return string.format("%02d:%02d:%02d", h, m, s)
    else
        return string.format("%02d:%02d", m, s)
    end
end

