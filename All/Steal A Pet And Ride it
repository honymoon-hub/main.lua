local function UpdateOverviewStats()
    local _, allPets = CollectPets()
    local totalIncome = 0
    local topEarner = nil
    local inStalls = 0

    for _, pet in ipairs(allPets) do
        totalIncome = totalIncome + pet.Income
        if not topEarner or pet.Income > topEarner.Income then
            topEarner = pet
        end
        if pet.InStall then
            inStalls = inStalls + 1
        end
    end

    LblTotalIncome:SetText(string.format("Total Income: %s /s", FormatNumber(totalIncome)))
    if topEarner then
        LblTopEarner:SetText(string.format("Top: %s (%s/s)", topEarner.Kind, FormatNumber(topEarner.Income)))
    else
        LblTopEarner:SetText("Top Earner: None")
    end
    LblStallOccupancy:SetText(string.format("Stalls: %d in stalls", inStalls))
    LblTotalPets:SetText(string.format("Total Pets: %d", #allPets))

    local _, allCages = CollectCages()
    local readyCount = 0
    local hatchingCount = 0
    local backpackCount = 0
    for _, cage in ipairs(allCages) do
        if cage.IsReady then
            readyCount = readyCount + 1
        elseif cage.IsIncubating then
            hatchingCount = hatchingCount + 1
        else
            backpackCount = backpackCount + 1
        end
    end
    LblCagesProgress:SetText(string.format("Cages Hatching: %d", hatchingCount))
    LblCagesReady:SetText(string.format("Ready to Hatch: %d (Backpack: %d)", readyCount, backpackCount))

    -- Update Bag Cages tab stats
    local emptyStalls, petStalls = GetStallStates()
    local bagCages = CollectBagCages()
    if LblBagCagesCount then
        LblBagCagesCount:SetText(string.format("Backpack Cages: %d", #bagCages))
    end
    if LblEmptyStallsCount then
        LblEmptyStallsCount:SetText(string.format("Empty Stalls: %d / 48", #emptyStalls))
    end
    if LblPetStallsCount then
        LblPetStallsCount:SetText(string.format("Pet Stalls (Replaceable): %d", #petStalls))
    end
end

