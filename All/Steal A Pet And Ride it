local function GetPlayerPlot()
    local plots = workspace:FindFirstChild("Hub") and workspace.Hub:FindFirstChild("Plots")
    if not plots then return nil end

    for _, pl in ipairs(plots:GetChildren()) do
        if pl:GetAttribute("OwnerUserId") == LocalPlayer.UserId then
            return pl
        end
    end

    for _, pl in ipairs(plots:GetChildren()) do
        if pl:GetAttribute("Owner") == LocalPlayer.Name then
            return pl
        end
    end

    local plotAttr = LocalPlayer:GetAttribute("Plot")
    if plotAttr then
        local pl = plots:FindFirstChild("Plot" .. tostring(plotAttr))
        if pl then return pl end
    end

    return nil
end

