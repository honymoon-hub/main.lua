local function CollectPets()
    local list = {}
    local myPetsFolder = LocalPlayer:FindFirstChild("Pets")
    if not myPetsFolder then return list, list end

    for _, petConfig in ipairs(myPetsFolder:GetChildren()) do
        local petId = petConfig.Name
        local kind = petConfig:GetAttribute("Kind") or "Unknown"
        local quality = petConfig:GetAttribute("Quality") or "Normal"
        local stall = petConfig:GetAttribute("Stall")

        local cfg = PetConfig.Pets[kind] or {}
        local baseIncome = cfg.Income or 0
        local rarity = cfg.Rarity or "Common"

        local qCfg = QualityConfig.Qualities[quality] or {}
        local qualityMult = qCfg.Income or 1
        local totalIncome = baseIncome * qualityMult

        table.insert(list, {
            Id = petId,
            Kind = kind,
            Quality = quality,
            Rarity = rarity,
            Stall = stall,
            Income = totalIncome,
            BaseIncome = baseIncome,
            QualityMult = qualityMult,
            InStall = stall ~= nil,
        })
    end

    -- Filter
    local filtered = {}
    local query = State.SearchText:lower()
    for _, pet in ipairs(list) do
        local matchSearch = (query == "") or (pet.Kind:lower():find(query, 1, true) ~= nil) or (pet.Quality:lower():find(query, 1, true) ~= nil)
        local matchRarity = (State.RarityFilter == "All") or (pet.Rarity == State.RarityFilter)
        local matchLoc = true
        if State.LocationFilter == "In Stall Only" then
            matchLoc = pet.InStall
        elseif State.LocationFilter == "Backpack Only" then
            matchLoc = not pet.InStall
        end

        if matchSearch and matchRarity and matchLoc then
            table.insert(filtered, pet)
        end
    end

    -- Sort
    table.sort(filtered, function(a, b)
        if State.SortOrder == "Income (High -> Low)" then
            return a.Income > b.Income
        elseif State.SortOrder == "Income (Low -> High)" then
            return a.Income < b.Income
        elseif State.SortOrder == "Rarity" then
            return a.Rarity < b.Rarity
        elseif State.SortOrder == "Quality" then
            return a.Quality < b.Quality
        end
        return a.Income > b.Income
    end)

    return filtered, list
end

local function CollectCages()
    local list = {}
    local myPlot = GetPlayerPlot()
    local plotCages = myPlot and myPlot:FindFirstChild("Cages")

    local myCagesFolder = LocalPlayer:FindFirstChild("Cages")
    if not myCagesFolder then return list, list end

    local now = workspace:GetServerTimeNow()

    for _, cageFolder in ipairs(myCagesFolder:GetChildren()) do
        local cageId = cageFolder.Name
        local kind = cageFolder:GetAttribute("Kind") or "Cage"
        local stall = cageFolder:GetAttribute("Stall")
        local path = cageFolder:GetAttribute("Path")
        local readyAt = cageFolder:GetAttribute("ReadyAt")

        local duration = CageConfig.GetOpenSeconds and CageConfig.GetOpenSeconds(kind, path) or (CageConfig.Cages[kind] and CageConfig.Cages[kind].OpenSeconds or 60)
        local remaining = 0
        local elapsed = 0
        local progress = 0
        local isReady = false
        local isIncubating = false
        local isBackpack = false

        if stall ~= nil and readyAt ~= nil then
            remaining = math.max(0, readyAt - now)
            if remaining <= 0 then
                isReady = true
                progress = 1
            else
                isIncubating = true
                elapsed = math.max(0, duration - remaining)
                progress = math.clamp(elapsed / duration, 0, 1)
            end
        else
            isBackpack = true
            progress = 0
        end

        local liveCage = plotCages and plotCages:FindFirstChild(cageId)

        table.insert(list, {
            Id = cageId,
            Kind = kind,
            Stall = stall,
            Path = path,
            ReadyAt = readyAt,
            Remaining = remaining,
            Progress = progress,
            IsReady = isReady,
            IsIncubating = isIncubating,
            IsBackpack = isBackpack,
            Duration = duration,
            LiveCage = liveCage,
        })
    end

    -- Filter
    local filtered = {}
    for _, cage in ipairs(list) do
        local matchStatus = true
        if State.CageStatusFilter == "Ready to Hatch Only" then
            matchStatus = cage.IsReady
        elseif State.CageStatusFilter == "Hatching Only" then
            matchStatus = cage.IsIncubating
        elseif State.CageStatusFilter == "Backpack Only" then
            matchStatus = cage.IsBackpack
        end

        if matchStatus then
            table.insert(filtered, cage)
        end
    end

    table.sort(filtered, function(a, b)
        local scoreA = a.IsReady and 3 or (a.IsIncubating and 2 or 1)
        local scoreB = b.IsReady and 3 or (b.IsIncubating and 2 or 1)
        if scoreA ~= scoreB then
            return scoreA > scoreB
        end
        if a.IsIncubating and b.IsIncubating then
            return a.Remaining < b.Remaining
        end
        return a.Kind < b.Kind
    end)

    return filtered, list
end

