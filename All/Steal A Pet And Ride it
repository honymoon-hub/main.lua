-- ============================================================================
-- Auto Fuse Engine (Same Pet + Quality, 3 Pets Fuse, Normal -> Immaculate)
-- ============================================================================
local FuseLadder = { "Normal", "Good", "Great", "Mint", "Perfect" }
local FuseLadderIndex = { Normal = 1, Good = 2, Great = 3, Mint = 4, Perfect = 5, Immaculate = 6 }
local LblFuseStatus = nil

local function RunAutoFuse(notifyUser)
    if State.IsAutoFusing then
        if notifyUser then
            Library:Notify("Auto Fuse", "Fuse is already running!", 2, "Warn")
        end
        return
    end

    local fm = workspace:FindFirstChild("World2") and workspace.World2:FindFirstChild("Shops") and workspace.World2.Shops:FindFirstChild("FuseMachine")
    if not fm then
        if notifyUser then
            Library:Notify("Auto Fuse", "Fuse Machine not found in World2!", 3, "Error")
        end
        return
    end

    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local petsFolder = LocalPlayer:FindFirstChild("Pets")
    if not hrp or not petsFolder then return end

    local maxTargetIdx = FuseLadderIndex[State.AutoFuseMaxQuality or "Immaculate"] or 6

    local function findNextTriple()
        for _, quality in ipairs(FuseLadder) do
            local qIdx = FuseLadderIndex[quality] or 1
            if qIdx < maxTargetIdx then
                local groups = {}
                for _, p in ipairs(petsFolder:GetChildren()) do
                    local stall = p:GetAttribute("Stall")
                    local locked = p:GetAttribute("Locked")
                    local fav = p:GetAttribute("Favorite")
                    local q = p:GetAttribute("Quality") or "Normal"
                    local kind = p:GetAttribute("Kind")
                    
                    if stall == nil and not locked and not fav and q == quality and kind then
                        groups[kind] = groups[kind] or {}
                        table.insert(groups[kind], p.Name)
                    end
                end
                for kind, list in pairs(groups) do
                    if #list >= 3 then
                        return kind, quality, { list[1], list[2], list[3] }
                    end
                end
            end
        end
        return nil
    end

    local testKind, testQ, testTriple = findNextTriple()
    if not testKind then
        if notifyUser then
            Library:Notify("Auto Fuse", "No pets available to fuse (Need 3 same pet & quality).", 2, "Info")
        end
        return
    end

    State.IsAutoFusing = true
    task.spawn(function()
        local origCF = hrp.CFrame
        local totalFused = 0

        if LblFuseStatus then LblFuseStatus:SetText("Status: 🚀 Teleporting to Fuse Machine...") end
        char:PivotTo(fm:GetPivot() + Vector3.new(0, 4, 0))
        task.wait(0.3)

        while true do
            if not State.IsAutoFusing then break end
            local kind, quality, triple = findNextTriple()
            if not kind then break end

            if LblFuseStatus then
                LblFuseStatus:SetText(string.format("Status: ⚡ Fusing 3x %s (%s)...", kind, quality))
            end

            if FusePetsRemote then
                FusePetsRemote:FireServer(triple[1], triple[2], triple[3])
                totalFused = totalFused + 1
                task.wait(0.35)
            else
                break
            end
        end

        if hrp and hrp.Parent and origCF then
            char:PivotTo(origCF)
        end

        State.IsAutoFusing = false
        State.NeedsPetRefresh = true

        if LblFuseStatus then
            LblFuseStatus:SetText(string.format("Status: ✅ Finished (Fused %d sets)", totalFused))
        end

        if totalFused > 0 then
            Library:Notify("Auto Fuse", string.format("Fused %d sets of pets successfully!", totalFused), 3, "Success")
        elseif notifyUser then
            Library:Notify("Auto Fuse", "No more pets could be fused.", 2, "Info")
        end
    end)
end

