local LookCache = {
    Pets = {},
    Cages = {},
}

local function FindModelForKind(category, kind)
    local plots = workspace:FindFirstChild("Hub") and workspace.Hub:FindFirstChild("Plots")
    if not plots then return nil end

    -- 1. Check player's own plot first
    local myPlot = GetPlayerPlot()
    if myPlot then
        local folder = myPlot:FindFirstChild(category)
        if folder then
            for _, item in ipairs(folder:GetChildren()) do
                if item:GetAttribute("Kind") == kind then
                    local look = item:FindFirstChild("Look")
                    if look then return look end
                end
            end
        end
    end

    -- 2. Check all plots in Hub
    for _, pl in ipairs(plots:GetChildren()) do
        local folder = pl:FindFirstChild(category)
        if folder then
            for _, item in ipairs(folder:GetChildren()) do
                if item:GetAttribute("Kind") == kind then
                    local look = item:FindFirstChild("Look")
                    if look then return look end
                end
            end
        end
    end

    -- 3. Check DroppedCages if looking for Cages
    if category == "Cages" and workspace:FindFirstChild("DroppedCages") then
        for _, c in ipairs(workspace.DroppedCages:GetChildren()) do
            if c:GetAttribute("Kind") == kind then
                local look = c:FindFirstChild("Look")
                if look then return look end
            end
        end
    end

    return nil
end

local function SanitizeModel(model)
    if not model then return nil end
    local clone = model:Clone()

    -- Re-center all parts so origin is (0, 0, 0)
    local cf, _ = clone:GetBoundingBox()
    local origin = cf.Position

    for _, desc in ipairs(clone:GetDescendants()) do
        if desc:IsA("LuaSourceContainer") or desc:IsA("Sound") or desc:IsA("ParticleEmitter") or desc:IsA("PointLight") or desc:IsA("Highlight") then
            pcall(function() desc:Destroy() end)
        elseif desc:IsA("BasePart") then
            desc.CFrame = CFrame.new(desc.CFrame.Position - origin) * desc.CFrame.Rotation
            desc.Anchored = true
            desc.CanCollide = false
            desc.CanTouch = false
            desc.CanQuery = false
        end
    end
    return clone
end

local function PopulateViewport(vpf, category, key, kind)
    if not vpf then return end
    if vpf:GetAttribute("LoadedKey") == key then
        return
    end

    local model = LookCache[category] and LookCache[category][key]
    if not model then
        local source = FindModelForKind(category, kind)
        if source then
            local clean = SanitizeModel(source)
            if clean then
                LookCache[category][key] = clean
                model = clean
            end
        end
    end

    if not model then return end

    for _, c in ipairs(vpf:GetChildren()) do
        if c:IsA("Camera") or c:IsA("Model") or c:IsA("BasePart") then
            c:Destroy()
        end
    end

    local display = model:Clone()
    display.Parent = vpf

    local _, size = display:GetBoundingBox()
    local maxDim = math.max(size.X, size.Y, size.Z)
    if maxDim < 0.1 then maxDim = 2 end

    local camera = Instance.new("Camera")
    camera.FieldOfView = 50
    local dist = maxDim * 1.35
    local camPos = Vector3.new(dist * 0.72, dist * 0.45, dist * 0.85)
    camera.CFrame = CFrame.lookAt(camPos, Vector3.new(0, 0, 0))
    camera.Parent = vpf
    vpf.CurrentCamera = camera

    vpf.Ambient = Color3.fromRGB(190, 190, 205)
    vpf.LightColor = Color3.fromRGB(255, 255, 255)
    vpf.LightDirection = Vector3.new(-1, -1.5, -1)
    vpf:SetAttribute("LoadedKey", key)
end

