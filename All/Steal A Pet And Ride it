local StallModelCache = {}

local function GetStallModel(stallIndex)
    if StallModelCache[stallIndex] and StallModelCache[stallIndex].Parent then
        return StallModelCache[stallIndex]
    end
    local myPlot = GetPlayerPlot()
    if not myPlot then return nil end

    local function scan(parent)
        if not parent then return nil end
        for _, stall in ipairs(parent:GetChildren()) do
            if stall:GetAttribute("Index") == stallIndex then
                return stall
            end
        end
        return nil
    end

    local model = scan(myPlot:FindFirstChild("Barn") and myPlot.Barn:FindFirstChild("Stalls"))
    if not model then
        model = scan(myPlot:FindFirstChild("Barn2") and myPlot.Barn2:FindFirstChild("Stalls"))
    end
    if model then
        StallModelCache[stallIndex] = model
    end
    return model
end

local function GetStallStates()
    local stallMap = {}
    local emptyStalls = {}
    local petStalls = {}
    local cageStalls = {}

    for i = 1, 48 do
        local model = GetStallModel(i)
        if model then
            stallMap[i] = {
                Index = i,
                Status = "Empty",
                Model = model,
                Pet = nil,
                Cage = nil,
            }
        end
    end

    local myPetsFolder = LocalPlayer:FindFirstChild("Pets")
    if myPetsFolder then
        for _, petConfig in ipairs(myPetsFolder:GetChildren()) do
            local st = petConfig:GetAttribute("Stall")
            if st and stallMap[st] then
                local kind = petConfig:GetAttribute("Kind") or "Unknown"
                local quality = petConfig:GetAttribute("Quality") or "Normal"
                local cfg = PetConfig.Pets[kind] or {}
                local base = cfg.Income or 0
                local qCfg = QualityConfig.Qualities[quality] or {}
                local mult = qCfg.Income or 1
                local income = base * mult

                stallMap[st].Status = "Pet"
                stallMap[st].Pet = {
                    Id = petConfig.Name,
                    Kind = kind,
                    Quality = quality,
                    Income = income,
                    Rarity = cfg.Rarity or "Common",
                }
            end
        end
    end

    local myCagesFolder = LocalPlayer:FindFirstChild("Cages")
    if myCagesFolder then
        for _, cageFolder in ipairs(myCagesFolder:GetChildren()) do
            local st = cageFolder:GetAttribute("Stall")
            if st and stallMap[st] then
                local kind = cageFolder:GetAttribute("Kind") or "Cage"
                local readyAt = cageFolder:GetAttribute("ReadyAt")
                local now = workspace:GetServerTimeNow()
                local isReady = (readyAt ~= nil and readyAt <= now)

                stallMap[st].Status = "Cage"
                stallMap[st].Cage = {
                    Id = cageFolder.Name,
                    Kind = kind,
                    ReadyAt = readyAt,
                    IsReady = isReady,
                }
            end
        end
    end

    for i = 1, 48 do
        local entry = stallMap[i]
        if entry then
            if entry.Status == "Empty" then
                table.insert(emptyStalls, entry)
            elseif entry.Status == "Pet" then
                table.insert(petStalls, entry)
            elseif entry.Status == "Cage" then
                table.insert(cageStalls, entry)
            end
        end
    end

    table.sort(petStalls, function(a, b)
        return a.Pet.Income < b.Pet.Income
    end)

    return emptyStalls, petStalls, cageStalls, stallMap
end

local function FormatCageOdds(oddsTable)
    if not oddsTable or type(oddsTable) ~= "table" then return "N/A" end
    local items = {}
    for rarity, percent in pairs(oddsTable) do
        table.insert(items, { Rarity = tostring(rarity), Percent = tonumber(percent) or 0 })
    end
    table.sort(items, function(a, b) return a.Percent > b.Percent end)
    local parts = {}
    for _, it in ipairs(items) do
        table.insert(parts, string.format("%s (%s%%)", it.Rarity, tostring(it.Percent)))
    end
    return table.concat(parts, " • ")
end

local function CollectBagCages()
    local list = {}
    local myCagesFolder = LocalPlayer:FindFirstChild("Cages")
    if not myCagesFolder then return list end

    for _, cageFolder in ipairs(myCagesFolder:GetChildren()) do
        local stall = cageFolder:GetAttribute("Stall")
        if stall == nil then
            local cageId = cageFolder.Name
            local kind = cageFolder:GetAttribute("Kind") or "Cage"
            local path = cageFolder:GetAttribute("Path")
            local duration = CageConfig.GetOpenSeconds and CageConfig.GetOpenSeconds(kind, path)
                or (CageConfig.Cages[kind] and CageConfig.Cages[kind].OpenSeconds or 60)
            local odds = CageConfig.Cages[kind] and CageConfig.Cages[kind].Odds or {}

            table.insert(list, {
                Id = cageId,
                Kind = kind,
                Path = path,
                Duration = duration,
                Odds = odds,
            })
        end
    end

    table.sort(list, function(a, b)
        local orderA = (CageConfig.Cages[a.Kind] and CageConfig.Cages[a.Kind].Order) or 0
        local orderB = (CageConfig.Cages[b.Kind] and CageConfig.Cages[b.Kind].Order) or 0
        if orderA ~= orderB then
            return orderA > orderB
        end
        return a.Kind < b.Kind
    end)

    return list
end

local function PlaceCageIntoStall(cageId, targetStallIndex, skipReturn)
    if not LocalPlayer.Character or not LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        return false, "Character not ready"
    end
    local humanoid = LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
    local hrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not humanoid or not hrp then return false, "Humanoid not found" end

    local emptyStalls, petStalls, _, stallMap = GetStallStates()
    local targetEntry = nil

    if targetStallIndex then
        targetEntry = stallMap[targetStallIndex]
        if not targetEntry then
            return false, string.format("Stall #%d not owned or invalid", targetStallIndex)
        end
        if targetEntry.Status == "Cage" then
            return false, string.format("Stall #%d already has an incubating cage", targetStallIndex)
        end
    else
        if State.BagPlaceStrategy == "Empty Stalls Only" then
            targetEntry = emptyStalls[1]
            if not targetEntry then
                return false, "No empty stalls available (Empty Only mode)"
            end
        elseif State.BagPlaceStrategy == "Replace Lowest Pet Only" then
            targetEntry = petStalls[1]
            if not targetEntry then
                return false, "No pet stalls available to replace"
            end
        else -- "Empty First, Then Lowest Pet"
            targetEntry = emptyStalls[1] or petStalls[1]
            if not targetEntry then
                return false, "No stalls available (all occupied by cages)"
            end
        end
    end

    local stallIdx = targetEntry.Index
    local stallModel = targetEntry.Model
    local cf = stallModel:IsA("BasePart") and stallModel.CFrame
        or (stallModel.PrimaryPart and stallModel.PrimaryPart.CFrame)
        or (stallModel:IsA("Model") and stallModel:GetPivot())
    if not cf then
        return false, "Stall position not found"
    end

    local tool = (LocalPlayer:FindFirstChildOfClass("Backpack") and LocalPlayer.Backpack:FindFirstChild(cageId))
        or LocalPlayer.Character:FindFirstChild(cageId)

    if not tool then
        return false, "Cage tool not found in backpack"
    end

    local originalCF = (not skipReturn) and hrp.CFrame or nil

    -- 1. Visit stall: Move directly in front of the stall (Server checks distance <= 12-18 studs)
    local targetCF = cf + Vector3.new(0, 3, 0)
    hrp.CFrame = targetCF
    task.wait(0.08)

    -- 2. Equip cage tool
    if tool.Parent ~= LocalPlayer.Character then
        humanoid:EquipTool(tool)
        task.wait(0.12)
    end

    -- 3. Trigger ProximityPrompt (KeyCode E) if present
    local penPromptAnchor = stallModel:FindFirstChild("PenPromptAnchor")
    if penPromptAnchor and typeof(fireproximityprompt) == "function" then
        for _, prompt in ipairs(penPromptAnchor:GetChildren()) do
            if prompt:IsA("ProximityPrompt") and prompt.KeyboardKeyCode == Enum.KeyCode.E then
                pcall(fireproximityprompt, prompt, 0)
            end
        end
    end

    -- 4. Fire remote as guaranteed server trigger
    if targetEntry.Status == "Empty" then
        if PlaceCageRemote then
            PlaceCageRemote:FireServer(cageId, stallIdx)
        end
    else
        if ReplaceWithCageRemote then
            ReplaceWithCageRemote:FireServer(cageId, stallIdx)
        end
    end

    -- 5. Short wait & verify placement
    local placed = false
    local cagesFolder = LocalPlayer:FindFirstChild("Cages")
    local cageObj = cagesFolder and cagesFolder:FindFirstChild(cageId)

    for _ = 1, 8 do
        task.wait(0.05)
        if cageObj and cageObj:GetAttribute("Stall") == stallIdx then
            placed = true
            break
        end
        if not (LocalPlayer.Backpack:FindFirstChild(cageId) or LocalPlayer.Character:FindFirstChild(cageId)) then
            placed = true
            break
        end
    end

    -- Return to starting position if this was a standalone single placement
    if originalCF and hrp and hrp.Parent then
        hrp.CFrame = originalCF
    end

    State.NeedsBagRefresh = true
    State.NeedsCageRefresh = true
    State.NeedsPetRefresh = true

    if placed then
        return true, string.format("Placed into Stall #%d (%s)", stallIdx, targetEntry.Status == "Empty" and "Empty" or "Replaced Pet")
    else
        return true, string.format("Sent Place to Stall #%d", stallIdx)
    end
end

local function AutoPlaceAllCages()
    if State.IsAutoPlacing then
        Library:Notify("Place Cages", "Auto-placement is already running!", 2, "Warn")
        return
    end

    local bagCages = CollectBagCages()
    if #bagCages == 0 then
        Library:Notify("Place Cages", "No cages in backpack to place.", 2, "Info")
        return
    end

    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local startCF = hrp and hrp.CFrame

    State.IsAutoPlacing = true
    task.spawn(function()
        local placedCount = 0

        for _, cage in ipairs(bagCages) do
            if not State.IsAutoPlacing then break end

            local emptyStalls, petStalls = GetStallStates()
            local hasAvailableStall = false
            if State.BagPlaceStrategy == "Empty Stalls Only" then
                hasAvailableStall = (#emptyStalls > 0)
            elseif State.BagPlaceStrategy == "Replace Lowest Pet Only" then
                hasAvailableStall = (#petStalls > 0)
            else
                hasAvailableStall = (#emptyStalls > 0 or #petStalls > 0)
            end

            if not hasAvailableStall then
                print("[Honymoon Hub] Placement finished: No more available stalls for strategy " .. tostring(State.BagPlaceStrategy))
                break
            end

            local ok, msg = PlaceCageIntoStall(cage.Id, nil, true)
            if ok then
                placedCount = placedCount + 1
                task.wait(0.08)
            else
                print("[Honymoon Hub] Placement finished:", msg)
                break
            end
        end

        -- After placing all cages, return player safely to original starting position
        if startCF and hrp and hrp.Parent then
            hrp.CFrame = startCF
        end

        State.IsAutoPlacing = false
        State.NeedsBagRefresh = true
        State.NeedsCageRefresh = true
        State.NeedsPetRefresh = true

        if placedCount > 0 then
            Library:Notify("Place Cages", string.format("Placed %d cage(s) successfully across stalls!", placedCount), 3, "Success")
        else
            Library:Notify("Place Cages", "Could not place cages (no valid stalls or strategy limit).", 3, "Warn")
        end
    end)
end

