local function TeleportTo(cf)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hrp and cf then
        hrp.CFrame = cf
        return true
    end
    return false
end

local function TeleportToIncubator()
    local myPlot = GetPlayerPlot()
    if not myPlot then return false, "No plot found" end

    local cages = myPlot:FindFirstChild("Cages")
    if cages and #cages:GetChildren() > 0 then
        -- Teleport to first cage
        local firstCage = cages:GetChildren()[1]
        local root = firstCage:FindFirstChild("Root") or firstCage.PrimaryPart or firstCage:FindFirstChildWhichIsA("BasePart")
        if root then
            TeleportTo(root.CFrame + Vector3.new(0, 3, 4))
            return true, "Teleported to your Cages!"
        end
    end

    -- Fallback to plot bounds
    local bounds = myPlot:FindFirstChild("Bounds") or myPlot:FindFirstChild("Barn")
    if bounds then
        local cf = bounds:IsA("Model") and bounds:GetBoundingBox() or bounds.CFrame
        TeleportTo(cf + Vector3.new(0, 3, 0))
        return true, "Teleported to your Plot!"
    end

    return false, "Could not locate Cages on plot"
end

