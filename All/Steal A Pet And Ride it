local function GetPlayerCandy()
    local candyAttr = LocalPlayer:GetAttribute("Candy")
    if candyAttr ~= nil then
        return tonumber(candyAttr) or 0
    end
    local ls = LocalPlayer:FindFirstChild("leaderstats")
    if ls and ls:FindFirstChild("Candy") then
        return tonumber(ls.Candy.Value) or 0
    end
    if LocalPlayer:FindFirstChild("Candy") then
        return tonumber(LocalPlayer.Candy.Value) or 0
    end
    return 0
end

local function CalculateCandyRate()
    local rateTable = {
        ["Singularity"] = 18,
        ["Omega"] = 16,
        ["Astral"] = 14,
        ["Infinity"] = 12,
        ["Divine"] = 11,
        ["Eternal"] = 10,
        ["Secret"] = 9,
        ["Cosmic"] = 8,
        ["Mythic"] = 7,
        ["Legendary"] = 5,
        ["Epic"] = 3,
        ["Rare"] = 2,
        ["Uncommon"] = 1.5,
        ["Common"] = 1,
    }
    local _, allPets = CollectPets()
    local totalRate = 0
    for _, pet in ipairs(allPets) do
        if pet.InStall then
            local r = rateTable[pet.Rarity] or 1
            totalRate = totalRate + r
        end
    end
    if LocalPlayer:GetAttribute("DoubleCandy") or LocalPlayer:GetAttribute("HasDoubleCandy") then
        totalRate = totalRate * 2
    end
    return totalRate
end

local function BuyCandyShopItem(itemName)
    if not BuyCandyRemote then
        return false, "BuyCandyItem remote not found"
    end
    local item = CandyShopItems[itemName]
    if not item then
        return false, "Item not found in catalog"
    end
    pcall(function()
        BuyCandyRemote:FireServer(item.Key)
    end)
    pcall(function()
        BuyCandyRemote:FireServer(item.Place)
    end)
    return true, string.format("Purchased %s!", item.Name)
end

