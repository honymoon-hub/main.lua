                    end
                end
            end
        end
        local choices=panel and panel:FindFirstChild("Frame")
        if not prompt or not choices or not visible(prompt) then
            lastButton=nil;lastSignature=nil;state.Status="Waiting";return
        end
        local text=prompt.ContentText
        local category
        for name in pairs(lookup) do if text:find(name,1,true) then category=name;break end end
        if not category and (text:find("ต้นไม้",1,true) or text:find("ดอกไม้",1,true)) then category="ต้นไม้"end
        if not category and (text:find("tree",1,true) or text:find("flower",1,true)) then category="ต้นไม้"end
        if not category and (text:find("สัตว์บินได้", 1, true) or text:find("บินได้", 1, true)) then category = "บินได้" end
        if not category and (text:find("thing", 1, true) or text:find("flies", 1, true)) then category = "บินได้" end
        if not category and (text:find("สัตว์น้ำ", 1, true) or text:find("สัตว์ทะเล", 1, true)) then category = "สัตว์น้ำ" end
        if not category and text:find("สัตว์", 1, true) then category = "สัตว์" end
        if not category and (text:find("ของกิน", 1, true) or text:find("food", 1, true)) then category = "อาหาร" end
        if not category and text:find("food", 1, true) then category = "food" end
        if not category and (text:find("water", 1, true) or text:find("animal", 1, true)) then category = "water" end
        if not category and text:find("ลูกบอล", 1, true) then category = "ลูกบอล" end
        if not category and text:find("เครื่องมือ", 1, true) then category = "เครื่องมือ" end
        if not category and text:find("ผลไม้", 1, true) then category = "ผลไม้" end
        if not category and (text:find("ของที่ใช้สวมใส่", 1, true) or text:find("สวมใส่", 1, true)) then category = "สวมใส่" end
        if not category and (text:find("ยาณพาหนะ", 1, true) or text:find("ยานพาหนh", 1, true)) then category = "ยานพาหนะ" end
        if not category and (text:find("vehicle", 1, true) or text:find("vheicle", 1, true)) then category = "vehicle" end
        if not category then state.Status="Unknown category";return end
        local matches={}
        local signature={text}
        for _,button in ipairs(choices:GetChildren()) do
            if button:IsA("TextButton") and visible(button) then
                local label=button:FindFirstChild("TextLabel")
                local emoji=label and label:IsA("TextLabel") and label.Text or button.Text
                table.insert(signature,emoji)
                if lookup[category][normalize(emoji)] then table.insert(matches,{Button=button,Emoji=emoji}) end
            end
        end
        if #matches~=1 then state.Status="No unique match";return end
        local match=matches[1]
        local key=table.concat(signature,"|")
        if lastButton==match.Button and lastSignature==key then return end
        lastButton=match.Button;lastSignature=key;busy=true
        state.Category=category;state.Emoji=match.Emoji
        state.Attempts=state.Attempts+1;state.Status="Submitted"
        local GuiService = game:GetService("GuiService")
        local VirtualInputManager = game:GetService("VirtualInputManager")
        local UserInputService = game:GetService("UserInputService")
        task.spawn(function()
            if self.Alive and workEnabled() and self.FarmCheckAuto==state and match.Button.Parent and visible(match.Button) then
                local btn = match.Button
                
                -- 1. VirtualInputManager คลิกพิกัดจริงของปุ่มบนหน้าจอ (เลียนแบบคลิกเมาส์จริง 100% โดยไม่ต้องขยับเมาส์มือ)
                pcall(function()
                    local pos = btn.AbsolutePosition
                    local size = btn.AbsoluteSize
                    local inset = GuiService:GetGuiInset()
                    local x = pos.X + (size.X / 2) + inset.X
                    local y = pos.Y + (size.Y / 2) + inset.Y
                    VirtualInputManager:SendMouseButtonEvent(x, y, 0, true, game, 1)
                    task.wait(0.05)
                    VirtualInputManager:SendMouseButtonEvent(x, y, 0, false, game, 1)
                end)

                -- 2. ยิง Event Signals ทุกแบบที่รองรับ
                local events = {"Activated", "MouseButton1Click", "MouseButton1Down", "MouseButton1Up"}
                for _, eventName in ipairs(events) do
                    if btn[eventName] then
                        if firesignal then
                            pcall(function() firesignal(btn[eventName]) end)
                        end
                        if getconnections then
                            for _, conn in ipairs(getconnections(btn[eventName])) do
                                if conn.Fire then
                                    pcall(function() conn:Fire() end)
                                elseif conn.Function then
                                    pcall(conn.Function)
                                end
                            end
                        end
                    end
                end
            end
            busy=false
        end)
    end)
    self.FarmCheckAutoConnection=connection
    table.insert(self.Connections,connection)
end
