    for i = 2, #raw - 1 do
        local a, b, c = raw[i - 1], raw[i], raw[i + 1]
        local incoming, outgoing = b - a, c - b
        if incoming.Magnitude > .1 and outgoing.Magnitude > .1 then
            local angle = math.acos(math.clamp(incoming.Unit:Dot(outgoing.Unit), -1, 1))
