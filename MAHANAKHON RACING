-- ==================== ระบบจูน 1 คัน (Solo Tune) ====================
local function StartTuneSolo()
    local env = getgenv()
    local previous = env.__MahanakhonTuneSolo
    if previous and previous.Busy then
        print({ Title = "ระบบจูน", Content = "กำลังทำการจูนอยู่แล้ว...", Duration = 3 })
        return
    end

    local RS = game:GetService("ReplicatedStorage")
    local Http = game:GetService("HttpService")
    local player = game:GetService("Players").LocalPlayer
    local GameShared = require(RS.GameShared)
    local EcuShared = require(RS.EcuShared)
    local Net = require(RS.NetSeal)
    local Remotes = RS.GameRemotes
    local RuntimeTune = {Alive = true, Busy = false, Tune = {Tests = 0, Cancel = false}, Cache = {}}
    local cachePath = "Mahanakhon X/MAHANAKHON RACING/TuneSolo_" .. player.UserId .. ".json"
    pcall(function() if isfile(cachePath) then RuntimeTune.Cache = Http:JSONDecode(readfile(cachePath)) end end)
    env.__MahanakhonTuneSolo = RuntimeTune

    local function copy(file)
        local out = {}
        for _, def in ipairs(EcuShared.TABLES) do out[def.key] = table.clone(file[def.key]) end
        return out
    end
    local function decode(value)
        local ok, result = pcall(function() return EcuShared.decode(value) end)
        return ok and result or nil
    end
    local function validFile(file)
        if type(file) ~= "table" then return false end
        for _, def in ipairs(EcuShared.TABLES) do
            if type(file[def.key]) ~= "table" or #file[def.key] ~= EcuShared.POINTS then return false end
            for _, value in ipairs(file[def.key]) do
                if type(value) ~= "number" or value ~= value or value < def.min - .0001 or value > def.max + .0001 then return false end
            end
        end
        return true
    end
    local function vehicleId(vehicle) return vehicle:GetAttribute("VehicleId") or vehicle.Name end
    local function signature(vehicle)
        local fields = {vehicleId(vehicle), tostring(player.UserId), tostring(game.PlaceVersion), tostring(vehicle:GetAttribute("EcuRecipeVer") or "current")}
        local attrs = vehicle:GetAttributes()
        local keys = {}
        for key in pairs(attrs) do if key == "EngineLevel" or key:find("Piston") or key:find("Bore") then table.insert(keys, key) end end
        table.sort(keys)
        for _, key in ipairs(keys) do table.insert(fields, key .. "=" .. tostring(attrs[key])) end
        return table.concat(fields, "|")
    end

    function RuntimeTune:CheckTune()
        assert(self.Alive and not self.Tune.Cancel)
        local v = self.Tune.Vehicle
        assert(v and v.Parent and v:GetAttribute("OwnerUserId") == player.UserId)
        assert(GameShared.inTuneBay(v))
    end
    function RuntimeTune:ReadTuneFile(v)
        local file = Net.invoke(Remotes.Ecu, "Get", v)
        if validFile(file) then return copy(file), true end
        assert(not v:GetAttribute("EcuBorrowed"))
        return EcuShared.stockFile(), false
    end
    function RuntimeTune:SaveTune(v, file, gain, feedback)
        self.Saved = copy(file)
        self.Cache[vehicleId(v)] = {schema = 3, signature = signature(v), file = copy(file), feedback = feedback, gain = gain}
        local ok, err = pcall(writefile, cachePath, Http:JSONEncode(self.Cache))
        if not ok then self.CacheError = tostring(err) end
    end
    function RuntimeTune:Flash(vehicle, file, allowStopped)
        if self.Tune.Transport == "GUI" then return self:FlashGuiTune(vehicle, file, allowStopped) end
        if not allowStopped then self:CheckTune() end
        assert(validFile(file))
        local prior = self.Tune.LastMeasurement
        if prior and prior.Vehicle == vehicle and prior.Signature == signature(vehicle) and prior.Stored == vehicle:GetAttribute("EcuFile") then
            local same = true
            for _, def in ipairs(EcuShared.TABLES) do
                for i = 1, EcuShared.POINTS do
                    if math.abs(prior.File[def.key][i] - file[def.key][i]) > 1e-8 then same = false; break end
                end
                if not same then break end
            end
            if same then
                self.Tune.LatestFeedback = table.clone(prior.Feedback)
                self.Tune.Hints = prior.Hints
                return prior.Gain, table.clone(prior.Feedback), prior.Hints
            end
        end
        local lastMessage
        for attempt = 1, 4 do
            local remaining = (self.Tune.LastSend or 0) + (EcuShared.SEND_COOLDOWN or 2) + .15 - os.clock()
            while remaining > 0 do
                if not allowStopped then self:CheckTune() end
                task.wait(math.min(.1, remaining))
                remaining = (self.Tune.LastSend or 0) + (EcuShared.SEND_COOLDOWN or 2) + .15 - os.clock()
            end
            if not allowStopped then self:CheckTune() end
            self.Tune.LastSend = os.clock()
            local ok, message, gain, feedback, hints = Net.invoke(Remotes.Ecu, "Send", vehicle, file, {k = EcuShared.sum(file)})
            if ok then
                assert(type(gain) == "number" and type(feedback) == "table")
                self.Tune.LatestFeedback = table.clone(feedback)
                self.Tune.FeedbackAt = os.clock()
                self.Tune.Tests = (self.Tune.Tests or 0) + 1
                self.Tune.Hints = type(hints) == "table" and hints or decode(vehicle:GetAttribute("EcuHints")) or {}
                self.Tune.LastMeasurement = {Vehicle = vehicle, Signature = signature(vehicle), Stored = vehicle:GetAttribute("EcuFile"), File = copy(file), Gain = gain, Feedback = table.clone(feedback), Hints = self.Tune.Hints}
                return gain, feedback, self.Tune.Hints
            end
            lastMessage = tostring(message)
            local text = lastMessage:lower()
            if not (text:find("still writing", 1, true) or text:find("slow down", 1, true) or text:find("cooldown", 1, true)) then
                self.LastFlashError = lastMessage
                error(nil, 0)
            end
        end
        self.LastFlashError = lastMessage
        error(nil, 0)
    end
    function RuntimeTune:TuneMapComplete(key, feedback, hints)
        if (feedback[key] or 0) < 1 then return false end
        for _, hint in ipairs(type(hints) == "table" and hints[key] or {}) do
            local value = type(hint) == "number" and hint or type(hint) == "table" and hint.m
            if type(value) == "number" and value < 1 then return false end
        end
        return true
    end
    function RuntimeTune:TuneComplete(feedback, hints)
        for _, def in ipairs(EcuShared.TABLES) do
            if not self:TuneMapComplete(def.key, feedback, hints) then return false end
        end
        return true
    end
    function RuntimeTune:OptimizeCoded(vehicle, best, gain, feedback, hints)
        best = best and copy(best) or self:ReadTuneFile(vehicle)
        if not gain then gain, feedback, hints = self:Flash(vehicle, best) end
        self.Tune.Best = copy(best); self.Tune.CodedCertified = {}; self.Tune.CodedBlocks = 0; self.Tune.BlockFeedback = {}
        if self:TuneComplete(feedback, hints) then return best, gain, feedback, hints end
        local residues = {[1] = true, [3] = true, [4] = true, [5] = true, [9] = true}
        local function h(row, col, size)
            if size == 12 then
                if row == 0 or col == 0 then return 1 end
                local x = (row - col) % 11
                return x ~= 0 and residues[x] and 1 or -1
            end
            local x = bit32.band(row, col)
            local parity = 0
            while x > 0 do parity = bit32.bxor(parity, bit32.band(x, 1)); x = bit32.rshift(x, 1) end
            return parity == 0 and 1 or -1
        end
        local states = {}; local history = {{file = copy(best), f = feedback, h = hints}}; local probeCache = {}
        local initialSignature = signature(vehicle)
        local function same(a, b)
            for _, d in ipairs(EcuShared.TABLES) do
                for i = 1, EcuShared.POINTS do
                    if math.abs(a[d.key][i] - b[d.key][i]) > 1e-8 then return false end
                end
            end
            return true
        end
        local function probe(file)
            assert(signature(vehicle) == initialSignature)
            local key = tostring(EcuShared.sum(file)); local bucket = probeCache[key]
            for _, cached in ipairs(bucket or {}) do if same(cached.file, file) then return cached.gain, cached.feedback, cached.hints end end
            local g, f, hs = self:Flash(vehicle, file)
            bucket = bucket or {}; probeCache[key] = bucket
            bucket[#bucket + 1] = {file = copy(file), gain = g, feedback = f, hints = hs}
            return g, f, hs
        end
        for _, d in ipairs(EcuShared.TABLES) do
            if not self:TuneMapComplete(d.key, feedback, hints) then
                local st = {d = d, observations = {}, candidates = {}}
                for i = 1, EcuShared.POINTS do
                    st.observations[i] = {}
                    local cs = {}
                    for tick = math.ceil(d.min / d.step - 1e-6), math.floor(d.max / d.step + 1e-6) do cs[#cs + 1] = tick * d.step end
                    st.candidates[i] = cs
                end
                states[d.key] = st
            end
        end
        local function snap(d, x) return math.clamp(math.round(x / d.step) * d.step, d.min, d.max) end
        local function q(d, x, t)
            local width = d.key == "Afr" and .95 or d.tol * .75
            return math.clamp(math.round((1 - math.abs(x - t) / width) * 100) / 100, 0, 1)
        end
        local function metric(key, index, f, hs)
            for b, r in ipairs(EcuShared.BANDS) do
                if index >= r[1] and index <= r[2] then
                    local z = type(hs[key]) == "table" and hs[key][b]
                    local m = type(z) == "number" and z or type(z) == "table" and z.m
                    if type(m) == "number" then return m, r[2] - r[1] + 1 end
                end
            end
            return f[key] or 0, EcuShared.POINTS
        end
        for block = 1, 4 do
            self.Tune.CodedBlocks = block; self.Tune.Status = "tuning"
            local probes = {}
            for key, st in pairs(states) do
                local d = st.d; probes[key] = {}
                for i = 1, EcuShared.POINTS do
                    local l, r
                    if block <= 2 then
                        local low, high = d.recipeMin or d.min, d.recipeMax or d.max
                        l = low + (high - low) * ((block - 1) + .5) / 4; r = low + (high - low) * ((block + 1) + .5) / 4
                    else
                        local cs = st.candidates[i]; local choices = {}; local totalWeight = 0
                        local function weight(t) return (not d.recipeMin or t >= d.recipeMin - .15 and t <= d.recipeMax + .15) and 1 or .02 end
                        for _, t in ipairs(cs) do totalWeight += weight(t) end
                        for j = 0, math.min(12, #cs - 1) do
                            local threshold = totalWeight * j / math.max(1, math.min(12, #cs - 1)); local accumulated = 0
                            for _, t in ipairs(cs) do accumulated += weight(t); if accumulated >= threshold then if choices[#choices] ~= t then choices[#choices + 1] = t end; break end end
                        end
                        local info
                        for a = 1, #choices do
                            for b = a + 1, #choices do
                                local repeated = false
                                for _, o in ipairs(st.observations[i]) do if math.abs(o.l - choices[a]) < 1e-6 and math.abs(o.r - choices[b]) < 1e-6 then repeated = true; break end end
                                local bins = {}; local total = 0
                                for _, t in ipairs(cs) do
                                    local w = (not d.recipeMin or t >= d.recipeMin - .15 and t <= d.recipeMax + .15) and 1 or .02
                                    local bin = math.round((q(d, choices[b], t) - q(d, choices[a], t)) / .015); bins[bin] = (bins[bin] or 0) + w; total += w
                                end
                                local sum = 0; for _, n in pairs(bins) do sum += n * n end
                                local score = total > 0 and total - sum / total or 0
                                if not repeated and (not info or score > info) then info = score; l = choices[a]; r = choices[b] end
                            end
                        end
                        if not l then l = cs[1] or best[key][i]; r = l end
                    end
                    probes[key][i] = {snap(d, l), snap(d, r)}
                end
            end
            local columns = {}; local maxColumn = 0
            for key, st in pairs(states) do
                columns[key] = {}; local counts = {}
                for i = 1, EcuShared.POINTS do
                    local group = 0
                    for b, bounds in ipairs(EcuShared.BANDS) do
                        if i >= bounds[1] and i <= bounds[2] then
                            local hint = type(hints[key]) == "table" and hints[key][b]
                            local m = type(hint) == "number" and hint or type(hint) == "table" and hint.m
                            if type(m) == "number" then group = b end
                            break
                        end
                    end
                    local p = probes[key][i]
                    if math.abs(p[1] - p[2]) < 1e-8 then columns[key][i] = 0
                    else counts[group] = (counts[group] or 0) + 1; columns[key][i] = counts[group]; maxColumn = math.max(maxColumn, counts[group]) end
                end
            end
            local rowCount = 2
            if maxColumn >= 8 and maxColumn <= 11 then rowCount = 12 else while rowCount <= maxColumn do rowCount *= 2 end end
            local readings = {}
            for row = 0, rowCount - 1 do
                self:CheckTune(); local file = copy(best)
                for key, st in pairs(states) do for i = 1, EcuShared.POINTS do file[key][i] = probes[key][i][columns[key][i] > 0 and h(row, columns[key][i], rowCount) == 1 and 2 or 1] end end
                local g, f, hs = probe(file); readings[row + 1] = {f = f, h = hs, file = file}; history[#history + 1] = readings[row + 1]
            end
            local candidate = copy(best); local mismatch = false
            for key, st in pairs(states) do
                local d = st.d
                for i = 1, EcuShared.POINTS do
                    local delta = 0; local count
                    for row = 0, rowCount - 1 do local m, n = metric(key, i, readings[row + 1].f, readings[row + 1].h); count = n; if columns[key][i] > 0 then delta += h(row, columns[key][i], rowCount) * m end end
                    delta *= 2 * count / rowCount
                    local p = probes[key][i]; st.observations[i][#st.observations[i] + 1] = {l = p[1], r = p[2], delta = delta, eps = 2 * count * .00101}
                    local cs = {}
                    for tick = math.ceil(d.min / d.step - 1e-6), math.floor(d.max / d.step + 1e-6) do
                        local t = tick * d.step; local valid = true
                        for _, o in ipairs(st.observations[i]) do if math.abs(q(d, o.r, t) - q(d, o.l, t) - o.delta) > o.eps + 1e-6 then valid = false; break end end
                        if valid then cs[#cs + 1] = t end
                    end
                    if #cs == 0 then mismatch = true; cs = st.candidates[i] end
                    st.candidates[i] = cs
                    local loss, selected
                    for _, t in ipairs(cs) do
                        local e = 0; for _, o in ipairs(st.observations[i]) do e += (q(d, o.r, t) - q(d, o.l, t) - o.delta) ^ 2 end
                        if not loss or e < loss then loss = e; selected = t end
                    end
                    candidate[key][i] = selected or best[key][i]
                end
            end
            for key, st in pairs(states) do
                local d = st.d; local sums, bands = {}, {}
                for j, read in ipairs(history) do
                    sums[j] = 0; bands[j] = {0, 0, 0}
                    for i = 1, EcuShared.POINTS do
                        local value = q(d, read.file[key][i], candidate[key][i]); sums[j] += value
                        for b, bounds in ipairs(EcuShared.BANDS) do if i >= bounds[1] and i <= bounds[2] then bands[j][b] += value; break end end
                    end
                end
                for pass = 1, 4 do
                    local changed = false
                    for i = 1, EcuShared.POINTS do
                        local bandIndex, bandCount
                        for b, bounds in ipairs(EcuShared.BANDS) do if i >= bounds[1] and i <= bounds[2] then bandIndex = b; bandCount = bounds[2] - bounds[1] + 1; break end end
                        local function loss(t)
                            local total = 0
                            for j, read in ipairs(history) do
                                local delta = q(d, read.file[key][i], t) - q(d, read.file[key][i], candidate[key][i])
                                total += (math.floor((sums[j] + delta) / EcuShared.POINTS * 500 + 1e-7) / 500 - read.f[key]) ^ 2
                                local hint = type(read.h[key]) == "table" and read.h[key][bandIndex]
                                local m = type(hint) == "number" and hint or type(hint) == "table" and hint.m
                                if type(m) == "number" then total += (math.floor((bands[j][bandIndex] + delta) / bandCount * 500 + 1e-7) / 500 - m) ^ 2 end
                            end
                            return total
                        end
                        local chosen = candidate[key][i]; local lowest = loss(chosen)
                        for _, t in ipairs(st.candidates[i]) do local score = loss(t); if score < lowest - 1e-12 then chosen = t; lowest = score end end
                        if chosen ~= candidate[key][i] then
                            for j, read in ipairs(history) do local delta = q(d, read.file[key][i], chosen) - q(d, read.file[key][i], candidate[key][i]); sums[j] += delta; bands[j][bandIndex] += delta end
                            candidate[key][i] = chosen; changed = true
                        end
                    end
                    if not changed then break end
                end
            end
            if mismatch then self.Tune.CodedMismatch = true; self.Tune.CodedCertified = {}; break end
            local g, f, hs = self:Flash(vehicle, candidate)
            local same = true
            for key, st in pairs(states) do
                if (f[key] or 0) >= (feedback[key] or 0) then best[key] = table.clone(candidate[key])
                else same = false end
            end
            if same then gain, feedback, hints = g, f, hs else gain, feedback, hints = self:Flash(vehicle, best) end
            for key, st in pairs(states) do
                self.Tune.CodedCertified[key] = {}
                for i = 1, EcuShared.POINTS do self.Tune.CodedCertified[key][i] = #st.candidates[i] == 1 end
            end
            self.Tune.Feedback = feedback; self.Tune.Hints = hints; self.Tune.Best = copy(best); self:SaveTune(vehicle, best, gain, feedback)
            self.Tune.BlockFeedback[block] = feedback
            if self:TuneComplete(feedback, hints) then break end
            for key in pairs(states) do if self:TuneMapComplete(key, feedback, hints) then states[key] = nil end end
        end
        return best, gain, feedback, hints
    end
    function RuntimeTune:Optimize(vehicle, onlyKey, phase, range)
        local best = self:ReadTuneFile(vehicle)
        local cached = self.Cache[vehicleId(vehicle)]
        local gain, feedback, hints = self:Flash(vehicle, best)
        self.Tune.Best = copy(best); self.Tune.Gain = gain; self.Tune.Feedback = feedback; self.Tune.Hints = hints
        if cached and cached.schema == 3 and cached.signature == signature(vehicle) and validFile(cached.file) then
            for _, def in ipairs(EcuShared.TABLES) do
                if onlyKey and def.key ~= onlyKey then continue end
                local changed = false
                for i = 1, EcuShared.POINTS do if math.abs(best[def.key][i] - cached.file[def.key][i]) > def.step * .1 then changed = true; break end end
                if changed then
                    self.Tune.Status = "load: " .. tostring(def.label or def.key)
                    local candidate = copy(best); candidate[def.key] = table.clone(cached.file[def.key])
                    local g, f, h = self:Flash(vehicle, candidate)
                    if (f[def.key] or 0) >= (feedback[def.key] or 0) then best, gain, feedback, hints = candidate, g, f, h
                    else gain, feedback, hints = self:Flash(vehicle, best) end
                end
            end
        end
        local function remember()
            self.Tune.Best = copy(best); self.Tune.Gain = gain; self.Tune.Feedback = feedback; self.Tune.Hints = hints
            self:SaveTune(vehicle, best, gain, feedback)
        end
        local function metric(def, index, f, h)
            for band, bounds in ipairs(EcuShared.BANDS or {}) do
                if index >= bounds[1] and index <= bounds[2] then
                    local hint = type(h) == "table" and type(h[def.key]) == "table" and h[def.key][band]
                    local value = type(hint) == "number" and hint or type(hint) == "table" and hint.m
                    if type(value) == "number" then return value, bounds[2] - bounds[1] + 1 end
                end
            end
            return f[def.key] or 0, EcuShared.POINTS
        end
        remember()
        local pass, stalled = 0, 0
        while true do
            self:CheckTune(); pass += 1; self.Tune.CurrentPass = pass
            if range then local done = false; for _, d in ipairs(EcuShared.TABLES) do if d.key == onlyKey then done = metric(d, range[1], feedback, hints) >= 1; break end end; if done then break end end
            if onlyKey and self:TuneMapComplete(onlyKey, feedback, hints) or not onlyKey and self:TuneComplete(feedback, hints) then break end
            local improved = false
            for _, def in ipairs(EcuShared.TABLES) do
                if onlyKey and def.key ~= onlyKey then continue end
                if self:TuneMapComplete(def.key, feedback, hints) then continue end
                for index = range and range[1] or 1, range and range[2] or EcuShared.POINTS do
                    self:CheckTune()
                    if self.Tune.CodedCertified and self.Tune.CodedCertified[def.key] and self.Tune.CodedCertified[def.key][index] then continue end
                    if self:TuneMapComplete(def.key, feedback, hints) then break end
                    self.Tune.Status = ("%s %d/%d | pass %d"):format(def.label or def.key, index, EcuShared.POINTS, pass)
                    self.Tune.CurrentTable = def.key; self.Tune.CurrentLabel = def.label or def.key; self.Tune.CurrentPoint = index; self.Tune.Phase = "coarse"; self.Tune.SearchStep = math.max(def.step, def.tol * .5)
                    local minTicks = phase == "coarse" and math.max(1, math.round(def.tol * .5 / def.step)) or 1
                    local initial = best[def.key][index]
                    local initialScore, count = metric(def, index, feedback, hints)
                    if initialScore >= 1 then continue end
                    local samples = {}; local peak = initialScore; local peakX = initial; local plateau = {initial}; local sampleCount = 0
                    local peakGain, peakFeedback, peakHints = gain, feedback, hints
                    local function snap_v(value) return math.clamp(math.round(value / def.step) * def.step, def.min, def.max) end
                    local function sample(value)
                        value = snap_v(value); local key = string.format("%.6f", value)
                        if samples[key] then return samples[key], value end
                        if sampleCount >= 32 then self.Tune.ProbeBudgetReached = true; return peak, peakX end
                        sampleCount += 1
                        self.Tune.TrialValue = value
                        self.Tune.Status = ("%s | %s %d/%d\nstep %.3g | value %.3g"):format(self.Tune.Phase, def.label or def.key, index, EcuShared.POINTS, self.Tune.SearchStep or def.step, value)
                        local file = copy(best); file[def.key][index] = value
                        local g, f, h = self:Flash(vehicle, file)
                        local score = metric(def, index, f, h); samples[key] = score
                        if score > peak + .000001 then
                            peak = score; peakX = value; plateau = {value}; peakGain, peakFeedback, peakHints = g, f, h
                            self.Tune.Best = copy(file); self.Tune.Gain = g; self.Tune.Feedback = f; self.Tune.Hints = h
                            self:SaveTune(vehicle, file, g, f)
                        elseif math.abs(score - peak) < .000001 then table.insert(plateau, value) end
                        return score, value
                    end
                    samples[string.format("%.6f", initial)] = initialScore
                    local localFine = phase == "fine" and pass == 1
                    local inversePass = phase == "Inverse" or (phase == "fine" and pass > 1)
                    local far = initial < (def.min + def.max) / 2 and def.max or def.min
                    local width = def.key == "Afr" and .95 or def.tol * .75
                    local function outsideRecipe(x) return def.recipeMin and def.recipeMax and (x < def.recipeMin - width or x > def.recipeMax + width) end
                    local knownZero = outsideRecipe(initial) and outsideRecipe(far)
                    local farScore = (localFine or knownZero) and initialScore or sample(far)
                    local floor = math.min(initialScore, farScore)
                    local ceiling = (localFine or pass > 1) and math.huge or floor + 1 / count - .0012
                    local probe_v, probeScore = initial, initialScore
                    if farScore > probeScore then probe_v, probeScore = far, farScore end
                    if inversePass and index > 1 and probeScore <= floor + .000001 then
                        for _, seed in ipairs({best[def.key][index - 1], index > 2 and 2 * best[def.key][index - 1] - best[def.key][index - 2] or initial}) do
                            local score, x = sample(seed)
                            if score > probeScore then probe_v, probeScore = x, score end
                            if probeScore > floor + .000001 then break end
                        end
                    end
                    if not localFine and probeScore <= floor + .000001 and peak < ceiling then
                        local scanTicks = math.max(minTicks, math.round((def.max - def.min) / 4 / def.step))
                        while true do
                            local stride = scanTicks * def.step
                            for value = def.min, def.max + stride * .5, stride do
                                local score, x = sample(value)
                                if score > floor + .000001 then probe_v, probeScore = x, score; break end
                            end
                            if probeScore > floor + .000001 or scanTicks == minTicks then break end
                            scanTicks = math.max(minTicks, math.floor(scanTicks / 2))
                        end
                    end
                    local inverseDone = false
                    if inversePass and probeScore > floor + .000001 then
                        local w_dist = def.tol * .75
                        local fraction = math.clamp((probeScore - floor) * count, 0, 1)
                        if fraction < .995 then
                            local distance = w_dist * (1 - fraction)
                            sample(probe_v - distance); sample(probe_v + distance)
                        end
                        if w_dist * count * .002 >= def.step * .5 then
                            local center = peakX
                            local left, lx = sample(center - w_dist * .45)
                            local right, rx = sample(center + w_dist * .45)
                            if left > floor + .001 and right > floor + .001 and lx < rx then
                                sample((lx + rx + w_dist * count * (right - left)) * .5)
                            end
                        end
                        inverseDone = peak >= floor + 1 / count - .0022
                    end
                    if not inverseDone and (localFine or probeScore > floor + .000001) and peak < ceiling then
                        local ticks = math.max(minTicks, math.round((localFine and def.tol * .25 or (def.max - def.min) / 4) / def.step))
                        while ticks >= minTicks do
                            self.Tune.SearchStep = ticks * def.step
                            self.Tune.Phase = ticks == 1 and "fine" or "coarse"
                            for move = 1, math.ceil((def.max - def.min) / self.Tune.SearchStep) + 2 do
                                local origin, before = peakX, peak
                                sample(origin - self.Tune.SearchStep); sample(origin + self.Tune.SearchStep)
                                if peak <= before + .000001 or peak >= ceiling then break end
                            end
                            if ticks == minTicks or peak >= ceiling then break end
                            ticks = math.max(minTicks, math.floor(ticks / 2))
                        end
                        self.Tune.Phase = "fine"; self.Tune.SearchStep = def.step
                        for _, direction in ipairs((phase == "coarse" or localFine or peak >= ceiling) and {} or {-1, 1}) do
                            local origin = peakX
                            for hop = 1, 16 do
                                local value = snap_v(origin + direction * hop * def.step)
                                if value == origin then break end
                                local score = sample(value)
                                if score < peak - .000001 then break end
                                if value == def.min or value == def.max then break end
                            end
                        end
                    end
                    local low, high = peakX, peakX
                    for _, value in ipairs(plateau) do
                        local score = samples[string.format("%.6f", value)]
                        if score and math.abs(score - peak) < .000001 and math.abs(value - peakX) <= def.tol * .5 then low = math.min(low, value); high = math.max(high, value) end
                    end
                    local chosen = inverseDone and peakX or snap_v((low + high) / 2)
                    best[def.key][index] = chosen
                    self.Tune.Phase = "save"; self.Tune.Status = ("save %s %d/%d"):format(def.label or def.key, index, EcuShared.POINTS)
                    if inverseDone then gain, feedback, hints = peakGain, peakFeedback, peakHints
                    else gain, feedback, hints = self:Flash(vehicle, best) end
                    if metric(def, index, feedback, hints) > initialScore + .000001 then improved = true end
                    remember()
                end
            end
            if phase == "coarse" or phase == "Inverse" then break end
            stalled = improved and 0 or stalled + 1
            if stalled >= 2 or pass >= 5 then self.Tune.Stalled = true; break end
            if not improved then
                self.Tune.Status = "retry"
                if not phase then task.wait(.5) end
            end
        end
        gain, feedback, hints = self:Flash(vehicle, best); remember()
        self.Tune.Complete = self:TuneComplete(feedback, hints)
        self.Tune.TableComplete = onlyKey and self:TuneMapComplete(onlyKey, feedback, hints) or nil
    end
    function RuntimeTune:Run()
        local vehicle
        for _, v in ipairs(workspace.SpawnedVehicles:GetChildren()) do
            if v:GetAttribute("OwnerUserId") == player.UserId and GameShared.inTuneBay(v) then vehicle = v; break end
        end
        if not vehicle then
            print({ Title = "ระบบจูน 1 คัน", Content = "ไม่พบรถของคุณในช่องจูน (Tune Bay)!", Duration = 4 })
            self.Busy = false; return
        end
        local main = env.__MahanakhonMahanakhon
        assert(not (main and main.Tune and main.Tune.Busy))
        self.Tune.Vehicle = vehicle; self.Busy = true; self.Started = os.clock()
        print({ Title = "ระบบจูน 1 คัน", Content = "เริ่มการจูนรถ: " .. tostring(vehicle:GetAttribute("VehicleId") or vehicle.Name), Duration = 3 })
        local read, feedback = pcall(Http.JSONDecode, Http, vehicle:GetAttribute("EcuFeedback") or "{}")
        local hintsOk, hints = pcall(Http.JSONDecode, Http, vehicle:GetAttribute("EcuHints") or "{}")
        if read and type(feedback) == "table" and self:TuneComplete(feedback, hintsOk and hints or {}) then
            self.Tune.Feedback = feedback; self.Initial = table.clone(feedback)
            self.Complete = true; self.Status = "done"; self.Seconds = 0; self.Busy = false
            print({ Title = "ระบบจูน 1 คัน", Content = "รถคันนี้จูนเต็ม 100% อยู่แล้ว!", Duration = 4 })
            return
        end
        local best = self:ReadTuneFile(vehicle)
        self.Tune.Best = copy(best)
        local ok, err = xpcall(function()
            local gain, feedback_val, hints_val = self:Flash(vehicle, best)
            self.Initial = table.clone(feedback_val)
            local cached = self.Cache[vehicleId(vehicle)]
            if cached and cached.signature == signature(vehicle) and validFile(cached.file) then
                local g, f, h = self:Flash(vehicle, cached.file)
                local candidate = copy(best)
                for _, d in ipairs(EcuShared.TABLES) do if (f[d.key] or 0) > (feedback_val[d.key] or 0) then candidate[d.key] = table.clone(cached.file[d.key]) end end
                best = candidate; gain, feedback_val, hints_val = self:Flash(vehicle, best)
            end
            self.Tune.Best = copy(best); self:SaveTune(vehicle, best, gain, feedback_val)
            best, gain, feedback_val, hints_val = self:OptimizeCoded(vehicle, best, gain, feedback_val, hints_val)
            self.Tune.Best = copy(best)
            self.Tune.Round = 0
            while not self:TuneComplete(self.Tune.Feedback or feedback_val, self.Tune.Hints or hints_val) do
                self:CheckTune()
                self.Tune.Round += 1; self.Tune.Stalled = false
                for _, def in ipairs(EcuShared.TABLES) do
                    self:CheckTune()
                    if not self:TuneMapComplete(def.key, self.Tune.Feedback or feedback_val, self.Tune.Hints or hints_val) then
                        self:Optimize(vehicle, def.key, "fine")
                        if not self:TuneMapComplete(def.key, self.Tune.Feedback, self.Tune.Hints) then
                            self.Tune.CodedCertified = nil
                            self:Optimize(vehicle, def.key, "Inverse")
                        end
                    end
                end
                self.Tune.CodedCertified = nil
                if not self:TuneComplete(self.Tune.Feedback, self.Tune.Hints) then
                    self.Tune.Status = "retry"
                    task.wait(.25)
                end
            end
        end, tostring)
        local restored, reason = pcall(function()
            local gain, feedback_val, hints_val = self:Flash(vehicle, self.Tune.Best, true)
            self.Tune.Gain = gain; self.Tune.Feedback = feedback_val; self.Tune.Hints = hints_val
            self:SaveTune(vehicle, self.Tune.Best, gain, feedback_val)
            self.Complete = self:TuneComplete(feedback_val, hints_val)
        end)
        self.Error = not ok and tostring(err) or not restored and tostring(reason) or nil
        self.Seconds = os.clock() - self.Started; self.Busy = false
        self.Status = self.Tune.Cancel and "stop" or self.Complete and "done" or self.Error or "failed"
        if self.Complete then
            print({ Title = "ระบบจูน 1 คัน", Content = "จูนเสร็จสมบูรณ์ 100%! ใช้เวลา: " .. string.format("%.1f", self.Seconds) .. " วิ", Duration = 5 })
        else
            print({ Title = "ระบบจูน 1 คัน", Content = "การจูนสิ้นสุด: " .. tostring(self.Status), Duration = 5 })
        end
    end

    task.spawn(function()
        local ok, result = pcall(RuntimeTune.Run, RuntimeTune)
        if not ok then
            RuntimeTune.Busy = false; RuntimeTune.Error = tostring(result); RuntimeTune.Status = "failed"
            
        end
    end)
end

-- ==================== ระบบจูนทุกคัน (Tune All) ====================
local function StartTuneAll()
    local env = getgenv()
    local previous = env.__MahanakhonTuneSolo
    if previous and previous.Busy then
        print({ Title = "ระบบจูน", Content = "กำลังทำการจูนอยู่แล้ว...", Duration = 3 })
        return
    end

    local GameShared = require(RS:WaitForChild("GameShared"))
    local EcuShared = require(RS:WaitForChild("EcuShared"))
    local Net = require(RS:WaitForChild("NetSeal"))
    local Remotes = RS:WaitForChild("GameRemotes")
    local RuntimeTuneAll = {Alive = true, Busy = false, Tune = {Tests = 0, Cancel = false}, Cache = {}}
    local cachePath = "Mahanakhon X/MAHANAKHON RACING/TuneSolo_" .. player.UserId .. ".json"
    pcall(function() if isfile(cachePath) then RuntimeTuneAll.Cache = Http:JSONDecode(readfile(cachePath)) end end)
    env.__MahanakhonTuneSolo = RuntimeTuneAll

    local function copy(file)
        local out = {}
        for _, def in ipairs(EcuShared.TABLES) do out[def.key] = table.clone(file[def.key]) end
        return out
    end
    local function decode(value)
        local ok, result = pcall(function() return EcuShared.decode(value) end)
        return ok and result or nil
    end
    local function validFile(file)
        if type(file) ~= "table" then return false end
        for _, def in ipairs(EcuShared.TABLES) do
            if type(file[def.key]) ~= "table" or #file[def.key] ~= EcuShared.POINTS then return false end
            for _, value in ipairs(file[def.key]) do
                if type(value) ~= "number" or value ~= value or value < def.min - .0001 or value > def.max + .0001 then return false end
            end
        end
        return true
    end
    local function vehicleId(vehicle) return vehicle:GetAttribute("VehicleId") or vehicle.Name end
    local function signature(vehicle)
        local fields = {vehicleId(vehicle), tostring(player.UserId), tostring(game.PlaceVersion), tostring(vehicle:GetAttribute("EcuRecipeVer") or "current")}
        local attrs = vehicle:GetAttributes()
        local keys = {}
        for key in pairs(attrs) do if key == "EngineLevel" or key:find("Piston") or key:find("Bore") then table.insert(keys, key) end end
        table.sort(keys)
        for _, key in ipairs(keys) do table.insert(fields, key .. "=" .. tostring(attrs[key])) end
        return table.concat(fields, "|")
    end
    local function isCar(vehicle)
        local definition = GameShared.vehicle(vehicle:GetAttribute("VehicleId") or vehicle.Name)
        return definition and definition.category == "Car"
    end

    function RuntimeTuneAll:CheckTune()
        assert(self.Alive and not self.Tune.Cancel)
        local v = self.Tune.Vehicle
        assert(v and v.Parent and v:GetAttribute("OwnerUserId") == player.UserId)
    end
    function RuntimeTuneAll:ReadTuneFile(v)
        local file = Net.invoke(Remotes.Ecu, "Get", v)
        if validFile(file) then return copy(file), true end
        assert(not v:GetAttribute("EcuBorrowed"))
        return EcuShared.stockFile(), false
    end
    function RuntimeTuneAll:SaveTune(v, file, gain, feedback)
        self.Saved = copy(file)
        self.Cache[vehicleId(v)] = {schema = 3, signature = signature(v), file = copy(file), feedback = feedback, gain = gain}
        local ok, err = pcall(writefile, cachePath, Http:JSONEncode(self.Cache))
        if not ok then self.CacheError = tostring(err) end
    end
    function RuntimeTuneAll:Flash(vehicle, file, allowStopped)
        if not allowStopped then self:CheckTune() end
        assert(validFile(file))
        local prior = self.Tune.LastMeasurement
        if prior and prior.Vehicle == vehicle and prior.Signature == signature(vehicle) and prior.Stored == vehicle:GetAttribute("EcuFile") then
            local same = true
            for _, def in ipairs(EcuShared.TABLES) do
                for i = 1, EcuShared.POINTS do
                    if math.abs(prior.File[def.key][i] - file[def.key][i]) > 1e-8 then same = false; break end
                end
                if not same then break end
            end
            if same then
                self.Tune.LatestFeedback = table.clone(prior.Feedback)
                self.Tune.Hints = prior.Hints
                return prior.Gain, table.clone(prior.Feedback), prior.Hints
            end
        end
        local lastMessage
        for attempt = 1, 4 do
            local remaining = (self.Tune.LastSend or 0) + (EcuShared.SEND_COOLDOWN or 2) + .15 - os.clock()
            while remaining > 0 do
                if not allowStopped then self:CheckTune() end
                task.wait(math.min(.1, remaining))
                remaining = (self.Tune.LastSend or 0) + (EcuShared.SEND_COOLDOWN or 2) + .15 - os.clock()
            end
            if not allowStopped then self:CheckTune() end
            self.Tune.LastSend = os.clock()
            local ok, message, gain, feedback, hints = Net.invoke(Remotes.Ecu, "Send", vehicle, file, {k = EcuShared.sum(file)})
            if ok then
                assert(type(gain) == "number" and type(feedback) == "table")
                self.Tune.LatestFeedback = table.clone(feedback)
                self.Tune.FeedbackAt = os.clock()
                self.Tune.Tests = (self.Tune.Tests or 0) + 1
                self.Tune.Hints = type(hints) == "table" and hints or decode(vehicle:GetAttribute("EcuHints")) or {}
                self.Tune.LastMeasurement = {Vehicle = vehicle, Signature = signature(vehicle), Stored = vehicle:GetAttribute("EcuFile"), File = copy(file), Gain = gain, Feedback = table.clone(feedback), Hints = self.Tune.Hints}
                return gain, feedback, self.Tune.Hints
            end
            lastMessage = tostring(message)
            local text = lastMessage:lower()
            if not (text:find("still writing", 1, true) or text:find("slow down", 1, true) or text:find("cooldown", 1, true)) then
                self.LastFlashError = lastMessage
                error(nil, 0)
            end
        end
        self.LastFlashError = lastMessage
        error(nil, 0)
    end
    function RuntimeTuneAll:TuneMapComplete(key, feedback, hints)
        if (feedback[key] or 0) < 1 then return false end
        for _, hint in ipairs(type(hints) == "table" and hints[key] or {}) do
            local value = type(hint) == "number" and hint or type(hint) == "table" and hint.m
            if type(value) == "number" and value < 1 then return false end
        end
        return true
    end
    function RuntimeTuneAll:TuneComplete(feedback, hints)
        for _, def in ipairs(EcuShared.TABLES) do
            if not self:TuneMapComplete(def.key, feedback, hints) then return false end
        end
        return true
    end
    function RuntimeTuneAll:OptimizeCoded(vehicle, best, gain, feedback, hints)
        best = best and copy(best) or self:ReadTuneFile(vehicle)
        if not gain then gain, feedback, hints = self:Flash(vehicle, best) end
        self.Tune.Best = copy(best)
        self.Tune.CodedCertified = {}
        self.Tune.CodedBlocks = 0
        self.Tune.BlockFeedback = {}
        if self:TuneComplete(feedback, hints) then return best, gain, feedback, hints end
        local residues = {[1] = true, [3] = true, [4] = true, [5] = true, [9] = true}
        local function h(row, col, size)
            if size == 12 then
                if row == 0 or col == 0 then return 1 end
                local x = (row - col) % 11
                return x ~= 0 and residues[x] and 1 or -1
            end
            local x = bit32.band(row, col)
            local parity = 0
            while x > 0 do parity = bit32.bxor(parity, bit32.band(x, 1)); x = bit32.rshift(x, 1) end
            return parity == 0 and 1 or -1
        end
        local states = {}
        local history = {{file = copy(best), f = feedback, h = hints}}
        local probeCache = {}
        local initialSignature = signature(vehicle)
        local function same(a, b)
            for _, d in ipairs(EcuShared.TABLES) do
                for i = 1, EcuShared.POINTS do
                    if math.abs(a[d.key][i] - b[d.key][i]) > 1e-8 then return false end
                end
            end
            return true
        end
        local function probe(file)
            assert(signature(vehicle) == initialSignature)
            local key = tostring(EcuShared.sum(file))
            local bucket = probeCache[key]
            for _, cached in ipairs(bucket or {}) do
                if same(cached.file, file) then return cached.gain, cached.feedback, cached.hints end
            end
            local g, f, h_res = self:Flash(vehicle, file)
            bucket = bucket or {}
            probeCache[key] = bucket
            bucket[#bucket + 1] = {file = copy(file), gain = g, feedback = f, hints = h_res}
            return g, f, h_res
        end
        for _, d in ipairs(EcuShared.TABLES) do
            if not self:TuneMapComplete(d.key, feedback, hints) then
                local st = {d = d, observations = {}, candidates = {}}
                for i = 1, EcuShared.POINTS do
                    st.observations[i] = {}
                    local cs = {}
                    for tick = math.ceil(d.min / d.step - 1e-6), math.floor(d.max / d.step + 1e-6) do cs[#cs + 1] = tick * d.step end
                    st.candidates[i] = cs
                end
                states[d.key] = st
            end
        end
        local function snap(d, x) return math.clamp(math.round(x / d.step) * d.step, d.min, d.max) end
        local function q(d, x, t)
            local width = d.key == "Afr" and .95 or d.tol * .75
            return math.clamp(math.round((1 - math.abs(x - t) / width) * 100) / 100, 0, 1)
        end
        local function metric(key, index, f, hs)
            for b, r in ipairs(EcuShared.BANDS) do
                if index >= r[1] and index <= r[2] then
                    local z = type(hs[key]) == "table" and hs[key][b]
                    local m = type(z) == "number" and z or type(z) == "table" and z.m
                    if type(m) == "number" then return m, r[2] - r[1] + 1 end
                end
            end
            return f[key] or 0, EcuShared.POINTS
        end
        for block = 1, 4 do
            self.Tune.CodedBlocks = block
            self.Tune.Status = "tuning"
            local probes = {}
            for key, st in pairs(states) do
                local d = st.d; probes[key] = {}
                for i = 1, EcuShared.POINTS do
                    local l, r
                    if block <= 2 then
                        local low, high = d.recipeMin or d.min, d.recipeMax or d.max
                        l = low + (high - low) * ((block - 1) + .5) / 4; r = low + (high - low) * ((block + 1) + .5) / 4
                    else
                        local cs = st.candidates[i]; local choices = {}; local totalWeight = 0
                        local function weight(t) return (not d.recipeMin or t >= d.recipeMin - .15 and t <= d.recipeMax + .15) and 1 or .02 end
                        for _, t in ipairs(cs) do totalWeight += weight(t) end
                        for j = 0, math.min(12, #cs - 1) do
                            local threshold = totalWeight * j / math.max(1, math.min(12, #cs - 1)); local accumulated = 0
                            for _, t in ipairs(cs) do accumulated += weight(t); if accumulated >= threshold then if choices[#choices] ~= t then choices[#choices + 1] = t end; break end end
                        end
                        local info
                        for a = 1, #choices do
                            for b = a + 1, #choices do
                                local repeated = false
                                for _, o in ipairs(st.observations[i]) do if math.abs(o.l - choices[a]) < 1e-6 and math.abs(o.r - choices[b]) < 1e-6 then repeated = true; break end end
                                local bins = {}; local total = 0
                                for _, t in ipairs(cs) do
                                    local w = (not d.recipeMin or t >= d.recipeMin - .15 and t <= d.recipeMax + .15) and 1 or .02
                                    local bin = math.round((q(d, choices[b], t) - q(d, choices[a], t)) / .015); bins[bin] = (bins[bin] or 0) + w; total += w
                                end
                                local sum = 0; for _, n in pairs(bins) do sum += n * n end
                                local score = total > 0 and total - sum / total or 0
                                if not repeated and (not info or score > info) then info = score; l = choices[a]; r = choices[b] end
                            end
                        end
                        if not l then l = cs[1] or best[key][i]; r = l end
                    end
                    probes[key][i] = {snap(d, l), snap(d, r)}
                end
            end
            local columns = {}; local maxColumn = 0
            for key, st in pairs(states) do
                columns[key] = {}; local counts = {}
                for i = 1, EcuShared.POINTS do
                    local group = 0
                    for b, bounds in ipairs(EcuShared.BANDS) do
                        if i >= bounds[1] and i <= bounds[2] then
                            local hint = type(hints[key]) == "table" and hints[key][b]
                            local m = type(hint) == "number" and hint or type(hint) == "table" and hint.m
                            if type(m) == "number" then group = b end
                            break
                        end
                    end
                    local p = probes[key][i]
                    if math.abs(p[1] - p[2]) < 1e-8 then columns[key][i] = 0
                    else counts[group] = (counts[group] or 0) + 1; columns[key][i] = counts[group]; maxColumn = math.max(maxColumn, counts[group]) end
                end
            end
            local rowCount = 2
            if maxColumn >= 8 and maxColumn <= 11 then rowCount = 12 else while rowCount <= maxColumn do rowCount *= 2 end end
            local readings = {}
            for row = 0, rowCount - 1 do
                self:CheckTune(); local file = copy(best)
                for key, st in pairs(states) do for i = 1, EcuShared.POINTS do file[key][i] = probes[key][i][columns[key][i] > 0 and h(row, columns[key][i], rowCount) == 1 and 2 or 1] end end
                local g, f, hs = probe(file); readings[row + 1] = {f = f, h = hs, file = file}; history[#history + 1] = readings[row + 1]
            end
            local candidate = copy(best); local mismatch = false
            for key, st in pairs(states) do
                local d = st.d
                for i = 1, EcuShared.POINTS do
                    local delta = 0; local count
                    for row = 0, rowCount - 1 do local m, n = metric(key, i, readings[row + 1].f, readings[row + 1].h); count = n; if columns[key][i] > 0 then delta += h(row, columns[key][i], rowCount) * m end end
                    delta *= 2 * count / rowCount
                    local p = probes[key][i]; st.observations[i][#st.observations[i] + 1] = {l = p[1], r = p[2], delta = delta, eps = 2 * count * .00101}
                    local cs = {}
                    for tick = math.ceil(d.min / d.step - 1e-6), math.floor(d.max / d.step + 1e-6) do
                        local t = tick * d.step; local valid = true
                        for _, o in ipairs(st.observations[i]) do if math.abs(q(d, o.r, t) - q(d, o.l, t) - o.delta) > o.eps + 1e-6 then valid = false; break end end
                        if valid then cs[#cs + 1] = t end
                    end
                    if #cs == 0 then mismatch = true; cs = st.candidates[i] end
                    st.candidates[i] = cs
                    local loss, selected
                    for _, t in ipairs(cs) do
                        local e = 0; for _, o in ipairs(st.observations[i]) do e += (q(d, o.r, t) - q(d, o.l, t) - o.delta) ^ 2 end
                        if not loss or e < loss then loss = e; selected = t end
                    end
                    candidate[key][i] = selected or best[key][i]
                end
            end
            if mismatch then self.Tune.CodedMismatch = true; self.Tune.CodedCertified = {}; break end
            local g, f, hs = self:Flash(vehicle, candidate)
            local same_res = true
            for key, st in pairs(states) do
                if (f[key] or 0) >= (feedback[key] or 0) then best[key] = table.clone(candidate[key])
                else same_res = false end
            end
            if same_res then gain, feedback, hints = g, f, hs else gain, feedback, hints = self:Flash(vehicle, best) end
            for key, st in pairs(states) do
                self.Tune.CodedCertified[key] = {}
                for i = 1, EcuShared.POINTS do self.Tune.CodedCertified[key][i] = #st.candidates[i] == 1 end
            end
            self.Tune.Feedback = feedback; self.Tune.Hints = hints; self.Tune.Best = copy(best); self:SaveTune(vehicle, best, gain, feedback)
            self.Tune.BlockFeedback[block] = feedback
            if self:TuneComplete(feedback, hints) then break end
            for key in pairs(states) do if self:TuneMapComplete(key, feedback, hints) then states[key] = nil end end
        end
        return best, gain, feedback, hints
    end
    function RuntimeTuneAll:Optimize(vehicle, onlyKey, phase, range)
        local best = self:ReadTuneFile(vehicle)
        local cached = self.Cache[vehicleId(vehicle)]
        local gain, feedback, hints = self:Flash(vehicle, best)
        self.Tune.Best = copy(best); self.Tune.Gain = gain; self.Tune.Feedback = feedback; self.Tune.Hints = hints
        if cached and cached.schema == 3 and cached.signature == signature(vehicle) and validFile(cached.file) then
            for _, def in ipairs(EcuShared.TABLES) do
                if onlyKey and def.key ~= onlyKey then continue end
                local changed = false
                for i = 1, EcuShared.POINTS do if math.abs(best[def.key][i] - cached.file[def.key][i]) > def.step * .1 then changed = true; break end end
                if changed then
                    self.Tune.Status = "load: " .. tostring(def.label or def.key)
                    local candidate = copy(best); candidate[def.key] = table.clone(cached.file[def.key])
                    local g, f, h = self:Flash(vehicle, candidate)
                    if (f[def.key] or 0) >= (feedback[def.key] or 0) then best, gain, feedback, hints = candidate, g, f, h
                    else gain, feedback, hints = self:Flash(vehicle, best) end
                end
            end
        end
        local function remember()
            self.Tune.Best = copy(best); self.Tune.Gain = gain; self.Tune.Feedback = feedback; self.Tune.Hints = hints
            self:SaveTune(vehicle, best, gain, feedback)
        end
        local function metric(def, index, f, h)
            for band, bounds in ipairs(EcuShared.BANDS or {}) do
                if index >= bounds[1] and index <= bounds[2] then
                    local hint = type(h) == "table" and type(h[def.key]) == "table" and h[def.key][band]
                    local value = type(hint) == "number" and hint or type(hint) == "table" and hint.m
                    if type(value) == "number" then return value, bounds[2] - bounds[1] + 1 end
                end
            end
            return f[def.key] or 0, EcuShared.POINTS
        end
        remember()
        local pass, stalled = 0, 0
        while true do
            self:CheckTune(); pass += 1; self.Tune.CurrentPass = pass
            if range then
                local done = false
                for _, d in ipairs(EcuShared.TABLES) do if d.key == onlyKey then done = metric(d, range[1], feedback, hints) >= 1; break end end
                if done then break end
            end
            if onlyKey and self:TuneMapComplete(onlyKey, feedback, hints) or not onlyKey and self:TuneComplete(feedback, hints) then break end
            local improved = false
            for _, def in ipairs(EcuShared.TABLES) do
                if onlyKey and def.key ~= onlyKey then continue end
                if self:TuneMapComplete(def.key, feedback, hints) then continue end
                for index = range and range[1] or 1, range and range[2] or EcuShared.POINTS do
                    self:CheckTune()
                    if self.Tune.CodedCertified and self.Tune.CodedCertified[def.key] and self.Tune.CodedCertified[def.key][index] then continue end
                    if self:TuneMapComplete(def.key, feedback, hints) then break end
                    self.Tune.Status = ("%s %d/%d | pass %d"):format(def.label or def.key, index, EcuShared.POINTS, pass)
                    self.Tune.CurrentTable = def.key; self.Tune.CurrentLabel = def.label or def.key; self.Tune.CurrentPoint = index; self.Tune.Phase = "coarse"; self.Tune.SearchStep = math.max(def.step, def.tol * .5)
                    local minTicks = phase == "coarse" and math.max(1, math.round(def.tol * .5 / def.step)) or 1
                    local initial = best[def.key][index]
                    local initialScore, count = metric(def, index, feedback, hints)
                    if initialScore >= 1 then continue end
                    local samples = {}; local peak = initialScore; local peakX = initial; local plateau = {initial}; local sampleCount = 0
                    local peakGain, peakFeedback, peakHints = gain, feedback, hints
                    local function snap_val(value) return math.clamp(math.round(value / def.step) * def.step, def.min, def.max) end
                    local function sample(value)
                        value = snap_val(value)
                        local key = string.format("%.6f", value)
                        if samples[key] then return samples[key], value end
                        if sampleCount >= 32 then self.Tune.ProbeBudgetReached = true; return peak, peakX end
                        sampleCount += 1
                        self.Tune.TrialValue = value
                        self.Tune.Status = ("%s | %s %d/%d\nstep %.3g | value %.3g"):format(self.Tune.Phase, def.label or def.key, index, EcuShared.POINTS, self.Tune.SearchStep or def.step, value)
                        local file = copy(best)
                        file[def.key][index] = value
                        local g, f, h = self:Flash(vehicle, file)
                        local score = metric(def, index, f, h)
                        samples[key] = score
                        if score > peak + .000001 then
                            peak = score; peakX = value; plateau = {value}; peakGain, peakFeedback, peakHints = g, f, h
                            self.Tune.Best = copy(file); self.Tune.Gain = g; self.Tune.Feedback = f; self.Tune.Hints = h
                            self:SaveTune(vehicle, file, g, f)
                        elseif math.abs(score - peak) < .000001 then table.insert(plateau, value) end
                        return score, value
                    end
                    samples[string.format("%.6f", initial)] = initialScore
                    local localFine = phase == "fine" and pass == 1
                    local inversePass = phase == "Inverse" or (phase == "fine" and pass > 1)
                    local far = initial < (def.min + def.max) / 2 and def.max or def.min
                    local width = def.key == "Afr" and .95 or def.tol * .75
                    local function outsideRecipe(x) return def.recipeMin and def.recipeMax and (x < def.recipeMin - width or x > def.recipeMax + width) end
                    local knownZero = outsideRecipe(initial) and outsideRecipe(far)
                    local farScore = (localFine or knownZero) and initialScore or sample(far)
                    local floor = math.min(initialScore, farScore)
                    local ceiling = (localFine or pass > 1) and math.huge or floor + 1 / count - .0012
                    local probe_val, probeScore = initial, initialScore
                    if farScore > probeScore then probe_val, probeScore = far, farScore end
                    if inversePass and index > 1 and probeScore <= floor + .000001 then
                        for _, seed in ipairs({best[def.key][index - 1], index > 2 and 2 * best[def.key][index - 1] - best[def.key][index - 2] or initial}) do
                            local score, x = sample(seed)
                            if score > probeScore then probe_val, probeScore = x, score end
                            if probeScore > floor + .000001 then break end
                        end
                    end
                    if not localFine and probeScore <= floor + .000001 and peak < ceiling then
                        local scanTicks = math.max(minTicks, math.round((def.max - def.min) / 4 / def.step))
                        while true do
                            local stride = scanTicks * def.step
                            for value = def.min, def.max + stride * .5, stride do
                                local score, x = sample(value)
                                if score > floor + .000001 then probe_val, probeScore = x, score; break end
                            end
                            if probeScore > floor + .000001 or scanTicks == minTicks then break end
                            scanTicks = math.max(minTicks, math.floor(scanTicks / 2))
                        end
                    end
                    local inverseDone = false
                    if inversePass and probeScore > floor + .000001 then
                        local w_val = def.tol * .75
                        local fraction = math.clamp((probeScore - floor) * count, 0, 1)
                        if fraction < .995 then
                            local distance = w_val * (1 - fraction)
                            sample(probe_val - distance); sample(probe_val + distance)
                        end
                        inverseDone = peak >= floor + 1 / count - .0022
                    end
                    if not inverseDone and (localFine or probeScore > floor + .000001) and peak < ceiling then
                        local ticks = math.max(minTicks, math.round((localFine and def.tol * .25 or (def.max - def.min) / 4) / def.step))
                        while ticks >= minTicks do
                            self.Tune.SearchStep = ticks * def.step
                            self.Tune.Phase = ticks == 1 and "fine" or "coarse"
                            for move = 1, math.ceil((def.max - def.min) / self.Tune.SearchStep) + 2 do
                                local origin, before = peakX, peak
                                sample(origin - self.Tune.SearchStep); sample(origin + self.Tune.SearchStep)
                                if peak <= before + .000001 or peak >= ceiling then break end
                            end
                            if ticks == minTicks or peak >= ceiling then break end
                            ticks = math.max(minTicks, math.floor(ticks / 2))
                        end
                        self.Tune.Phase = "fine"; self.Tune.SearchStep = def.step
                        for _, direction in ipairs((phase == "coarse" or localFine or peak >= ceiling) and {} or {-1, 1}) do
                            local origin = peakX
                            for hop = 1, 16 do
                                local value = snap_val(origin + direction * hop * def.step)
                                if value == origin then break end
                                local score = sample(value)
                                if score < peak - .000001 then break end
                                if value == def.min or value == def.max then break end
                            end
                        end
                    end
                    local low, high = peakX, peakX
                    for _, value in ipairs(plateau) do
                        local score = samples[string.format("%.6f", value)]
                        if score and math.abs(score - peak) < .000001 and math.abs(value - peakX) <= def.tol * .5 then low = math.min(low, value); high = math.max(high, value) end
                    end
                    local chosen = inverseDone and peakX or snap_val((low + high) / 2)
                    best[def.key][index] = chosen
                    self.Tune.Phase = "save"; self.Tune.Status = ("save %s %d/%d"):format(def.label or def.key, index, EcuShared.POINTS)
                    if inverseDone then gain, feedback, hints = peakGain, peakFeedback, peakHints
                    else gain, feedback, hints = self:Flash(vehicle, best) end
                    if metric(def, index, feedback, hints) > initialScore + .000001 then improved = true end
                    remember()
                end
            end
            if phase == "coarse" or phase == "Inverse" then break end
            stalled = improved and 0 or stalled + 1
            if stalled >= 2 or pass >= 5 then self.Tune.Stalled = true; break end
            if not improved then self.Tune.Status = "retry"; if not phase then task.wait(.5) end end
        end
        gain, feedback, hints = self:Flash(vehicle, best); remember()
        self.Tune.Complete = self:TuneComplete(feedback, hints)
        self.Tune.TableComplete = onlyKey and self:TuneMapComplete(onlyKey, feedback, hints) or nil
    end

    function RuntimeTuneAll:Run()
        self.Busy = true
        self.Started = os.clock()
        local tunedVehicles = {}
        print({ Title = "ระบบจูนทุกคัน", Content = "เริ่มการทำงานระบบจูนรถทุกคันในโรงรถ...", Duration = 4 })

        while self.Alive and not self.Tune.Cancel do
            local list
            for _ = 1, 3 do
                list = Net.invoke(Remotes.Garage, "List")
                if type(list) == "table" then break end
                task.wait(1)
            end
            if type(list) ~= "table" then
                print({ Title = "ระบบจูนทุกคัน", Content = "ไม่สามารถเปิดโรงรถได้", Duration = 4 })
                break
            end

            local targetVehicleId
            for _, entry in ipairs(list.vehicles or {}) do
                if not entry.locked and not tunedVehicles[entry.id] then
                    targetVehicleId = entry.id
                    break
                end
            end

            if not targetVehicleId then
                print({ Title = "ระบบจูนทุกคัน", Content = "จูนครบทุกคันแล้ว!", Duration = 5 })
                break
            end

            print({ Title = "ระบบจูนทุกคัน", Content = "กำลังเรียกรถ: " .. tostring(targetVehicleId), Duration = 3 })
            pcall(function() Net.invoke(Remotes.Garage, "Despawn") end)
            task.wait(1)

            local ok, message = Net.invoke(Remotes.Garage, "Spawn", targetVehicleId)
            if not ok then
                task.wait(2)
                continue
            end
            task.wait(1.5)

            local vehicle
            local deadline = os.clock() + 6
            repeat
                for _, v in ipairs(workspace.SpawnedVehicles:GetChildren()) do
                    if v:GetAttribute("OwnerUserId") == player.UserId and v:GetAttribute("VehicleId") == targetVehicleId then
                        vehicle = v
                        break
                    end
                end
                if not vehicle then task.wait(0.2) end
            until vehicle or os.clock() > deadline

            if not vehicle then
                continue
            end

            local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
            if humanoid then
                if isCar(vehicle) then
                    Net.fire(RS:WaitForChild("CarRemote"), "Enter", vehicle, "Driver")
                else
                    Net.fire(RS:WaitForChild("PCX160Remote"), "Mount", vehicle, "Drive")
                end
                local sitDeadline = os.clock() + 4
                repeat
                    task.wait(0.1)
                until humanoid.SeatPart or os.clock() > sitDeadline
            end

            self.Tune.Vehicle = vehicle

            local read, feedback = pcall(Http.JSONDecode, Http, vehicle:GetAttribute("EcuFeedback") or "{}")
            local hintsOk, hints = pcall(Http.JSONDecode, Http, vehicle:GetAttribute("EcuHints") or "{}")
            local isAlreadyDone = (read and type(feedback) == "table" and self:TuneComplete(feedback, hintsOk and hints or {}))
            
            if not isAlreadyDone then
                print({ Title = "ระบบจูนทุกคัน", Content = "กำลังเริ่มจูน: " .. tostring(targetVehicleId), Duration = 3 })
                local best = self:ReadTuneFile(vehicle)
                self.Tune.Best = copy(best)
                
                pcall(function()
                    local gain, feedback_val, hints_val = self:Flash(vehicle, best)
                    self.Initial = table.clone(feedback_val)
                    local cached = self.Cache[vehicleId(vehicle)]
                    if cached and cached.signature == signature(vehicle) and validFile(cached.file) then
                        local g, f, h = self:Flash(vehicle, cached.file)
                        local candidate = copy(best)
                        for _, d in ipairs(EcuShared.TABLES) do if (f[d.key] or 0) > (feedback_val[d.key] or 0) then candidate[d.key] = table.clone(cached.file[d.key]) end end
                        best = candidate; gain, feedback_val, hints_val = self:Flash(vehicle, best)
                    end
                    self.Tune.Best = copy(best); self:SaveTune(vehicle, best, gain, feedback_val)
                    
                    best, gain, feedback_val, hints_val = self:OptimizeCoded(vehicle, best, gain, feedback_val, hints_val)
                    self.Tune.Best = copy(best)
                    self.Tune.Round = 0
                    
                    while not self:TuneComplete(self.Tune.Feedback or feedback_val, self.Tune.Hints or hints_val) do
                        self:CheckTune()
                        self.Tune.Round += 1; self.Tune.Stalled = false
                        for _, def in ipairs(EcuShared.TABLES) do
                            self:CheckTune()
                            if not self:TuneMapComplete(def.key, self.Tune.Feedback or feedback_val, self.Tune.Hints or hints_val) then
                                self:Optimize(vehicle, def.key, "fine")
                                if not self:TuneMapComplete(def.key, self.Tune.Feedback, self.Tune.Hints) then
                                    self.Tune.CodedCertified = nil
                                    self:Optimize(vehicle, def.key, "Inverse")
                                end
                            end
                        end
                        self.Tune.CodedCertified = nil
                        if not self:TuneComplete(self.Tune.Feedback, self.Tune.Hints) then
                            self.Tune.Status = "retry"
                            task.wait(.25)
                        end
                    end
                end)

                pcall(function()
                    local gain, feedback_val, hints_val = self:Flash(vehicle, self.Tune.Best, true)
                    self.Tune.Gain = gain; self.Tune.Feedback = feedback_val; self.Tune.Hints = hints_val
                    self:SaveTune(vehicle, self.Tune.Best, gain, feedback_val)
                end)
                print({ Title = "ระบบจูนทุกคัน", Content = "จูนสำเร็จ 100%: " .. tostring(targetVehicleId), Duration = 3 })
            else
                print({ Title = "ระบบจูนทุกคัน", Content = tostring(targetVehicleId) .. " เต็ม 100% แล้ว ข้ามไปคันถัดไป", Duration = 3 })
            end

            tunedVehicles[targetVehicleId] = true

            pcall(function()
                if humanoid and humanoid.SeatPart then
                    if isCar(vehicle) then
                        Net.fire(RS:WaitForChild("CarRemote"), "Exit", vehicle)
                    else
                        Net.fire(RS:WaitForChild("PCX160Remote"), "Dismount", "Start")
                    end
                end
                Net.invoke(Remotes.Garage, "Despawn")
            end)
            task.wait(1.5)
        end

        self.Busy = false
        self.Status = "done"
        print({ Title = "ระบบจูนทุกคัน", Content = "จบการทำงานระบบจูนทุกคันสมบูรณ์!", Duration = 5 })
    end

    task.spawn(function()
        local ok, result = pcall(RuntimeTuneAll.Run, RuntimeTuneAll)
        if not ok then
            RuntimeTuneAll.Busy = false; RuntimeTuneAll.Error = tostring(result); RuntimeTuneAll.Status = "failed"
            print({ Title = "ระบบจูนทุกคัน", Content = "เกิดข้อผิดพลาด: " .. tostring(result), Duration = 5 })
        end
    end)
end

