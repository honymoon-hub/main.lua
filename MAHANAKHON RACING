                                error(doneResult)
                            end
                        end
                        task.wait(0.5)
                    end
                end)

                if not ok then
                    warn("[Auto Mechanic] " .. tostring(err))
                    task.wait(1)
                end
                task.wait(0.2)
            end
        end

        local ok, err = pcall(mechanicStep)
        if not ok then
            warn("[Auto Mechanic] เริ่มระบบไม่สำเร็จ: " .. tostring(err))
        end

        getgenv()._AutoMechanicLoop = false
        getgenv()._MechanicTaskRunning = false
        print("[Auto Mechanic] หยุดระบบแล้ว")
    end)
end

