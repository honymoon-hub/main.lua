-- tracks whether upvalue hook succeeded
local inputHooked = false

local function hookInput(driver)
    check()
    inputHooked = false
    for _, value in _getupvalues(driver.start) do
        if type(value) == "function" and _debuginfo(value, "n") == "step" then
            for index, input in _getupvalues(value) do
                if type(input) == "function" and _debuginfo(input, "n") == "keysToSeat" then
                    for _, patch in inputPatches do if patch.step == value then return end end
                    local replacement = function(state)
                        if state == session then
                            state.seat.ThrottleFloat = Worker.CommandThrottle or 0
                            state.seat.SteerFloat = Worker.CommandSteer or 0
                            if sessionKind=="Bike"then state.wheelieHeld=false end
                        else return input(state)end
                    end
                    table.insert(inputPatches, {step = value, index = index,
                        original = input, replacement = replacement})
                    _setupvalue(value, index, replacement)
                    inputHooked = true
                    return
                end
            end
        end
    end
    -- Mobile fallback: getupvalues returned {} — hook unavailable
    -- Write directly to VehicleSeat every Heartbeat instead
    if not inputHooked and session and session.seat then
        local seat = session.seat
        local hbConn
        hbConn = RunService.Heartbeat:Connect(function()
            -- stop if session changed or worker stopped
            if Worker.Cancelled or not seat.Parent
                or not session or session.seat ~= seat then
                hbConn:Disconnect(); return
            end
            seat.ThrottleFloat = Worker.CommandThrottle or 0
            seat.SteerFloat    = Worker.CommandSteer    or 0
        end)
        table.insert(constraints, hbConn) -- reuse constraints table for cleanup
    end
end

local function tweenCharacterToRoadAndSpawn()
    local char = player.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not humanoid then return end

    -- 1. คำนวณหาตำแหน่งถนนที่ใกล้ที่สุด
    local nearest = Graph.nearest(hrp.Position)
    if nearest then
        local x = math.abs(nearest.X) < 1 and (hrp.Position.X < 0 and -Config.LaneOffset or Config.LaneOffset) or nearest.X
        local roadPos = Vector3.new(x, hrp.Position.Y, nearest.Y)
        print("[AutoRider] กำลังทวีนตัวละครไปกลางถนนแบบช้าๆ นุ่มนวล (Noclip + Float)...")

        -- 2. สร้างระบบ Noclip และ Support Part รองรับใต้เท้า (Float)
        local originals = {}
        local support = Instance.new("Part")
        support.Name = "MahanakhonCharacterFloat"
        support.Size = Vector3.new(5, 1, 5)
        support.Transparency = 0.8
        support.BrickColor = BrickColor.new("Bright green")
        support.Anchored = true
        support.CanCollide = true
        support.Parent = workspace

        local rootHeight = humanoid.HipHeight + hrp.Size.Y * 0.5 + 0.25
        local destination = CFrame.new(roadPos + Vector3.new(0, 0.5, 0)) * hrp.CFrame.Rotation

        local value = Instance.new("CFrameValue")
        value.Value = hrp.CFrame

        local connection
        connection = RunService.Stepped:Connect(function()
            if not char.Parent then return end
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    if originals[part] == nil then originals[part] = part.CanCollide end
                    part.CanCollide = false
                    part.AssemblyLinearVelocity = Vector3.zero
                    part.AssemblyAngularVelocity = Vector3.zero
                end
            end
            hrp.CFrame = value.Value
            if support and support.Parent then
                support.CFrame = CFrame.new(hrp.Position.X, hrp.Position.Y - 3.1, hrp.Position.Z)
            end
        end)

        -- 3. ปรับความเร็วตามแบบ AutoGrabRider.lua (SPEED_PLAYER_TWEEN = 24) ให้เคลื่อนที่ช้าลงกำลังดี ไม่พุ่งเร็วเกินไป
        local SPEED_PLAYER_TWEEN = 24
        local startPos = hrp.Position
        local distance = (roadPos - startPos).Magnitude
        local duration = math.max(1, distance / SPEED_PLAYER_TWEEN)

        local TweenService = game:GetService("TweenService")
        local tween = TweenService:Create(value, TweenInfo.new(duration, Enum.EasingStyle.Linear), {Value = destination})
        tween:Play()
        tween.Completed:Wait()
        task.wait(0.3)

        -- 4. ทำความสะอาดและคืนค่าการชนเดิมหลังทวีนเสร็จ
        if connection then connection:Disconnect() end
        for part, collide in pairs(originals) do
            if part.Parent then part.CanCollide = collide end
        end
        if support then support:Destroy() end
        value:Destroy()
        hrp.AssemblyLinearVelocity = Vector3.zero
        hrp.AssemblyAngularVelocity = Vector3.zero
    end

    -- 5. ดำเนินการเสกรถตามระบบปกติของ Grab.lua
    Worker.ExitedToRoad = true
    if Config.SpawnOnRoad then Worker.ExitedToRoad = false end
    Worker.SpawnOrigin = tostring(hrp.Position)
    
    local ok, message
    for attempt = 1, 3 do
        ok, message = invoke(Remotes.Garage, "Spawn", Config.VehicleId)
        if ok then break end
        task.wait(1.2)
    end
    assert(ok, tostring(message))
    task.wait(0.8)
end

