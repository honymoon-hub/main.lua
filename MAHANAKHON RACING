        if not self.Alive or self.FarmCheckAuto~=state then connection:Disconnect();return end
        if busy or os.clock()-lastCheck<.25 then return end
        lastCheck=os.clock()
        state.Enabled=workEnabled()
        if not state.Enabled then lastButton=nil;lastSignature=nil;state.Status="Work disabled";return end
        local gui=player:FindFirstChildOfClass("PlayerGui")
        local root=gui and gui:FindFirstChild("FarmCheck")
        local outer=root and root:FindFirstChild("Frame")
        local panel=outer and outer:FindFirstChild("Frame")
        local prompt
        if panel and visible(panel) then
            for _,label in ipairs(panel:GetChildren()) do
                if label:IsA("TextLabel") then
                    if label.Text=="🤖 เช็กว่าเป็นคนจริง" or label.Text=="กันโปรฟาร์มอัตโนมัติ · ตอบแล้วทำงานต่อได้เลย ไม่เสียอะไร" then
