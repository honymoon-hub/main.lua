local function GetMoney()
    if not MoneyLabel then
        return 0
    end
    local Text = MoneyLabel.ContentText or ""
    local Number = Text:gsub("[^%d]", "")

    return tonumber(Number) or 0
end
local function SendRequest(url, method, body)
    if WebhookDisabled or not HttpRequest then return nil end
    return HttpRequest({
        Url = url,
        Method = method,
        Headers = {
            ["Content-Type"] = "application/json"
        },
        Body = HttpService:JSONEncode(body)
    })
end
local function UpdateDiscord(money, difference, status)
    if Pending then
        return
    end
    Pending = true
    local Payload = {
        embeds = {{
            title = "💰 MONEY TRACKER - LIVE",

            color = difference > 0 and 5763719
                or difference < 0 and 15548997
                or 3447003,

            fields = {

                {
                    name = "👤 Player",
                    value = player.Name,
                    inline = true
                },
                {
                    name = "🌐 Player Status",
                    value = PlayerStatus,
                    inline = true
                },

                {
                    name = "📋 Exit Reason",
                    value = LastExitReason,
                    inline = true
                },

                {
                    name = "🆔 User ID",
                    value = tostring(player.UserId),
                    inline = true
                },

                {
                    name = "💵 Money",
                    value = "$" .. tostring(money),
                    inline = false
                },

                {
                    name = "📊 Last Change",
                    value = (difference >= 0 and "+" or "")
                        .. tostring(difference),
                    inline = true
                },

                {
                    name = "📌 Status",
                    value = status,
                    inline = true
                }
            },

            footer = {
                text = "WindUI Money Tracker"
            },

            timestamp = DateTime.now():ToIsoDate()
        }}
    }

    local Success, Response = pcall(function()

        if MessageID then

            return SendRequest(
                Webhook .. "/messages/" .. MessageID,
                "PATCH",
                Payload
            )

        else

            return SendRequest(
                Webhook .. "?wait=true",
                "POST",
                Payload
            )

        end

    end)

    if Success and Response then

        if Response.StatusCode >= 200
            and Response.StatusCode < 300 then

            if not MessageID and Response.Body then

                local DecodeSuccess, Data = pcall(function()
                    return HttpService:JSONDecode(Response.Body)
                end)

                if DecodeSuccess and Data.id then
                    MessageID = Data.id
                end

            end

            print("[MoneyTracker] Discord Updated")

        else

            warn(
                "[MoneyTracker] HTTP Error:",
                Response.StatusCode,
                Response.Body
            )

        end

    else

        warn("[MoneyTracker] Request Failed:", Response)

    end

    Pending = false
end
local function DetectExitReason(Text)
    Text = string.lower(Text)

    if Text:find("ban", 1, true) then
        return "⛔ BANNED"
    elseif Text:find("kick", 1, true)
        or Text:find("removed from the game", 1, true) then
        return "🔴 KICKED"
    elseif Text:find("disconnect", 1, true)
        or Text:find("connection", 1, true) then
        return "⚫ DISCONNECTED"
    end

    return nil
end

local function StartStatusTracker()
    if StatusConnection then
        return
    end

    StatusConnection = CoreGui.DescendantAdded:Connect(function(Object)
        if not Tracking or not Object:IsA("TextLabel") then
            return
        end

        local Reason = DetectExitReason(Object.Text or "")

        if Reason then
            PlayerStatus = Reason
            LastExitReason = Object.Text

            UpdateDiscord(
                CurrentMoney,
                LastDifference,
                "PLAYER EXITED"
            )
        end
    end)
end

local function StopStatusTracker()
    if StatusConnection then
        StatusConnection:Disconnect()
        StatusConnection = nil
    end
end
local function StartTracker()

    if Tracking then
        return
    end

    Tracking = true
        PlayerStatus = "🟢 ONLINE"
        LastExitReason = "None"

        StartStatusTracker()
    MoneyLabel = player:WaitForChild("PlayerGui")
        :WaitForChild("GameHud")
        :WaitForChild("Left")
        :WaitForChild("Money")
        :WaitForChild("Amount")

    LastMoney = GetMoney()
    CurrentMoney = LastMoney

    print("[MoneyTracker] Started")

    UpdateDiscord(
        CurrentMoney,
        0,
        "STARTED"
    )

    MoneyConnection =
        MoneyLabel:GetPropertyChangedSignal("ContentText"):Connect(function()

            if not Tracking then
                return
            end

            local NewMoney = GetMoney()

            if NewMoney == LastMoney then
                return
            end

            local Difference = NewMoney - LastMoney

            LastMoney = NewMoney
            CurrentMoney = NewMoney
            LastDifference = Difference

            local Status = Difference > 0
                and "MONEY RECEIVED"
                or "MONEY SPENT"

            print("Money:", NewMoney)
            print("Change:", Difference)

            UpdateDiscord(
                NewMoney,
                Difference,
                Status
            )

        end)

end
local function StopTracker()

    if not Tracking then
        return
    end

    Tracking = false
    StopStatusTracker()
    if MoneyConnection then
        MoneyConnection:Disconnect()
        MoneyConnection = nil
    end

    print("[MoneyTracker] Stopped")

    UpdateDiscord(
        CurrentMoney,
        0,
        "STOPPED"
    )

end


