                vehicle:PivotTo(CFrame.new(811.6, 5, 77))
                task.wait(0.3)

                humanoid.Sit = false
                task.wait(0.2)
                root.CFrame = CFrame.new(811.6, 5, 77)
            else
                warn("[Auto Mechanic] ไม่พบรถหรือ VehicleSeat; ข้ามขั้นตอนย้ายรถ")
            end

            -- 3) ลงทะเบียนอาชีพช่างและเปลี่ยนชุด
            local planOk, planResult = pcall(function()
                return NetSeal.invoke(remJob, "Plan", "Mechanic")
            end)
            if not planOk then
                error("Register Mechanic job failed: " .. tostring(planResult))
            end
            task.wait(0.3)

            local mechanicLocker = workspace:WaitForChild("Map")
                :WaitForChild("JobLockers")
                :WaitForChild("Locker_Mechanic")
            local lockerPrompt = mechanicLocker.Cabinet:WaitForChild("LockerPrompt")
            local character = lp.Character or lp.CharacterAdded:Wait()
            local root = character:WaitForChild("HumanoidRootPart")

            root.CFrame = mechanicLocker.Cabinet.CFrame + Vector3.new(0, 0, 2)
            task.wait(0.3)
            if typeof(fireproximityprompt) == "function" then
                fireproximityprompt(lockerPrompt)
            else
                lockerPrompt:InputHoldBegin()
                task.wait(math.max(0.2, lockerPrompt.HoldDuration))
                lockerPrompt:InputHoldEnd()
            end
            task.wait(0.5)

            -- 4) วนรับงานช่างและซ่อมรถ
            print("[Auto Mechanic] เริ่มระบบฟาร์มอัตโนมัติ...")
            while getgenv()._AutoMechanicLoop do
                local ok, err = pcall(function()
                    local nextAt = lp:GetAttribute("WorkNextAt") or 0
                    local now = workspace:GetServerTimeNow()
                    if now < nextAt then
                        task.wait(math.clamp(nextAt - now, 0.2, 5))
                        return
                    end

                    local taskStr = lp:GetAttribute("WorkTask")
                    local taskData
                    if taskStr and #taskStr > 0 then
                        local decodeOk, decoded = pcall(function()
                            return HttpService:JSONDecode(taskStr)
                        end)
                        if decodeOk then
                            taskData = decoded
                        end
                    end

                    -- ยังไม่มีงาน: รับงานจากกระดาน
                    if not taskData then
                        local board = getRepairPrompt("Board")
                        if board then
                            hold(board)
                        else
                            task.wait(1)
                        end
                        return
                    end

                    -- มีงานแล้ว: ไปเริ่มงานที่ช่องซ่อม
                    if taskData.step == "go" or taskData.step == "start" then
                        local station = getRepairPrompt(taskData.station)
                        if station then
                            hold(station)
                        else
                            task.wait(1)
                        end
                        return
                    end

                    -- อยู่ระหว่างซ่อม: รอคูลดาวน์แล้วส่งผลสำเร็จ
                    if taskData.step == "doing" then
