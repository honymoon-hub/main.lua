    end
    getgenv()._MechanicTaskRunning = true

    task.spawn(function()
        local function mechanicStep()
            -- 1) เสกรถ PCX160
            local spawnOk, spawnResult = pcall(function()
                return NetSeal.invoke(remGarage, "Spawn", "PCX160")
            end)
            if not spawnOk then
