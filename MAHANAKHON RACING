    Title = "เปิด/ปิดการทำงาน (Enabled)",
    Desc = "สลับสถานะการเปิดหรือปิดระบบ Grab หลัก",
    Value = Config.GrabEnabled == true,
    Default = Config.GrabEnabled == true,
    Callback = function(state)
        SetConfig("GrabEnabled", state)
        Enabled = state
        print("Grab Enabled:", Enabled)
        AntiAFK()
        if state then
            -- โค้ดสั่งเริ่มรัน Grab ที่นี่
            if not Runtime.GrabRunning then
                Runtime.GrabRunning = true
                task.spawn(function()
                    while Enabled and Runtime.Alive do
                        
                        local worker = newDriver()
                        Runtime.Grab = worker
                        local ok, reason = pcall(worker.Run)
                        if not Runtime.Alive or not Enabled then break end
                        worker.Shutdown()
                        task.wait(2)
                    end
                    Runtime.GrabRunning = false
                end)
            end
        else
            -- โค้ดสั่งหยุด Grab
            Enabled = false
            if Runtime.Grab then
                Runtime.Grab.Shutdown()
            end
        end
    end
})
