        end
    end
    if cancelled()then return end
    if jobId=="Grab"and not resetCharacter and oldSession and oldSession.model.Parent then
        status("Bringing crashed vehicle back")
        local accepted,reason=Net.invoke(Remotes.TuneShop,"Bring",oldSession.model)
