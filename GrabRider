        Worker.NeedsFreshVehicle=false;Worker.NoWalk=false;Worker.ExitedToRoad=true
        task.wait(.6);return
    end
    if preserveFare then

        Worker.NeedsFreshVehicle=false;Worker.NoWalk=true
        return
    end
    local list
    local oldVehicle=oldSession and oldSession.model
