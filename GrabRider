function Worker.MoveCharacterToRoad()
    check();assert(not session,"Dismount before road departure")
    local character=player.Character;local humanoid=character.Humanoid;local root=character.HumanoidRootPart
    assert(not humanoid.SeatPart,"Dismount before road departure")
    local nearest=assert(Graph.nearest(root.Position),"No nearby road")

    local x=math.abs(nearest.X)<1 and(root.Position.X<0 and-Config.LaneOffset or Config.LaneOffset)or nearest.X
    local goal=Vector3.new(x,root.Position.Y,nearest.Y)
    if flat(goal-root.Position).Magnitude>24 then pcall(player.RequestStreamAroundAsync,player,goal,2)end
    local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Include;params.RespectCanCollide=true
    params.FilterDescendantsInstances={workspace.Map.Road,workspace.Map:FindFirstChild("Network")or workspace.Map.Road}
    local ground=workspace:Raycast(goal+Vector3.new(0,20,0),Vector3.new(0,-80,0),params)
    assert(ground and ground.Normal.Y>.7,"No spawn ground")
    local position=ground.Position+Vector3.new(0,humanoid.HipHeight+root.Size.Y/2,0)
    if flat(root.Position-position).Magnitude>24 then Worker.StageCharacterTowardRoad(position,24)end
    status("Moving to road before spawning")
    local offset=root.CFrame:ToObjectSpace(character:GetPivot())
    character:PivotTo((CFrame.new(position)*root.CFrame.Rotation)*offset)
    humanoid:MoveTo(root.Position);humanoid:Move(Vector3.zero,false)
    root.AssemblyLinearVelocity=Vector3.zero;root.AssemblyAngularVelocity=Vector3.zero
    task.wait(.3);check()
    assert(flat(root.Position-position).Magnitude<8,"Spawn drift")
    Worker.RoadSpawnReady=true;Worker.RoadSpawnPosition=tostring(root.Position)
end

function Worker.ExitToRoad(target)
    local position=session.chassis.Position
    if jobId=="Grab"then
        local params=RaycastParams.new();params.FilterType=Enum.RaycastFilterType.Include
        params.FilterDescendantsInstances={workspace.Map.Road};params.RespectCanCollide=true
        local floor=workspace:Raycast(position+Vector3.new(0,3,0),Vector3.new(0,-14,0),params)
        if floor and floor.Normal.Y>.7 and floor.Material==Enum.Material.Asphalt then
            Worker.ExitedToRoad=true;return
        end
    end
    local nearest=Graph.nearest(position)
    assert(nearest,"Road entrance unavailable")
    local goal=Vector3.new(nearest.X,position.Y,nearest.Y)
    if math.abs(goal.X)<1 then goal=Vector3.new(position.X<0 and-Config.LaneOffset or Config.LaneOffset,position.Y,goal.Z)end
    local distance=flat(goal-position).Magnitude
    if jobId=="Grab"and distance>=180 then

        Worker.ExitedToRoad=true;Worker.SkippedParkingExit=true;return
    end
    assert(distance<180,"Spawn point too far from road")
    status("Seated; moving to road")
    local steps=math.max(1,math.ceil(distance/30))
    for i=1,steps do
        check()
        local waypoint=position:Lerp(goal,i/steps)
        if flat(waypoint-session.chassis.Position).Magnitude>2 then
            Worker.DepartingRoad=true
            local moved,result=pcall(tweenVehiclePast,nil,waypoint-session.chassis.Position,waypoint)
            Worker.DepartingRoad=false
            assert(moved and result,"Exit failed; move vehicle")
        end
    end
    local points=laneRoute(target)
    for _,point in ipairs(points)do
        local direction=Vector3.new(point.X-session.chassis.Position.X,0,point.Y-session.chassis.Position.Z)
        if direction.Magnitude>8 then
            Worker.FaceDirection(direction)
            break
        end
    end
    Worker.ExitedToRoad=true
end

function Worker.TestDrive(target)
    assert(not Worker.Running, "Already running")
    Worker.Running, Worker.Cancelled, Worker.PeakSpeed = true, false, 0
    local ok, message = xpcall(function()
        Config.GeneralTravelTween=true
        Worker.PrepareTravelDeparture()
        readyRide()
        Worker.DriveTo(target, "Driving to workplace")
    end, tostring)
    brake()
    restore()
    Worker.Running = false
    return {
        ok = ok, message = message, peakSpeed = Worker.PeakSpeed,
        limits = Worker.Limits, brakeSpeed = Worker.LastBrakeSpeed,
        remaining = session and (flat(session.chassis.Position) - flat(target)).Magnitude,
        position = session and tostring(session.chassis.Position),
        owner = session and isnetworkowner(session.chassis),
    }
end

    return Worker
end

