-- =====================================================================
-- SMART BAG MANAGEMENT ENGINE (Autonomous Town Trip & Multi-Sell)
-- =====================================================================
local function performSmartBagClean(force)
	local bagUsed = tonumber(LocalPlayer:GetAttribute("BagSlotsUsed")) or 0
	local bagMax = tonumber(LocalPlayer:GetAttribute("BagSlotsMax")) or 120
	local bagRatio = bagUsed / math.max(1, bagMax)

	-- If not currently cleaning and bag is not full, do nothing
	if not runtime.isCleaningBag then
		if not force and (bagRatio < 0.85 and bagUsed < 95) then
			return false
		end
		runtime.isCleaningBag = true
	end

	local _, root = characterParts()
	local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
	if not root or not hum then
		runtime.isCleaningBag = false
		return false
	end

	-- Clean up combat hover velocity immediately so character drops to ground level
	local bv = root:FindFirstChild("PayomboyZ_HoverVelocity")
	if bv then bv:Destroy() end
	setNoclip(false)

	-- Crucial: Disarm native bot so it doesn't fight town movement!
	if LocalPlayer:GetAttribute("AutoOn") == true then
		pcall(function()
			local pgui = LocalPlayer:FindFirstChild("PlayerGui")
			local la = pgui and pgui:FindFirstChild("LumiAuto")
			local autoBtn = la and la:FindFirstChild("AutoButton")
			if autoBtn and firesignal then firesignal(autoBtn.MouseButton1Click) end
		end)
	end

	setPlayerTarget(nil)
	runtime.currentTarget = nil

	local merchantPos = Vector3.new(-50.4, 4.2, 32.5)
	local distToMerchant = (root.Position - merchantPos).Magnitude

	-- If not close to merchant, navigate directly to merchant in Town and hold cleaning state
	if distToMerchant > 12 then
		runtime.targetName = string.format("🎒 กระเป๋าเต็ม (%d/%d) กำลังเดินทางไปหาพ่อค้าในเมือง...", bagUsed, bagMax)
		runtime.targetHp = 0
		runtime.targetMaxHp = 0
		local curZ = getCurrentZone(root.Position.Z)
		if curZ ~= "Town" then
			safeTravelToZone("Town")
		end
		root.CFrame = CFrame.new(merchantPos + Vector3.new(0, 1, 3))
		root.AssemblyLinearVelocity = Vector3.zero
		return true -- Stay in cleaning state! Blocks combat and zone transit until fully sold!
	end

	-- Arrived at Merchant!
	runtime.targetName = "🎒 กำลังขายของและเคลียร์กระเป๋า..."
	hum:Move(Vector3.zero, false)

	-- 1. Sell all junk monster drops
	pcall(function()
		local sellJunk = Remotes:FindFirstChild("ShopSellJunk")
		if sellJunk then sellJunk:FireServer() end
	end)
	task.wait(0.2)

	-- 2. Analyze unequipped gear, keep only top 2-3 items per category
	pcall(function()
		local gearJson = LocalPlayer:GetAttribute("GearJson")
		local equipJson = LocalPlayer:GetAttribute("EquipJson")
		local wId = LocalPlayer:GetAttribute("WeaponId")
		local eq = (type(equipJson) == "string" and equipJson ~= "") and HttpService:JSONDecode(equipJson) or {}
		local gears = (type(gearJson) == "string" and gearJson ~= "") and HttpService:JSONDecode(gearJson) or {}

		local eqKeys = {}
		for _, k in pairs(eq) do eqKeys[k] = true end
		if wId then eqKeys[wId] = true end

		local bySlot = {}
		for gKey, gInfo in pairs(gears) do
			if not eqKeys[gKey] then
				local itemDef = ItemData and ItemData[gInfo.Id]
				local slot = itemDef and (itemDef.Slot or itemDef.Kind) or "Other"
				if not bySlot[slot] then bySlot[slot] = {} end

				local tier = gInfo.T or (itemDef and itemDef.Tier) or 1
				local refine = gInfo.R or 0
				local main = gInfo.M or 0
				local reqLv = itemDef and itemDef.ReqLevel or 0
				local score = (tier * 1000) + (refine * 100) + (main * 10) + reqLv

				table.insert(bySlot[slot], {
					Key = gKey,
					Score = score,
					Tier = tier,
					Refine = refine
				})
			end
		end

		local toSell = {}
		for slot, list in pairs(bySlot) do
			table.sort(list, function(a, b) return a.Score > b.Score end)
			local keepCount = (slot == "Acc") and 4 or 2
			for i = keepCount + 1, #list do
				table.insert(toSell, { list[i].Key, 1 })
			end
		end

		if #toSell > 0 then
			local sellMany = Remotes:FindFirstChild("ShopSellMany")
			if sellMany then
				sellMany:FireServer(toSell)
			else
				for _, item in ipairs(toSell) do
					Remotes.ShopSell:FireServer(item[1], 1)
				end
			end
		end
	end)
	task.wait(0.3)

	-- 3. Check & Restock Potions if low
	pcall(function()
		local itemsJson = LocalPlayer:GetAttribute("ItemsJson")
		local hasRed = type(itemsJson) == "string" and itemsJson:find("red_potion")
		local hasBlue = type(itemsJson) == "string" and itemsJson:find("blue_potion")
		local shopBuy = Remotes:FindFirstChild("ShopBuy")
		if shopBuy then
			if not hasRed then shopBuy:FireServer("red_potion_m", 30) end
			if not hasBlue then shopBuy:FireServer("blue_potion_m", 30) end
		end
	end)

	runtime.isCleaningBag = false
	runtime.lastBagCleanCheck = tick()
	runtime.targetName = "None"
	return true
end

-- =====================================================================
-- ADVANCED AUTO REFINE ENGINE (ระบบตีบวกอุปกรณ์ขั้นสูง)
-- =====================================================================
local function findRefineCandidate(mode, gears, equips, items)
	mode = mode or Flags.RefineTargetMode or "⚔️ อาวุธที่สวมใส่อยู่ (Equipped Weapon)"
	local maxLevel = Flags.RefineMaxLevel or 7

	if not gears then
		local gearJsonStr = LocalPlayer:GetAttribute("GearJson")
		gears = (type(gearJsonStr) == "string" and gearJsonStr ~= "") and HttpService:JSONDecode(gearJsonStr) or {}
	end
	if not equips then
		local equipJsonStr = LocalPlayer:GetAttribute("EquipJson")
		equips = (type(equipJsonStr) == "string" and equipJsonStr ~= "") and HttpService:JSONDecode(equipJsonStr) or {}
	end
	if not items then
		local itemsJsonStr = LocalPlayer:GetAttribute("ItemsJson")
		items = (type(itemsJsonStr) == "string" and itemsJsonStr ~= "") and HttpService:JSONDecode(itemsJsonStr) or {}
	end

	local weaponId = LocalPlayer:GetAttribute("WeaponId")

	-- 1. Mode: Equipped Weapon
	if mode:find("อาวุธที่สวมใส่") or mode:find("Equipped Weapon") then
		if weaponId and weaponId ~= "" then
			if gears[weaponId] then
				local curL = gears[weaponId].R or 0
				if curL < maxLevel then
					local itemDef = ItemData and ItemData[gears[weaponId].Id]
					return weaponId, itemDef or gears[weaponId], curL
				end
			elseif items[weaponId] and items[weaponId] > 0 then
				local itemDef = ItemData and ItemData[weaponId]
				return weaponId, itemDef or { Name = weaponId }, 0
			end
		end
		local eqKey = equips.Weapon or equips.weapon or equips[1]
		if eqKey and gears[eqKey] then
			local curL = gears[eqKey].R or 0
			if curL < maxLevel then
				local itemDef = ItemData and ItemData[gears[eqKey].Id]
				return eqKey, itemDef or gears[eqKey], curL
			end
		end
		-- Fallback to any weapon in gears
		for gKey, gInfo in pairs(gears) do
			local itemDef = ItemData and ItemData[gInfo.Id]
			if itemDef and (itemDef.Kind == "weapon" or itemDef.Slot == "Weapon") then
				local curL = gInfo.R or 0
				if curL < maxLevel then
					return gKey, itemDef or gInfo, curL
				end
			end
		end
	end

	-- 2. Mode: All Equipped Gear
	if mode:find("อุปกรณ์สวมใส่ทั้งหมด") or mode:find("All Equipped") then
		for slot, gKey in pairs(equips) do
			if type(gKey) == "string" and gears[gKey] then
				local curL = gears[gKey].R or 0
				if curL < maxLevel then
					local itemDef = ItemData and ItemData[gears[gKey].Id]
					return gKey, itemDef or gears[gKey], curL
				end
			end
		end
	end

	-- 3. Mode: All Weapons in Bag
	if mode:find("อาวุธทั้งหมดในกระเป๋า") or mode:find("All Weapons") then
		for gKey, gInfo in pairs(gears) do
			local itemDef = ItemData and ItemData[gInfo.Id]
			if itemDef and (itemDef.Kind == "weapon" or itemDef.Slot == "Weapon") then
				local curL = gInfo.R or 0
				if curL < maxLevel then
					return gKey, itemDef or gInfo, curL
				end
			end
		end
	end

	-- 4. Mode: Highest Tier Gear
	if mode:find("ระดับสูงสุด") or mode:find("Highest Tier") then
		local bestKey, bestDef, bestTier, bestLevel = nil, nil, -1, 99
		for gKey, gInfo in pairs(gears) do
			local itemDef = ItemData and ItemData[gInfo.Id]
			local tier = gInfo.T or (itemDef and itemDef.Tier) or 1
			local curL = gInfo.R or 0
			if curL < maxLevel and tier > bestTier then
				bestTier = tier
				bestKey = gKey
				bestDef = itemDef or gInfo
				bestLevel = curL
			end
		end
		if bestKey then
			return bestKey, bestDef, bestLevel
		end
	end

	-- General fallback: any gear under maxLevel
	for gKey, gInfo in pairs(gears) do
		local curL = gInfo.R or 0
		if curL < maxLevel then
			local itemDef = ItemData and ItemData[gInfo.Id]
			return gKey, itemDef or gInfo, curL
		end
	end

	-- Tutorial / Wooden knife fallback
	if weaponId and weaponId ~= "" then
		return weaponId, { Name = weaponId }, 0
	end
	return "knife_wood", { Name = "Wooden Knife" }, 0
end

local function refineTargetOnce()
	local targetKey, targetDef, currentLevel = findRefineCandidate()
	if not targetKey then
		runtime.refineStatus = "ไม่พบอุปกรณ์ที่ตรงตามเงื่อนไข (หรือตีบวกครบเป้าหมายแล้ว)"
		return false
	end

	local itemsJsonStr = LocalPlayer:GetAttribute("ItemsJson")
	local items = (type(itemsJsonStr) == "string" and itemsJsonStr ~= "") and HttpService:JSONDecode(itemsJsonStr) or {}
	local silver = tonumber(LocalPlayer:GetAttribute("Silver")) or 0

	if (items.refine_stone or 0) < 1 then
		if Flags.RefineAutoBuyStones and silver >= 1000 then
			runtime.refineStatus = "หินตีบวกหมด กำลังซื้อหินจากร้านค้า..."
			pcall(function() Remotes.ShopBuy:FireServer("refine_stone", 5) end)
			task.wait(0.3)
		else
			runtime.refineStatus = "❌ หินตีบวกหมด (Out of Refine Stones)"
			return false
		end
	end

	local useProt = false
	if Flags.RefineUseProtection and (currentLevel or 0) >= (Flags.RefineProtThreshold or 4) then
		if (items.protection_stone or 0) > 0 then
			useProt = true
		end
	end

	local useLucky = (Flags.RefineUseLucky == true and (items.blessed_stone or 0) > 0)

	runtime.refineStatus = string.format("🔨 กำลังตีบวก %s (+%d -> +%d)...", tostring(targetDef.Name or targetKey), currentLevel or 0, (currentLevel or 0) + 1)
	pcall(function()
		Remotes.RefineWeapon:FireServer(targetKey, useProt, useLucky, true)
	end)

	return true
end

