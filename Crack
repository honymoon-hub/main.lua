-- =====================================================================
-- FEATURE API (Session Lifecycle)
-- =====================================================================
local function createFeatureAPI(ns)
	local env = getgenv and getgenv() or _G
	local prev = env[ns]
	if prev and type(prev.Unload) == "function" then
		pcall(prev.Unload)
	end

	local cleanup = {}
	local API = {
		Unloaded = false,
		Connections = {},
		Tasks = {},
		State = {},
	}

	function API.Defer(d)
		if API.Unloaded then pcall(d) else table.insert(cleanup, d) end
	end

	function API.Unload()
		if API.Unloaded then return end
		API.Unloaded = true
		for i = #cleanup, 1, -1 do pcall(table.remove(cleanup, i)) end
		pcall(function()
			local lp = Players.LocalPlayer
			local char = lp and lp.Character
			local r = char and char:FindFirstChild("HumanoidRootPart")
			if r then
				local bv = r:FindFirstChild("PayomboyZ_HoverVelocity")
				if bv then bv:Destroy() end
			end
		end)
		table.clear(API.State)
	end

	env[ns] = API
	return API
end

