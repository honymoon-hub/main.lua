-- Translate UI / human friendly slot names to internal game slot names
local function normalizeCardSlot(slot)
	if not slot then return "Weapon" end
	local s = tostring(slot)
	if s:find("Weapon") then return "Weapon" end
	if s:find("RightHand") then return "RightHand" end
	if s:find("Body") or s:find("Armor") then return "Body" end
	if s:find("Shoes") or s:find("Boots") then return "Shoes" end
	if s:find("Garment") then return "Garment" end
	if s:find("HeadTop") or s:find("Head") then return "HeadTop" end
	if s:find("HeadMid") then return "HeadMid" end
	if s:find("Acc1") or s == "Acc" then return "Acc1" end
	if s:find("Acc2") or s:find("Acc3") then return "Acc2" end
	return s
end

-- Scan all cards owned by player from GearJson / ItemsJson
local function getOwnedCards()
	local cards = {}
	pcall(function()
		local itemsJsonStr = LocalPlayer:GetAttribute("ItemsJson")
		local items = (type(itemsJsonStr) == "string" and itemsJsonStr ~= "") and HttpService:JSONDecode(itemsJsonStr) or {}
		for itemId, qty in pairs(items) do
			local qty_n = tonumber(qty) or 0
			if qty_n > 0 then
				local def = ItemData and ItemData[itemId]
				local isCard = def and (def.Type == "card" or def.Kind == "card" or tostring(itemId):find("card") or tostring(def.Name or ""):lower():find("card"))
				if not isCard and tostring(itemId):sub(1,5) == "card_" then isCard = true end
				if isCard then
					table.insert(cards, {
						Id = itemId,
						Name = (def and def.Name) or itemId,
						Qty = qty_n,
						Def = def,
					})
				end
			end
		end
		-- Also check CardData if exists
		local cardData = Shared:FindFirstChild("CardData")
		if cardData then
			local cd = pcall(require, cardData) and require(cardData) or nil
			if cd and type(cd) == "table" then
				for cardId, cDef in pairs(cd.Cards or cd) do
					if type(cDef) == "table" then
						local owned = (items[cardId] or 0)
						if owned > 0 then
							local alreadyIn = false
							for _, c in ipairs(cards) do if c.Id == cardId then alreadyIn = true break end end
							if not alreadyIn then
								table.insert(cards, { Id = cardId, Name = (cDef.Name or cardId), Qty = owned, Def = cDef })
							end
						end
					end
				end
			end
		end
	end)
	return cards
end

