-- MASTER ORCHESTRATION PIPELINE
-- =====================================================================
local function stepMasterKaitun()
	local kaitunOn = (Flags.MasterKaitun == true)
	local autoFarmOn = (Flags.AutoFarm == true)

	-- Subsystem authorizations: Directly linked to their individual UI toggles
	local farmEnabled = (kaitunOn and Flags.KaitunAutoFarm) or (not kaitunOn and autoFarmOn)
	local potionHpEnabled = (kaitunOn and Flags.KaitunAutoPotions and Flags.AutoPotionHp) or (not kaitunOn and Flags.AutoPotionHp)
	local potionSpEnabled = (kaitunOn and Flags.KaitunAutoPotions and Flags.AutoPotionSp) or (not kaitunOn and Flags.AutoPotionSp)
	local respawnEnabled = (kaitunOn and Flags.KaitunAutoRespawn and Flags.AutoRespawn) or (not kaitunOn and Flags.AutoRespawn)
	local lootEnabled = (kaitunOn and Flags.KaitunAutoLoot and Flags.AutoLoot) or (not kaitunOn and Flags.AutoLoot)
	local questEnabled = (kaitunOn and (Flags.KaitunAutoQuest or Flags.KaitunAutoRewards) and (Flags.AutoQuest or Flags.AutoClaimQuest)) or (not kaitunOn and (Flags.AutoQuest or Flags.AutoClaimQuest))
	local statEnabled = (kaitunOn and Flags.KaitunAutoStat and Flags.AutoStat) or (not kaitunOn and Flags.AutoStat)
	local skillEnabled = (kaitunOn and Flags.KaitunAutoSkill and Flags.AutoSkillTree) or (not kaitunOn and Flags.AutoSkillTree)
	local equipEnabled = (kaitunOn and Flags.KaitunAutoEquip and Flags.AutoEquipBest) or (not kaitunOn and Flags.AutoEquipBest)
	local refineEnabled = Flags.AutoRefine
	local skillCombatEnabled = (kaitunOn and Flags.AutoSkillCombat) or (not kaitunOn and Flags.AutoSkillCombat)

	local _, root, hum = characterParts()

	-- If farming is disabled and MasterKaitun is off, halt combat, clear targets, stop walking, and idle
	if not farmEnabled then
		if runtime.currentTarget then
			setPlayerTarget(nil)
			runtime.currentTarget = nil
			runtime.targetName = "⏹️ ปิดการทำงานแล้ว (Bot Idle)"
			runtime.targetHp = 0
			runtime.targetMaxHp = 0
		end
		if LocalPlayer:GetAttribute("AutoOn") == true then
			pcall(function()
				local pgui = LocalPlayer:FindFirstChild("PlayerGui")
				local la = pgui and pgui:FindFirstChild("LumiAuto")
				local autoBtn = la and la:FindFirstChild("AutoButton")
				if autoBtn and firesignal then firesignal(autoBtn.MouseButton1Click) end
			end)
		end
		if hum then hum:Move(Vector3.zero, false) end
		if root then
			root.AssemblyLinearVelocity = Vector3.zero
			local bv = root:FindFirstChild("PayomboyZ_HoverVelocity")
			if bv then bv:Destroy() end
		end
		setNoclip(false)

		-- Standalone survival/respawn when MasterKaitun and AutoFarm are off
		if not kaitunOn and not autoFarmOn then
			local isDead = (not hum or hum.Health <= 0)
			if isDead and respawnEnabled then
				local rMode = tostring(Flags.RespawnMode or "")
				local respawnTarget = rMode:find("here") and "here" or "town"
				pcall(function() RespawnChoice:FireServer(respawnTarget) end)
			end
			return
		end
	end

	-- 1. INSTANT AUTO RESPAWN
	local isDead = (not hum or hum.Health <= 0)
	if isDead then
		runtime.currentTarget = nil
		runtime.targetName = "💀 กำลังเกิดใหม่ (Auto Respawn)..."
		if respawnEnabled then
			local rMode = tostring(Flags.RespawnMode or "")
			local respawnTarget = rMode:find("here") and "here" or "town"
			pcall(function() RespawnChoice:FireServer(respawnTarget) end)
			pcall(function()
				local pgui = LocalPlayer:FindFirstChild("PlayerGui")
				local huntRespawn = pgui and pgui:FindFirstChild("HuntRespawn")
				if huntRespawn and huntRespawn.Enabled then
					local holder = huntRespawn:FindFirstChild("Holder")
					if holder then
						for _, b in ipairs(holder:GetDescendants()) do
							if b:IsA("GuiButton") then
								for _, lbl in ipairs(b:GetDescendants()) do
									if (lbl:IsA("TextLabel") or lbl:IsA("TextBox")) and lbl.Text:lower():find(respawnTarget) then
										if firesignal then firesignal(b.MouseButton1Click) end
									end
								end
							end
						end
					end
				end
			end)
		end
		return
	end

	if not root or not hum then return end

	-- VOID & FALL PROTECTION (ระบบป้องกันตกแมพ 100%)
	if root.Position.Y < -5.0 then
		local curZone = getCurrentZone(root.Position.Z)
		local safePos = ZonePositions[curZone] or ZonePositions.Town
		local map = Workspace:FindFirstChild("Map")
		local warps = map and map:FindFirstChild("Warps")
		local warpPart = warps and warps:FindFirstChild("Warp_" .. curZone)
		if warpPart then
			root.CFrame = warpPart.CFrame + Vector3.new(0, 3.5, 0)
		else
			root.CFrame = CFrame.new(safePos.X, safePos.Y + 3.5, safePos.Z)
		end
		root.AssemblyLinearVelocity = Vector3.zero
		if hum then hum:Move(Vector3.zero, false) end
		return
	end

	local now = tick()

	-- 2. SURVIVAL: AUTO POTIONS (Connected to UI Sliders & Types)
	if potionHpEnabled and (now - runtime.lastPotionHp > 0.4) then
		local hpRatio = hum.Health / math.max(1, hum.MaxHealth)
		local hpThresh = (tonumber(Flags.HpPercent) or 75) / 100
		if hpRatio <= hpThresh then
			runtime.lastPotionHp = now
			local pType = tostring(Flags.HpPotionType or "")
			if pType:find("เล็ก") then
				pcall(function() UseItem:FireServer("red_potion") end)
			elseif pType:find("กลาง") then
				pcall(function() UseItem:FireServer("red_potion_m") end)
			elseif pType:find("ใหญ่") then
				pcall(function() UseItem:FireServer("red_potion_l") end)
			else
				pcall(function()
					UseItem:FireServer("red_potion_l")
					UseItem:FireServer("red_potion_m")
					UseItem:FireServer("red_potion")
				end)
			end
		end
	end

	if potionSpEnabled and (now - runtime.lastPotionSp > 0.6) then
		local sp = tonumber(LocalPlayer:GetAttribute("SP")) or 100
		local maxSp = tonumber(LocalPlayer:GetAttribute("MaxSP")) or 100
		local spThresh = (tonumber(Flags.SpPercent) or 40) / 100
		if (sp / math.max(1, maxSp)) <= spThresh then
			runtime.lastPotionSp = now
			local pType = tostring(Flags.SpPotionType or "")
			if pType:find("เล็ก") then
				pcall(function() UseItem:FireServer("blue_potion") end)
			elseif pType:find("กลาง") then
				pcall(function() UseItem:FireServer("blue_potion_m") end)
			elseif pType:find("ใหญ่") then
				pcall(function() UseItem:FireServer("blue_potion_l") end)
			else
				pcall(function()
					UseItem:FireServer("blue_potion_l")
					UseItem:FireServer("blue_potion_m")
					UseItem:FireServer("blue_potion")
				end)
			end
		end
	end

	-- 3. AUTO QUEST ENGINE: CLAIM & ADVANCE BY LEVEL
	-- 3. AUTO QUEST ENGINE: FULL RESOLVER (TUTORIAL, CHECK, REPEATABLE, DAILY)
	if questEnabled and (now - runtime.lastQuestClaim > 1.8) then
		runtime.lastQuestClaim = now
		pcall(function()
			local qJson = LocalPlayer:GetAttribute("QuestsJson")
			if type(qJson) == "string" and qJson ~= "" then
				local data = HttpService:JSONDecode(qJson)
				local pLv = getLevel()
				local itemsJsonStr = LocalPlayer:GetAttribute("ItemsJson")
				local itemsData = (type(itemsJsonStr) == "string" and itemsJsonStr ~= "") and HttpService:JSONDecode(itemsJsonStr) or {}

				-- Immediate Card Check: If we were hunting for a card (t05) and just got one, equip and claim immediately!
				if runtime.needHuntCard then
					local oc = getOwnedCards()
					if #oc > 0 then
						pcall(function()
							equipCardToSlot(oc[1].Id, "Weapon")
							task.wait(0.08)
							if CardAction then CardAction:FireServer("auto") end
							task.wait(0.2)
							QuestAction:FireServer("claim", "t05")
							runtime.needHuntCard = false
							print(string.format("[PayomboyZ] ได้รับการ์ด [%s] แล้ว! สวมใส่การ์ดและส่งเควสต์ t05 เรียบร้อย กลับสู่ลูปไก่ตันปรกติ", oc[1].Id))
						end)
					end
				end

				local hasActiveRepeatable = false
				local activeRepeatableId = nil
				local activeRepeatableCount = 0
				local activeRepeatableTargetCount = 40
				local activeRepeatableReq = 1

				local bestQId, bestQZone, bestQTarget = getBestRepeatableQuest(pLv)
				local bestDef = QuestData and QuestData.Quests and QuestData.Quests[bestQId]
				local bestReq = (bestDef and tonumber(bestDef.ReqLevel)) or (QuestCatalog[bestQId] and tonumber(QuestCatalog[bestQId].Req)) or 1

				if data and data.Active then
					for qId, info in pairs(data.Active) do
						local count = (type(info) == "table" and (tonumber(info.Count) or tonumber(info.Prog))) or (type(info) == "number" and info) or 0
						local qDef = QuestData and QuestData.Quests and QuestData.Quests[qId]
						local cat = QuestCatalog[qId]
						local targetCount = qDef and (tonumber(qDef.TargetCount) or tonumber(qDef.Count)) or (cat and cat.Count) or 40
						local qType = qDef and qDef.Type or "kill"
						local isRepeatable = (cat ~= nil or (qDef and qDef.Repeat) or qId:sub(1,1) == "r")

						if isRepeatable and count < targetCount then
							local rawTarget = (qDef and (qDef.Target or qDef.Monster or qDef.KillTarget)) or (cat and cat.Target)
							local mInfo = rawTarget and (MonsterData[rawTarget] or (MonsterData.Monsters and MonsterData.Monsters[rawTarget]) or monsterByName[rawTarget])
							local zName = (cat and cat.Zone) or (mInfo and (mInfo.ZoneKey or (mInfo.Zone and string.format("Field%02d", tonumber(mInfo.Zone))))) or nil

							if zName and not isZoneUnlocked(zName) then
								-- Active repeatable quest is behind a locked boss gate!
								-- Abandon it immediately and switch to the best unlocked quest
								QuestAction:FireServer("abandon", qId)
								task.wait(0.2)
								if bestQId and isZoneUnlocked(bestQZone) then
									QuestAction:FireServer("accept", bestQId)
									runtime.lastQuestAccept = now
									setPlayerTarget(nil)
									runtime.currentTarget = nil
								end
							else
								hasActiveRepeatable = true
								activeRepeatableId = qId
								activeRepeatableCount = count
								activeRepeatableTargetCount = targetCount
								activeRepeatableReq = (qDef and tonumber(qDef.ReqLevel)) or (cat and tonumber(cat.Req)) or 1
							end
						end

						-- A. Check / Tutorial Quests Resolver (t01-t09+ and any check type)
						--    This handles ALL tutorial quests generically even if new ones are added by the game.
						if qType == "check" or qId:sub(1,1) == "t" then
							local tgt = qDef and (qDef.Target or qDef.Menu or qDef.Action or "")
							local tgtLow = tostring(tgt):lower()
							local claimAfter = true

							-- Refine tutorial: go to blacksmith, refine, claim
							if tgtLow:find("refine") or qId == "t04" then
								local bsPos = Vector3.new(-33.4, 4.6, -4.4)
								local distToBs = (root.Position - bsPos).Magnitude
								if distToBs > 10 then
									runtime.targetName = "🔨 กำลังเดินไปหาช่างตีบวก (Blacksmith) เพื่อทำเควสต์..."
									hum:MoveTo(bsPos)
									claimAfter = false
								else
									pcall(function()
										local targetKey = LocalPlayer:GetAttribute("WeaponId")
										if not targetKey or targetKey == "" then
											targetKey = findRefineCandidate("⚔️ อาวุธที่สวมใส่อยู่ (Equipped Weapon)")
										end
										if targetKey then
											local itemsJsonStr2 = LocalPlayer:GetAttribute("ItemsJson")
											local items2 = (type(itemsJsonStr2) == "string" and itemsJsonStr2 ~= "") and HttpService:JSONDecode(itemsJsonStr2) or {}
											if (items2.refine_stone or 0) < 1 then
												pcall(function() Remotes.ShopBuy:FireServer("refine_stone", 2) end)
												task.wait(0.3)
											end
											Remotes.RefineWeapon:FireServer(targetKey, false, false, true)
										end
									end)
									task.wait(0.5)
								end

							-- Card tutorial (t05): auto-equip card then claim
							elseif tgtLow:find("card") or qId == "t05" then
								local ownedCards = getOwnedCards()
								local hasEquippedCard = false
								pcall(function()
									local cJsonStr = LocalPlayer:GetAttribute("CardsJson")
									if type(cJsonStr) == "string" and cJsonStr ~= "" then
										local cObj = HttpService:JSONDecode(cJsonStr)
										if type(cObj) == "table" then
											for _, val in pairs(cObj) do
												if type(val) == "string" and val ~= "" then
													hasEquippedCard = true
													break
												end
											end
										end
									end
								end)

								if hasEquippedCard then
									-- Already equipped a card: claim quest immediately!
									claimAfter = true
									runtime.needHuntCard = false
								elseif #ownedCards > 0 then
									-- Has card in bag: equip it now and claim!
									pcall(function()
										equipCardToSlot(ownedCards[1].Id, "Weapon")
										task.wait(0.08)
										if CardAction then CardAction:FireServer("auto") end
									end)
									claimAfter = true
									runtime.needHuntCard = false
								else
									-- No card owned or equipped yet!
									-- DO NOT fire CardAction:auto (avoids "ไม่มีการ์ดให้ใส่" popup)
									-- Flag script to hunt Wild Rabbit in Field01 to get the card drop!
									claimAfter = false
									runtime.needHuntCard = true
									runtime.huntCardQuestId = qId
								end

							-- Stat tutorial (t01): allocate 1 stat point then claim
							elseif tgtLow:find("stat") or qId == "t01" then
								pcall(function()
									local statPlan = Remotes:FindFirstChild("StatPlan")
									if statPlan then
										statPlan:InvokeServer({ STR = 1 }, true)
									else
										AllocateStat:FireServer("STR", 1)
									end
								end)

							-- Skill tutorial (t02): enable auto-skill then claim
							elseif tgtLow:find("skill") or qId == "t02" then
								pcall(function()
									SetAutoSkill:FireServer(true)
									if SkillData and SkillData.Skills then
										for skId, _ in pairs(SkillData.Skills) do
											LearnSkill:FireServer(skId)
										end
									end
								end)

							-- Potion/item tutorial: use any HP potion then claim
							elseif tgtLow:find("potion") or tgtLow:find("item") or tgtLow:find("heal") then
								pcall(function()
									UseItem:FireServer("red_potion_m")
									task.wait(0.1)
									UseItem:FireServer("red_potion")
								end)

							-- Equip/gear tutorial (t03): trigger auto-equip best gear then claim
							elseif tgtLow:find("gear") or tgtLow:find("weapon") or tgtLow:find("armor") or tgtLow:find("equip") or qId == "t03" then
								pcall(function()
									SetAutoEquip:FireServer(true)
								end)

							-- Shop/buy tutorial: open shop or npc
							elseif tgtLow:find("shop") or tgtLow:find("npc") or tgtLow:find("buy") then
								pcall(function()
									OpenNpc:FireServer("Merchant")
								end)

							-- Generic / unknown tutorial: attempt claim directly (server-side check will pass if met)
							else
								-- Fire a broad sweep of common tutorial completions
								pcall(function()
									local oc = getOwnedCards()
									if CardAction and #oc > 0 then CardAction:FireServer("auto") end
									SetAutoEquip:FireServer(true)
									task.wait(0.05)
									SetAutoSkill:FireServer(true)
								end)
						end

							if claimAfter then
								task.wait(0.3)
								QuestAction:FireServer("claim", qId)
							end

						-- B. Collect Item Quests
						elseif qType == "collect" then
							local itemCount = itemsData[qDef.Target] or 0
							if itemCount >= targetCount then
								QuestAction:FireServer("claim", qId)
							end

						-- C. Level Progression Quests
						elseif qType == "level" then
							if pLv >= targetCount then
								QuestAction:FireServer("claim", qId)
							end

						-- D. Monster Kill Quests (r01-r14, d01-d03)
						elseif qType == "kill" then
							if count >= targetCount then
								QuestAction:FireServer("claim", qId)
								if isRepeatable then
									runtime.lastFinishedRepeatable = qId
									-- SMART QUEST UPGRADE ON FINISH:
									-- Immediately advance to the highest unlocked repeatable quest for player level!
									if bestQId and isZoneUnlocked(bestQZone) and bestQId ~= qId then
										task.wait(0.3)
										QuestAction:FireServer("accept", bestQId)
										runtime.lastQuestAccept = now
										hasActiveRepeatable = true
										activeRepeatableId = bestQId
										setPlayerTarget(nil)
										runtime.currentTarget = nil
									end
								end
							end
						end
					end
				end

				-- REPEATABLE QUEST SMART PROMOTION ENGINE:
				if (Flags.AutoQuest or Flags.KaitunAutoQuest) and (now - (runtime.lastQuestAccept or 0) > 1.2) then
					if not hasActiveRepeatable then
						-- Case 1: No active repeatable quest -> accept the best unlocked quest
						if bestQId and isZoneUnlocked(bestQZone) then
							runtime.lastQuestAccept = now
							QuestAction:FireServer("accept", bestQId)
							setPlayerTarget(nil)
							runtime.currentTarget = nil
						end
					elseif activeRepeatableId and bestQId and isZoneUnlocked(bestQZone) and (bestReq > activeRepeatableReq) then
						-- Case 2: Player has an outdated lower-tier quest!
						-- If <= 5 mobs left to finish, let player finish and claim (the finish handler above switches immediately).
						-- If > 5 mobs left, switch immediately to the higher-tier quest so time isn't wasted!
						local mobsRemaining = activeRepeatableTargetCount - activeRepeatableCount
						if mobsRemaining > 5 then
							runtime.lastQuestAccept = now
							QuestAction:FireServer("abandon", activeRepeatableId)
							task.delay(0.2, function()
								QuestAction:FireServer("accept", bestQId)
							end)
							setPlayerTarget(nil)
							runtime.currentTarget = nil
						end
					end
				end
			end
		end)
	end

	-- 3.5 AUTO REWARD CLAIMS (Daily, Online Time, Battle Pass, Achievements)
	if (Flags.AutoClaimDaily or Flags.AutoClaimOnline or Flags.AutoClaimAchieve or Flags.AutoClaimBattlePass or (Flags.MasterKaitun and Flags.KaitunAutoRewards)) and (now - (runtime.lastRewardClaim or 0) > 8.0) then
		runtime.lastRewardClaim = now
		if Flags.AutoClaimOnline or (Flags.MasterKaitun and Flags.KaitunAutoRewards) or Flags.AutoClaimDaily then
			claimAllOnlineRewards()
		end
		if Flags.AutoClaimAchieve or (Flags.MasterKaitun and Flags.KaitunAutoRewards) then
			claimAllAchievements()
		end
		if Flags.AutoClaimBattlePass or (Flags.MasterKaitun and Flags.KaitunAutoRewards) then
			claimAllBattlePass()
		end
	end

	-- 4. SMART BAG MANAGEMENT: KEEP TOP GEAR TO 30% OF CAPACITY
	if (Flags.AutoSellJunk or runtime.isCleaningBag) and (now - (runtime.lastBagCheck or 0) > 1.0) then
		runtime.lastBagCheck = now
		if performSmartBagClean(false) then
			return
		end
	end

	-- 5. AUTO BUILD & PROGRESSION (Stats, Skills, Refine, Equip)
	if statEnabled and (now - runtime.lastStatAlloc > 2.0) then
		runtime.lastStatAlloc = now
		pcall(function()
			local pts = tonumber(LocalPlayer:GetAttribute("StatPoints")) or tonumber(LocalPlayer:GetAttribute("RemainPoints")) or 0
			if pts > 0 then
				local preset = Flags.StatPreset or "⚔️ STR สายดาบ/กายภาพล้วน"
				local statKey = preset:find("STR") and "STR" or preset:find("AGI") and "AGI" or preset:find("INT") and "INT" or preset:find("DEX") and "DEX" or preset:find("VIT") and "VIT" or "STR"
				local statPlan = Remotes:FindFirstChild("StatPlan")
				if statPlan then
					statPlan:InvokeServer({ [statKey] = 1 }, true)
				elseif AllocateStat then
					AllocateStat:FireServer(statKey, pts)
				end
			end
		end)
	end

	if skillEnabled and (now - runtime.lastSkillLearn > 3.0) then
		runtime.lastSkillLearn = now
		pcall(function()
			local skPts = tonumber(LocalPlayer:GetAttribute("SkillPoints")) or 0
			if skPts > 0 and SkillData and SkillData.Skills then
				for skId, _ in pairs(SkillData.Skills) do
					LearnSkill:FireServer(skId)
				end
			end
		end)
	end

	if equipEnabled and (now - runtime.lastEquipBest > 5.0) then
		runtime.lastEquipBest = now
		pcall(function() SetAutoEquip:FireServer(true) end)
	end


	-- 6. COMBAT ENGINE GATING: If AutoFarm is turned OFF, cleanly halt combat!
	if not farmEnabled then
		if runtime.currentTarget then
			setPlayerTarget(nil)
			runtime.currentTarget = nil
			runtime.targetName = "⏹️ ปิดระบบฟาร์มแล้ว (Auto Farm Off)"
			runtime.targetHp = 0
			runtime.targetMaxHp = 0
		end
		if LocalPlayer:GetAttribute("AutoOn") == true then
			pcall(function()
				local pgui = LocalPlayer:FindFirstChild("PlayerGui")
				local la = pgui and pgui:FindFirstChild("LumiAuto")
				local autoBtn = la and la:FindFirstChild("AutoButton")
				if autoBtn and firesignal then firesignal(autoBtn.MouseButton1Click) end
			end)
		end
		setNoclip(false)
		if root then
			root.AssemblyLinearVelocity = Vector3.zero
			local bv = root:FindFirstChild("PayomboyZ_HoverVelocity")
			if bv then bv:Destroy() end
		end
		if lootEnabled and (now - runtime.lastLootTick > 0.4) then
			runtime.lastLootTick = now
			pcall(function() PickupDrop:FireServer(true) end)
		end
		return
	end

	-- 7. ZONE TRANSIT CHECK (Auto advance to monster stage matching character level / quest)
	local qInfo = parseActiveQuest()
	local autoQuestActive = questEnabled or (Flags.MasterKaitun and Flags.KaitunAutoQuest) or Flags.AutoQuest or Flags.AutoClaimQuest
	local targetMode = Flags.TargetMode or "📜 ตามเควสต์ปัจจุบัน (Quest Auto Target)"
	local tLower = targetMode:lower()
	local isLevelMode = tLower:find("level") or targetMode:find("เลเวล")
	local isSelectMode = tLower:find("select") or targetMode:find("เลือกเจาะจง")
	local pLv = getLevel()
	local targetZone = nil

	-- Crucial: When Auto Quest is enabled, ALWAYS lock the farming area & zone directly to the user's active quest!
	if autoQuestActive and qInfo and qInfo.TargetZone and not qInfo.Completed and isZoneUnlocked(qInfo.TargetZone) then
		targetZone = qInfo.TargetZone
	elseif isLevelMode then
		targetZone = getZoneByLevel(pLv)
	elseif isSelectMode then
		local sName = cleanMonsterName(Flags.SelectedMonster):lower()
		local mData = monsterByName[sName]
		if mData and mData.Zone then
			targetZone = string.format("Field%02d", tonumber(mData.Zone))
		end
	else
		if qInfo and qInfo.TargetZone and not qInfo.Completed and isZoneUnlocked(qInfo.TargetZone) then
			targetZone = qInfo.TargetZone
		else
			targetZone = getZoneByLevel(pLv)
		end
	end

	if targetZone and ZonePositions[targetZone] then
		local curZone = getCurrentZone(root.Position.Z)
		if curZone ~= targetZone then
			runtime.currentTarget = nil
			setPlayerTarget(nil)
			local qTitle = (autoQuestActive and qInfo and qInfo.Title) or targetZone
			runtime.targetName = "กำลังเดินทางไปยัง " .. targetZone .. " (ตามเควสต์: " .. qTitle .. ")..."
			runtime.targetHp = 0
			runtime.targetMaxHp = 0
			glideToZone(targetZone)
			return
		end
	end

	-- 8. TARGET RESOLUTION & COMBAT
	local target = runtime.currentTarget
	if not isAlive(target) then
		target = findTarget()
		runtime.currentTarget = target
	end

	if target and isAlive(target) then
		local tRoot = target.PrimaryPart or target:FindFirstChild("HumanoidRootPart") or target:FindFirstChild("Torso")
		if tRoot and (root.Position - tRoot.Position).Magnitude > 140 then
			target = nil
			runtime.currentTarget = nil
			setPlayerTarget(nil)
		end
	end

	if not target or not isAlive(target) then
		if Flags.ReturnToFarmSpot and Flags.HasFarmSpot then
			local spotPos = Vector3.new(Flags.FarmSpotX, Flags.FarmSpotY, Flags.FarmSpotZ)
			local distToSpot = (root.Position - spotPos).Magnitude
			if distToSpot > 8 and hum then
				runtime.targetName = "📍 กำลังเดินกลับจุดฟาร์ม (Returning to Farm Spot)..."
				hum:MoveTo(spotPos)
				return
			end
		end

		if autoQuestActive and qInfo and not qInfo.Completed then
			runtime.targetName = "กำลังรอเควสต์มอนสเตอร์ (" .. tostring(qInfo.TargetMob or qInfo.RawTarget or "เป้าหมายเควสต์") .. ") ใน " .. (targetZone or "โซนเควสต์") .. "..."
		else
			runtime.targetName = "กำลังค้นหาเป้าหมายใน " .. (targetZone or "โซนปัจจุบัน") .. "..."
		end
		runtime.targetHp = 0
		runtime.targetMaxHp = 0
		setPlayerTarget(nil)

		if root then
			root.AssemblyLinearVelocity = Vector3.zero
			local bv = root:FindFirstChild("PayomboyZ_HoverVelocity")
			if bv then bv:Destroy() end
		end

		if lootEnabled and (now - runtime.lastLootTick > 0.4) then
			runtime.lastLootTick = now
			pcall(function() PickupDrop:FireServer(true) end)
		end
		return
	end

	-- ACTIVE TARGET ENGAGED
	local tRoot = target.PrimaryPart or target:FindFirstChild("HumanoidRootPart") or target:FindFirstChild("Torso")
	local tHp = tonumber(target:GetAttribute("HP")) or 0

	if not tRoot or tHp <= 0 then
		if lootEnabled then pcall(function() PickupDrop:FireServer(true) end) end
		setPlayerTarget(nil)
		runtime.currentTarget = nil
		runtime.targetName = "None"
		runtime.targetHp = 0
		return
	end

	runtime.targetName = target.Name
	runtime.targetHp = math.floor(tHp)
	runtime.targetMaxHp = tonumber(target:GetAttribute("MaxHP")) or 100

	-- 9. COMBAT MOVEMENT & FIGHT STYLE (FarmMethod Router)
	local farmMethod = tostring(Flags.FarmMethod or "")
	local isHover = farmMethod:find("Safe Hover") or farmMethod:find("ลอยฟ้า")
	local isBuiltinBot = farmMethod:find("Built-in Bot") or farmMethod:find("บอทแท้")

	local tPos = tRoot.Position
	local dist = (root.Position - tPos).Magnitude
	local attackDist = tonumber(Flags.AttackDistance)
	if not attackDist or attackDist <= 0 then attackDist = 3.5 end

	if isHover then
		-- A. Safe Hover: Float directly above target monster's head
		local hoverH = tonumber(Flags.HoverHeight)
		if not hoverH or hoverH <= 1.0 then hoverH = 6.0 end
		local hoverTarget = Vector3.new(tPos.X, tPos.Y + hoverH, tPos.Z)

		-- Turn OFF native bot so it doesn't fight hover or pull player down
		if LocalPlayer:GetAttribute("AutoOn") == true then
			pcall(function()
				local pgui = LocalPlayer:FindFirstChild("PlayerGui")
				local la = pgui and pgui:FindFirstChild("LumiAuto")
				local autoBtn = la and la:FindFirstChild("AutoButton")
				if autoBtn and firesignal then firesignal(autoBtn.MouseButton1Click) end
			end)
		end

		setNoclip(true)

		-- Rock-steady gravity cancellation: BodyVelocity locks Y-axis without falling
		local bv = root:FindFirstChild("PayomboyZ_HoverVelocity")
		if not bv then
			bv = Instance.new("BodyVelocity")
			bv.Name = "PayomboyZ_HoverVelocity"
			bv.MaxForce = Vector3.new(0, math.huge, 0)
			bv.Velocity = Vector3.zero
			bv.Parent = root
		end

		if hum then hum:Move(Vector3.zero, false) end
		local stepPos = root.Position:Lerp(hoverTarget, 0.28)
		root.CFrame = CFrame.lookAt(stepPos, tPos)

	elseif isBuiltinBot then
		-- B. Built-in Bot: Let LumiAuto handle navigation natively
		local bv = root:FindFirstChild("PayomboyZ_HoverVelocity")
		if bv then bv:Destroy() end

		if LocalPlayer:GetAttribute("AutoOn") ~= true then
			pcall(function()
				local pgui = LocalPlayer:FindFirstChild("PlayerGui")
				local la = pgui and pgui:FindFirstChild("LumiAuto")
				local autoBtn = la and la:FindFirstChild("AutoButton")
				if autoBtn and firesignal then firesignal(autoBtn.MouseButton1Click) end
			end)
		end

		if now - (runtime.lastBotSettings or 0) > 3.0 then
			runtime.lastBotSettings = now
			pcall(function()
				local onlyFilter = {}
				local isLeaderQuest = qInfo and (qInfo.IsLeaderQuest == true or qInfo.RawTarget == "leader")
				if autoQuestActive and qInfo and qInfo.RawTarget and not qInfo.Completed and not isLeaderQuest then
					onlyFilter[qInfo.RawTarget] = true
				end
				SetBotSettings:FireServer({
					Mode = "fight",
					Preset = "normal",
					Radius = 160,
					HpPercent = tonumber(Flags.HpPercent) or 75,
					SpPercent = tonumber(Flags.SpPercent) or 40,
					Only = onlyFilter,
					Exclude = {},
					AttackLeader = (Flags.FarmBosses == true or isLeaderQuest == true),
					UseSkills = true,
					NormalAttack = true,
					Loot = true,
					OpenBoxes = true,
					FixedArea = false,
				})
			end)
		end

		if dist <= 12 and hum then
			local lookTarget = Vector3.new(tPos.X, root.Position.Y, tPos.Z)
			if (root.Position - lookTarget).Magnitude > 0.5 then
				root.CFrame = CFrame.lookAt(root.Position, lookTarget)
			end
		end

	else
		-- C. Ground Farm: Ground walking approach up to AttackDistance
		local bv = root:FindFirstChild("PayomboyZ_HoverVelocity")
		if bv then bv:Destroy() end

		if LocalPlayer:GetAttribute("AutoOn") == true then
			pcall(function()
				local pgui = LocalPlayer:FindFirstChild("PlayerGui")
				local la = pgui and pgui:FindFirstChild("LumiAuto")
				local autoBtn = la and la:FindFirstChild("AutoButton")
				if autoBtn and firesignal then firesignal(autoBtn.MouseButton1Click) end
			end)
		end

		if dist > attackDist then
			if dist > 8 then
				-- Fast CFrame Glide directly to monster proximity (Zero slow walk delay)
				local dir = (tPos - root.Position).Unit
				local stepDist = math.min(dist - attackDist, 18)
				local targetCFrame = CFrame.lookAt(root.Position + dir * stepDist, tPos)
				root.CFrame = targetCFrame
				root.AssemblyLinearVelocity = Vector3.zero
			else
				if hum then hum:MoveTo(tPos) end
			end
		else
			if hum then hum:Move(Vector3.zero, false) end
			local lookTarget = Vector3.new(tPos.X, root.Position.Y, tPos.Z)
			if (root.Position - lookTarget).Magnitude > 0.5 then
				root.CFrame = CFrame.lookAt(root.Position, lookTarget)
			end
		end
	end

	-- Attack triggering
	if now - runtime.lastAttackTick >= 0.15 then
		runtime.lastAttackTick = now
		setPlayerTarget(target)
		pcall(function()
			local pgui = LocalPlayer:FindFirstChild("PlayerGui")
			local la = pgui and pgui:FindFirstChild("LumiAuto")
			local atBtn = la and la:FindFirstChild("AttackButton")
			if atBtn and firesignal then firesignal(atBtn.MouseButton1Click) end
		end)
	end

	-- Combat Skills Spam
	if skillCombatEnabled and (now - runtime.lastSkillUse > 0.35) then
		runtime.lastSkillUse = now
		for slot = 1, 4 do
			pcall(function() UseSkill:FireServer(slot) end)
		end
		pcall(function()
			local bab = Remotes:FindFirstChild("BotAutoBuff")
			if bab then bab:FireServer() end
		end)
	end

	-- Loot Vacuum
	if lootEnabled and (now - runtime.lastLootTick > 0.35) then
		runtime.lastLootTick = now
		pcall(function() PickupDrop:FireServer(true) end)
	end
end

