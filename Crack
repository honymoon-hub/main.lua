local function claimAllAchievements()
	local claimed = 0
	pcall(function()
		local achieveAction = Remotes:FindFirstChild("AchieveAction")
		local sharedAchieve = Shared:FindFirstChild("AchievementData")
		if not achieveAction or not sharedAchieve then return end
		local ad = require(sharedAchieve)
		local achJson = LocalPlayer:GetAttribute("AchieveJson")
		local pData = (type(achJson) == "string" and achJson ~= "") and HttpService:JSONDecode(achJson) or {}
		local gotLookup = {}
		if type(pData.Got) == "table" then
			for _, g in ipairs(pData.Got) do gotLookup[g] = true end
			for k, v in pairs(pData.Got) do if v == true then gotLookup[k] = true end end
		end
		local counters = pData.C or {}
		local isAchieveReady = (LocalPlayer:GetAttribute("AchieveReady") == true)
		if ad and ad.List then
			for _, a in ipairs(ad.List) do
				local id = a.Id
				if id and not gotLookup[id] then
					local cKey = a.Counter or a.Type or id
					local currentVal = tonumber(counters[cKey] or (a.Type and counters[a.Type]) or (a.Counter and counters[a.Counter]) or 0) or 0
					local targetVal = tonumber(a.Count) or 0
					if (targetVal > 0 and currentVal >= targetVal) or isAchieveReady then
						achieveAction:FireServer("claim", id, false)
						claimed = claimed + 1
						task.wait(0.08)
					end
				end
			end
		end
	end)
	return claimed
end

local function claimAllOnlineRewards()
	local claimed = 0
	pcall(function()
		local rewardAction = Remotes:FindFirstChild("RewardAction") or RewardAction
		local sharedReward = Shared:FindFirstChild("RewardData")
		if not rewardAction then return end

		local rd = sharedReward and require(sharedReward)
		local rJson = LocalPlayer:GetAttribute("RewardsJson")
		local pData = (type(rJson) == "string" and rJson ~= "") and HttpService:JSONDecode(rJson) or {}
		local onlineData = pData.Online or {}
		local onlineSec = tonumber(onlineData.Sec) or 0
		local got = {}
		if type(onlineData.Got) == "table" then
			for _, s in ipairs(onlineData.Got) do got[s] = true end
		end

		-- 1. Online Time Tiers (1 to 6)
		if rd and rd.Online then
			for i, tier in ipairs(rd.Online) do
				local reqSec = (tier.Minutes or 0) * 60
				if not got[i] and onlineSec >= reqSec then
					rewardAction:FireServer("online", i)
					claimed = claimed + 1
					task.wait(0.12)
				end
			end
		else
			for i = 1, 6 do
				if not got[i] then
					rewardAction:FireServer("online", i)
					task.wait(0.10)
				end
			end
		end

		-- Fallback if RewardsReady is flagged
		if LocalPlayer:GetAttribute("RewardsReady") == true then
			for i = 1, 6 do
				if not got[i] then
					rewardAction:FireServer("online", i)
					task.wait(0.08)
				end
			end
		end

		-- 2. Daily Check-ins (8-Day & Monthly)
		rewardAction:FireServer("c8", nil)
		task.wait(0.10)
		rewardAction:FireServer("month", nil)
		task.wait(0.10)

		-- 3. Monthly Milestones
		if rd and rd.Milestones and type(pData.Month) == "table" then
			local monthData = pData.Month
			local days = tonumber(monthData.Days) or 0
			local milesGot = {}
			if type(monthData.Miles) == "table" then
				for _, m in ipairs(monthData.Miles) do milesGot[m] = true end
			end
			for _, mInfo in ipairs(rd.Milestones) do
				local reqDays = tonumber(mInfo.Days) or 0
				if reqDays > 0 and days >= reqDays and not milesGot[reqDays] then
					rewardAction:FireServer("mile", reqDays)
					claimed = claimed + 1
					task.wait(0.12)
				end
			end
		end

		-- 4. Daily Claim Remote
		local dailyClaim = Remotes:FindFirstChild("DailyClaim") or DailyClaim
		if dailyClaim then dailyClaim:FireServer() end
	end)
	return claimed
end

