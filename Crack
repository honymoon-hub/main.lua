    		{Color3.fromRGB(0, 255, 255), "Cyan"},
    		{Color3.fromRGB(255, 0, 255), "Magenta"},
    	}
    	local closestColor, minDiff = list_color[1][2], math.huge
    	for _, knownColor in list_color do
