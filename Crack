-- Perform card equip action to a specific slot
local function equipCardToSlot(cardId, slot)
	if not cardId or cardId == "" then return false end
	local realSlot = normalizeCardSlot(slot)
	pcall(function()
		if CardAction then
			-- Primary game remote signature: CardAction:FireServer("equip", slot, cardId)
			CardAction:FireServer("equip", realSlot, cardId)
			task.wait(0.04)
			CardAction:FireServer("equip", cardId, realSlot)
			task.wait(0.04)
			CardAction:FireServer("socket", realSlot, cardId)
		end
	end)
	return true
end

