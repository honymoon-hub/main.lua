		local ct = LocalPlayer:FindFirstChild("CurrentTarget")
		if ct and ct:IsA("ObjectValue") then
			ct.Value = target
		end
		LocalPlayer:SetAttribute("TargetLocked", target ~= nil)
		if target then
			SetTarget:FireServer(target, false, true)
		else
			SetTarget:FireServer(nil, false, false)
		end
	end)
end

local function getGroundPosition(worldPos)
	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Exclude
	local excludes = {}
	local char = LocalPlayer.Character
	if char then table.insert(excludes, char) end
	local monsters = Workspace:FindFirstChild("Monsters") or Workspace:FindFirstChild("Mobs")
	if monsters then table.insert(excludes, monsters) end
	local drops = Workspace:FindFirstChild("Drops") or Workspace:FindFirstChild("DropItems")
	if drops then table.insert(excludes, drops) end
	local map = Workspace:FindFirstChild("Map")
	if map then
		local bf = map:FindFirstChild("BlockFields")
		if bf then
			for _, b in ipairs(bf:GetChildren()) do
				local shell = b:FindFirstChild("Shell")
				if shell then table.insert(excludes, shell) end
			end
		end
		local barriers = map:FindFirstChild("Barriers")
		if barriers then table.insert(excludes, barriers) end
	end
	rayParams.FilterDescendantsInstances = excludes

	local origin = Vector3.new(worldPos.X, worldPos.Y + 8, worldPos.Z)
	local result = Workspace:Raycast(origin, Vector3.new(0, -50, 0), rayParams)
	if result and result.Position then
		return Vector3.new(worldPos.X, result.Position.Y + 3.0, worldPos.Z)
	end
	return worldPos
end

