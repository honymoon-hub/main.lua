-- BUG FIX 1: STAIRS & MAP BARRIERS BYPASS
-- ปลดล็อกม่านกั้น Map.Barriers ทั้งหมด 216 ชิ้น แก้บัคตัวละครโดนดีดกลับเวลาขึ้นบันได/ข้ามสะพาน
-- =====================================================================
local function disableAllBarriers()
	pcall(function()
		local map = Workspace:FindFirstChild("Map")
		if map then
			local barriers = map:FindFirstChild("Barriers")
			if barriers then
				for _, part in ipairs(barriers:GetDescendants()) do
					if part:IsA("BasePart") then
						part.CanCollide = false
						part.CanTouch = false
						part.CanQuery = false
					end
				end
			end

			for _, obj in ipairs(map:GetDescendants()) do
				if obj:IsA("BasePart") and (
					obj.Name:find("Barrier") or 
					obj.Name:find("Gate") or 
					obj.Name:find("BossLock") or 
					obj.Name:find("Block") or
					obj.Name:find("Bridge_Barrier") or
					obj.Name:find("Safe") or
					obj.Name:find("Wall") or
					obj.Name:find("Door") or
					obj.Name:find("Shell") or
					obj.Name:find("Clad") or
					obj.Name:find("Post") or
					obj.Name:find("Fence") or
					obj.Name:find("Boss")
				) then
					obj.CanCollide = false
					obj.CanTouch = false
					obj.CanQuery = false
				end
			end
		end

		local cs = game:GetService("CollectionService")
		for _, g in ipairs(cs:GetTagged("LevelGate")) do
			if g:IsA("BasePart") then g.CanCollide = false end
		end
		for _, g in ipairs(cs:GetTagged("GateLock")) do
			if g:IsA("BasePart") then g.CanCollide = false end
		end
	end)
end

