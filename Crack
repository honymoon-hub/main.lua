	local _, root = characterParts()
	local hum = LocalPlayer.Character and LocalPlayer.Character:FindFirstChildOfClass("Humanoid")
	if not root or not hum then return false end

	-- Clean up combat hover velocity so character lands cleanly
	local bv = root:FindFirstChild("PayomboyZ_HoverVelocity")
	if bv then bv:Destroy() end
	setNoclip(false)

	local curZone = getCurrentZone(root.Position.Z)
	if curZone == zoneName then
		return true
	end

	-- Crucial: Ensure native bot is disarmed during inter-zone travel
	if LocalPlayer:GetAttribute("AutoOn") == true and (tick() - (runtime.lastAutoOnToggle or 0) > 0.8) then
		runtime.lastAutoOnToggle = tick()
		pcall(function()
			local pgui = LocalPlayer:FindFirstChild("PlayerGui")
			local la = pgui and pgui:FindFirstChild("LumiAuto")
			local autoBtn = la and la:FindFirstChild("AutoButton")
			if autoBtn and firesignal then
				firesignal(autoBtn.MouseButton1Click)
			end
		end)
	end

	-- INSTANT FAST TRAVEL (Zero walk delay, zero falling off the map)
	local now = tick()
	if now - lastZoneWarpTick > 0.35 then
		lastZoneWarpTick = now
		pcall(function()
			if zoneName == "Town" then
				local pw = Remotes:FindFirstChild("PillarWarp")
				if pw then pw:FireServer("Town") end
			end
			local map = Workspace:FindFirstChild("Map")
			local warps = map and map:FindFirstChild("Warps")
			local warpPart = warps and warps:FindFirstChild("Warp_" .. zoneName)
			if warpPart then
				root.CFrame = warpPart.CFrame + Vector3.new(0, 3.5, 0)
			else
				root.CFrame = CFrame.new(dest.X, dest.Y + 3.5, dest.Z)
			end
			root.AssemblyLinearVelocity = Vector3.zero
		end)
	end

	return (getCurrentZone(root.Position.Z) == zoneName)
end

