local function cleanMonsterName(name)
	local n = tostring(name or "")
	n = n:gsub("%s*%([Ll][Vv]%.?%s*%d+%)%s*", "")
	n = n:gsub("^%s+", ""):gsub("%s+$", "")
	return n
end

-- Gate Progression & Barrier Unlock Checker (Direct from Player Attributes)
local function isZoneUnlocked(zoneName)
	if not zoneName then return false end
	if zoneName == "Town" or zoneName == "Field01" or zoneName == "Field02" or zoneName == "Field03" then
		return true
	end
	local bgJson = LocalPlayer:GetAttribute("BossGatesJson")
	if type(bgJson) ~= "string" or bgJson == "" then
		return false
	end
	local ok, bg = pcall(function() return HttpService:JSONDecode(bgJson) end)
	if not ok or type(bg) ~= "table" then return false end

	if bg[zoneName] == true then return true end
	if (zoneName == "Field04" or zoneName == "Field05" or zoneName == "Field06") then
		return (bg.Boss01 == true or bg.Field04 == true)
	end
	if (zoneName == "Field07" or zoneName == "Field08" or zoneName == "Field09") then
		return (bg.Boss02 == true or bg.Field07 == true)
	end
	if (zoneName == "Field10" or zoneName == "Field11" or zoneName == "Field12") then
		return (bg.Boss03 == true or bg.Field10 == true)
	end
	if (zoneName == "Field13" or zoneName == "Field14" or zoneName == "Field15") then
		return (bg.Boss04 == true or bg.Field13 == true)
	end
	return false
end

