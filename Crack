local function parseActiveQuest()
	local qJson = LocalPlayer:GetAttribute("QuestsJson")
	if type(qJson) ~= "string" or qJson == "" then return nil end

	local ok, data = pcall(function() return HttpService:JSONDecode(qJson) end)
	if not ok or type(data) ~= "table" or not data.Active then return nil end

	local bestQuest = nil
	local pLv = getLevel()

	-- Priority -1: Immediate Card Hunting for Tutorial Quest t05
	-- If t05 is active and player has no card, prioritize farming Wild Rabbit in Field01 to get the card drop!
	if runtime.needHuntCard and data.Active and data.Active.t05 ~= nil then
		local owned = getOwnedCards()
		if #owned == 0 then
			bestQuest = {
				Id = "t05",
				Title = "[สอนเล่น] ล่าหาการ์ดใบแรก (Wild Rabbit Card)",
				RawTarget = "budkin",
				TargetMob = "Wild Rabbit (ล่าหาการ์ด)",
				TargetZone = "Field01",
				ZoneUnlocked = true,
				Inaccessible = false,
				Current = 0,
				TargetCount = 1,
				Completed = false,
				IsCardHunting = true
			}
		else
			runtime.needHuntCard = false
		end
	end

	-- Priority 0: Immediate Daily Boss / Leader Quests (e.g. d03: [Daily] Boss Slayer / ล้มบอส)
	-- Daily boss quests only need 1 kill; prioritize to finish and claim immediately!
	for qId, info in pairs(data.Active) do
		local currentCount = (type(info) == "table" and (tonumber(info.Count) or tonumber(info.Prog))) or (type(info) == "number" and info) or 0
		local qDef = QuestData and QuestData.Quests and QuestData.Quests[qId]
		local targetCount = qDef and (tonumber(qDef.TargetCount) or tonumber(qDef.Count)) or 1
		local rawTarget = qDef and (qDef.Target or qDef.Monster or qDef.KillTarget)

		if (qId == "d03" or rawTarget == "leader") and currentCount < targetCount then
			local curZ = "Field01"
			local _, rootPart = characterParts()
			if rootPart then
				curZ = getCurrentZone(rootPart.Position.Z)
				if curZ == "Town" then curZ = "Field01" end
			end
			bestQuest = {
				Id = qId,
				Title = qDef and (qDef.Title or qDef.Name) or "[Daily] Boss Slayer",
				RawTarget = "leader",
				TargetMob = "บอส/หัวหน้ามอนสเตอร์ (Leader)",
				TargetZone = curZ,
				ZoneUnlocked = true,
				Inaccessible = false,
				Current = currentCount,
				TargetCount = targetCount,
				Completed = false,
				IsLeaderQuest = true
			}
			break
		end
	end

	-- Priority 1: Direct lock on user's active repeatable hunting quest (r01-r14)
	if not bestQuest then
		for qId, info in pairs(data.Active) do
			local currentCount = (type(info) == "table" and (tonumber(info.Count) or tonumber(info.Prog))) or (type(info) == "number" and info) or 0
			local qDef = QuestData and QuestData.Quests and QuestData.Quests[qId]
			local cat = QuestCatalog[qId]
			local targetCount = qDef and (tonumber(qDef.TargetCount) or tonumber(qDef.Count)) or (cat and cat.Count) or 40

			if cat or (qDef and qDef.Repeat) or qId:sub(1,1) == "r" then
				local rawTarget = (qDef and (qDef.Target or qDef.Monster or qDef.KillTarget)) or (cat and cat.Target)
				local mInfo = rawTarget and (MonsterData[rawTarget] or (MonsterData.Monsters and MonsterData.Monsters[rawTarget]) or monsterByName[rawTarget])
				local targetZone = (cat and cat.Zone) or (mInfo and (mInfo.ZoneKey or (mInfo.Zone and string.format("Field%02d", tonumber(mInfo.Zone))))) or getZoneByLevel(pLv)
				local targetMob = (cat and cat.MobName) or (mInfo and mInfo.Name) or rawTarget
				local zoneUnlocked = isZoneUnlocked(targetZone)

				bestQuest = {
					Id = qId,
					Title = qDef and (qDef.Title or qDef.Name) or (cat and ("[Repeat] Hunt " .. cat.MobName)) or qId,
					RawTarget = rawTarget,
					TargetMob = targetMob,
					TargetZone = targetZone,
					ZoneUnlocked = zoneUnlocked,
					Inaccessible = (not zoneUnlocked),
					Current = currentCount,
					TargetCount = targetCount,
					Completed = (currentCount >= targetCount)
				}
				break
			end
		end
	end

	-- Priority 2: Story or Tutorial quests (q01, t01-t05, etc.) or Daily (d01-d03)
	if not bestQuest then
		for qId, info in pairs(data.Active) do
			local currentCount = (type(info) == "table" and (tonumber(info.Count) or tonumber(info.Prog))) or (type(info) == "number" and info) or 0
			local qDef = QuestData and QuestData.Quests and QuestData.Quests[qId]
			local targetCount = qDef and (tonumber(qDef.TargetCount) or tonumber(qDef.Count)) or 10
			local rawTarget = qDef and (qDef.Target or qDef.Monster or qDef.KillTarget)
			local mInfo = rawTarget and (MonsterData[rawTarget] or (MonsterData.Monsters and MonsterData.Monsters[rawTarget]) or monsterByName[rawTarget])
			local targetZone = (mInfo and (mInfo.ZoneKey or (mInfo.Zone and string.format("Field%02d", tonumber(mInfo.Zone))))) or getZoneByLevel(pLv)
			local targetMob = (mInfo and mInfo.Name) or (rawTarget == "any" and "ทุกมอนสเตอร์ (Any Monster)") or rawTarget or "ทั่วไป"

			bestQuest = {
				Id = qId,
				Title = qDef and (qDef.Title or qDef.Name) or qId,
				RawTarget = rawTarget,
				TargetMob = targetMob,
				TargetZone = targetZone,
				ZoneUnlocked = isZoneUnlocked(targetZone),
				Inaccessible = false,
				Current = currentCount,
				TargetCount = targetCount,
				Completed = (currentCount >= targetCount)
			}
			break
		end
	end

	if bestQuest then
		runtime.activeQuestName = bestQuest.Title
		runtime.activeQuestProg = string.format("%d/%d", bestQuest.Current, bestQuest.TargetCount)
		runtime.activeQuestTarget = tostring(bestQuest.TargetMob or bestQuest.RawTarget or "ทั่วไป")
		runtime.activeQuestZone = bestQuest.TargetZone or getZoneByLevel(pLv)
	else
		runtime.activeQuestName = "None"
		runtime.activeQuestProg = "0/0"
		runtime.activeQuestTarget = "None"
		runtime.activeQuestZone = getZoneByLevel(pLv)
	end

	return bestQuest
end

local function findTarget()
	local _, root = characterParts()
	if not root then return nil end

	local cs = game:GetService("CollectionService")
	local taggedMobs = cs:GetTagged("Monster")
	local wsMonsters = (Workspace:FindFirstChild("Monsters") or Workspace:FindFirstChild("Mobs"))
	local wsMobs = wsMonsters and wsMonsters:GetChildren() or {}

	local autoQuestActive = (Flags.MasterKaitun and (Flags.KaitunAutoQuest or Flags.KaitunAutoRewards)) or Flags.AutoQuest or Flags.AutoClaimQuest
	local targetMode = Flags.TargetMode or "📜 ตามเควสต์ปัจจุบัน (Quest Auto Target)"
	local questInfo = parseActiveQuest()

	local spotPos = nil
	if Flags.ReturnToFarmSpot and Flags.HasFarmSpot then
		spotPos = Vector3.new(Flags.FarmSpotX, Flags.FarmSpotY, Flags.FarmSpotZ)
	end
	local maxRadius = tonumber(Flags.FarmSpotRadius) or 120

	local bestTarget = nil
	local bestDist = math.huge
	local pLevel = getLevel()
	local selectedClean = cleanMonsterName(Flags.SelectedMonster):lower()

	local candidates = #taggedMobs > 0 and taggedMobs or wsMobs
	for _, mob in ipairs(candidates) do
		if mob.Name:find("Dummy") or mob.Name:find("Training") or mob.Name:find("NPC") or mob.Name:find("Villager") then
			continue
		end

		-- Smart Boss & Leader Filter: Skip high-HP kings/spiders that one-shot players unless Boss Mode is on or Leader quest is active
		local isBoss = mob:GetAttribute("IsBoss") or mob:GetAttribute("IsLeader") or mob:GetAttribute("Leader") or mob.Name:find("Spider") or mob.Name:find("King")
		local isLeader = mob:GetAttribute("IsLeader") or mob:GetAttribute("Leader") or mob.Name:lower():find("leader")
		local tLower = targetMode:lower()
		local isBossMode = tLower:find("boss") or targetMode:find("บอส")
		local isLeaderQuest = (questInfo and (questInfo.IsLeaderQuest or questInfo.RawTarget == "leader"))

		if isBoss and not isBossMode and not Flags.FarmBosses then
			if not (isLeaderQuest and (isLeader or isBoss)) then
				continue
			end
		end

		if isAlive(mob) then
			local mPos = nil
			local mRoot = mob.PrimaryPart or mob:FindFirstChild("HumanoidRootPart") or mob:FindFirstChild("Torso")
			if mRoot then
				mPos = mRoot.Position
			elseif mob:IsA("Model") then
				mPos = mob:GetPivot().Position
			end

			if mPos then
				if spotPos and (mPos - spotPos).Magnitude > maxRadius then
					continue
				end

				local dist = (root.Position - mPos).Magnitude
				-- Proximity guard: Never target monsters in distant zones (>140 studs)
				-- This lets the Zone Navigation engine glide cleanly between zones first!
				if dist > 140 then
					continue
				end
				local mName = mob.Name
				local mId = tostring(mob:GetAttribute("MonsterId") or ""):lower()
				local matched = false

				local isQuestMode = autoQuestActive or tLower:find("quest") or targetMode:find("เควสต์") or (Flags.MasterKaitun and questInfo and not questInfo.Completed)
				local isLevelMode = tLower:find("level") or targetMode:find("เลเวล")
				local isSelectMode = tLower:find("select") or targetMode:find("เลือกเจาะจง")

				if isQuestMode then
					if questInfo and not questInfo.Completed then
						local qTargetMob = tostring(questInfo.TargetMob or ""):lower()
						local qRaw = tostring(questInfo.RawTarget or ""):lower()
						if qRaw == "leader" or questInfo.IsLeaderQuest then
							if isLeader or isBoss or mId:find("leader") or mName:lower():find("leader") then
								matched = true
							end
						elseif questInfo.IsCardHunting then
							if mId == "budkin" or mId:find("rabbit") or mName:lower():find("rabbit") or mId == "briar_sprite" then
								matched = true
							end
						elseif qRaw ~= "" and qRaw ~= "any" and (mId == qRaw or mId:find(qRaw) or qRaw:find(mId)) then
							matched = true
						elseif qTargetMob ~= "" and (mName:lower():find(qTargetMob) or qTargetMob:find(mName:lower())) then
							matched = true
						elseif qRaw == "any" then
							matched = true
						end
					end
				elseif isLevelMode then
					local mData = monsterByName[mName] or monsterByName[mId]
					local mLv = mData and (tonumber(mData.Level) or tonumber(mData.Lv)) or 1
					if mLv <= pLevel + 2 and mLv >= math.max(1, pLevel - 6) then
						matched = true
					end
				elseif isSelectMode then
					if mName:lower():find(selectedClean) or selectedClean:find(mName:lower()) or (mId ~= "" and selectedClean:find(mId)) then
						matched = true
					end
				elseif isBossMode then
					if isBoss then
						matched = true
					end
				else
					matched = true
				end

				if matched and dist < bestDist then
					bestDist = dist
					bestTarget = mob
				end
			end
		end
	end

	-- Fallback for Leader Quest: If Leader is temporarily dead, target nearby normal mobs so bot doesn't idle!
	if not bestTarget and questInfo and questInfo.IsLeaderQuest then
		for _, mob in ipairs(candidates) do
			if isAlive(mob) and not mob.Name:find("Dummy") and not mob.Name:find("Training") then
				local mRoot = mob.PrimaryPart or mob:FindFirstChild("HumanoidRootPart") or mob:FindFirstChild("Torso")
				local mPos = mRoot and mRoot.Position or mob:GetPivot().Position
				local dist = (root.Position - mPos).Magnitude
				if dist < 120 and dist < bestDist then
					bestDist = dist
					bestTarget = mob
				end
			end
		end
	end

	-- Fallback: If not in quest or specific mode, pick closest alive normal mob (excluding bosses)
	local tLower = targetMode:lower()
	local isQuestMode = autoQuestActive or tLower:find("quest") or targetMode:find("เควสต์") or (Flags.MasterKaitun and questInfo and not questInfo.Completed)
	local isSelectMode = tLower:find("select") or targetMode:find("เลือกเจาะจง")
	local isBossMode = tLower:find("boss") or targetMode:find("บอส")
	if not bestTarget and not spotPos and ((not isQuestMode) or (questInfo == nil)) and not isSelectMode then
		for _, mob in ipairs(candidates) do
			if isAlive(mob) and not mob.Name:find("Dummy") and not mob.Name:find("Training") then
				local isBoss = mob:GetAttribute("IsBoss") or mob:GetAttribute("IsLeader") or mob:GetAttribute("Leader") or mob.Name:find("Spider") or mob.Name:find("King")
				if not isBoss or isBossMode or Flags.FarmBosses then
					local mPos = nil
					local mRoot = mob.PrimaryPart or mob:FindFirstChild("HumanoidRootPart") or mob:FindFirstChild("Torso")
					if mRoot then
						mPos = mRoot.Position
					elseif mob:IsA("Model") then
						mPos = mob:GetPivot().Position
					end
					if mPos then
						local dist = (root.Position - mPos).Magnitude
						if dist < bestDist then
							bestDist = dist
							bestTarget = mob
						end
					end
				end
			end
		end
	end

	return bestTarget
end



local function getBridgeElevation(z)
	if z > -306 then return 8.0
	elseif z > -562 then return 15.0 + (28.4 - 15.0) * math.clamp((z - -450) / (-562 - -450), 0, 1)
	elseif z > -986 then return 28.4 + (52.8 - 28.4) * math.clamp((z - -750) / (-986 - -750), 0, 1)
	elseif z > -1200 then return 52.8 + (56.4 - 52.8) * math.clamp((z - -1070) / (-1200 - -1070), 0, 1)
	elseif z > -1456 then return 56.4 + (80.9 - 56.4) * math.clamp((z - -1370) / (-1456 - -1370), 0, 1)
	elseif z > -1820 then return 80.9 + (105.0 - 80.9) * math.clamp((z - -1680) / (-1820 - -1680), 0, 1)
	elseif z > -2130 then return 115.0
	else return 145.0 end
end

