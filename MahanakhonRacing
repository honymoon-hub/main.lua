    elseif halfWidth >= 9 then
        return 6.0  -- Standard 2-lane road (soi, village, cross, hill, half=12-14): Center of left lane (6 studs from center line, 6 studs from sidewalk)
    else
        return 2.0  -- Narrow link/ramp/alley (half=4-6)
    end
end
