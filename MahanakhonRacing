-- 🔎 Scan and Find 3D Model across map landmarks, props, spawned vehicles, and preview cache
Hub.FindVehicle3DModel = function(vehicleId)
    if not vehicleId or vehicleId == "" then return nil, "NoId" end
    
    -- 1. In-memory cache
    if Hub._vehicle3DCache[vehicleId] and Hub._vehicle3DCache[vehicleId].Parent then
        return Hub._vehicle3DCache[vehicleId]:Clone(), "Cache"
    end
    
    local foundModel = nil
    local sourceDesc = "None"
    
    -- 2. Workspace.Map.Landmarks.Showroom
    pcall(function()
        local showroom = Workspace:FindFirstChild("Map") and Workspace.Map:FindFirstChild("Landmarks") and Workspace.Map.Landmarks:FindFirstChild("Showroom")
        if showroom then
            if showroom:FindFirstChild("Display") and showroom.Display:FindFirstChild(vehicleId) then
                local m = showroom.Display[vehicleId]
                if #m:GetDescendants() > 5 then
                    foundModel = m
                    sourceDesc = "โชว์รูม (Showroom Display)"
                end
            end
            if not foundModel and showroom:FindFirstChild("RepairZone") and showroom.RepairZone:FindFirstChild("Vehicles") then
                local rz = showroom.RepairZone.Vehicles
                local bike = rz:FindFirstChild("Bike_" .. vehicleId) or rz:FindFirstChild(vehicleId)
                if bike and #bike:GetDescendants() > 5 then
                    foundModel = bike
                    sourceDesc = "อู่ซ่อมโชว์รูม (Showroom RepairZone)"
                end
            end
        end
    end)
    
    -- 3. ReplicatedStorage.JobStage.Props
    if not foundModel then
        pcall(function()
            local props = ReplicatedStorage:FindFirstChild("JobStage") and ReplicatedStorage.JobStage:FindFirstChild("Props")
            if props and props:FindFirstChild(vehicleId) then
                local m = props[vehicleId]
                if #m:GetDescendants() > 5 then
                    foundModel = m
                    sourceDesc = "พร็อพเกม (JobStage.Props)"
                end
            end
        end)
    end
    
    -- 4. PlayerGui.PreviewCache
    if not foundModel then
        pcall(function()
            local pc = LocalPlayer:FindFirstChildOfClass("PlayerGui") and LocalPlayer.PlayerGui:FindFirstChild("PreviewCache")
            if pc and pc:FindFirstChild(vehicleId) then
                local m = pc[vehicleId]
                if #m:GetDescendants() > 5 then
                    foundModel = m
                    sourceDesc = "แคชพรีวิวเกม (PreviewCache)"
                end
            end
        end)
    end
    
    -- 5. Workspace.SpawnedVehicles
    if not foundModel then
        pcall(function()
            local sv = Workspace:FindFirstChild("SpawnedVehicles")
            if sv then
                for _, v in ipairs(sv:GetChildren()) do
                    local vAttr = v:GetAttribute("VehicleId")
                    if (vAttr and string.lower(tostring(vAttr)) == string.lower(vehicleId)) or string.find(string.lower(v.Name), string.lower(vehicleId), 1, true) then
                        local body = v:FindFirstChild(vehicleId) or v:FindFirstChild("Body") or v
                        if #body:GetDescendants() > 5 then
                            foundModel = body
                            sourceDesc = "รถในเซิร์ฟเวอร์ (" .. v.Name .. ")"
                            break
                        end
                    end
                end
            end
        end)
    end

    -- 6. Player's currently mounted / spawned vehicle
    if not foundModel then
        pcall(function()
            local myVeh = GetPlayerVehicle(false)
            if myVeh and myVeh.Parent then
                local vAttr = myVeh:GetAttribute("VehicleId")
                if (vAttr and string.lower(tostring(vAttr)) == string.lower(vehicleId)) or string.find(string.lower(myVeh.Name), string.lower(vehicleId), 1, true) then
                    local body = myVeh:FindFirstChild(vehicleId) or myVeh:FindFirstChild("Body") or myVeh
                    if #body:GetDescendants() > 5 then
                        foundModel = body
                        sourceDesc = "รถของผู้เล่นปัจจุบัน"
                    end
                end
            end
        end)
    end

    -- 7. TuneShops (e.g. FK8 in AutoWorks)
    if not foundModel and (vehicleId == "FK8" or vehicleId == "FK8T" or vehicleId == "TYPER23") then
        pcall(function()
            local ts = Workspace.Map:FindFirstChild("TuneShops")
            local east = ts and ts:FindFirstChild("AutoWorksEast") and ts.AutoWorksEast:FindFirstChild("Workshop")
            if east and east:FindFirstChild("CustomerCar") then
                local c = east.CustomerCar
                if #c:GetDescendants() > 10 then
                    foundModel = c
                    sourceDesc = "อู่แต่งรถ (AutoWorks Workshop)"
                end
            end
        end)
    end

    -- No fake fallback: If 3D model is not streamed yet, return nil cleanly to render official high-res thumbnail
    if not foundModel then return nil, "ThumbnailOnly" end
    
    -- Clone and sanitize model for ViewportFrame
    local clone = foundModel:Clone()
    clone.Name = "Showcase_" .. vehicleId
    
    for _, desc in ipairs(clone:GetDescendants()) do
        if desc:IsA("Script") or desc:IsA("LocalScript") or desc:IsA("Sound") or desc:IsA("ParticleEmitter") or desc:IsA("ClickDetector") then
            desc:Destroy()
        elseif desc:IsA("Seat") or desc:IsA("VehicleSeat") then
            desc.Disabled = true
            desc.CanCollide = false
            desc.Anchored = true
        elseif desc:IsA("BasePart") then
            desc.Anchored = true
            desc.CanCollide = false
            desc.CanTouch = false
            desc.CanQuery = false
        end
    end
    
    -- Cache sanitized model
    pcall(function()
        Hub._vehicle3DCache[vehicleId] = clone:Clone()
    end)
    
    return clone, sourceDesc
end

-- 🛠️ 3D Viewport Rig with Orbit, Pan, Pitch, Zoom, and Turntable Stage
Hub.SetupVehicleViewportRig = function(viewportFrame, vehicleId)
    if not viewportFrame or not viewportFrame:IsA("ViewportFrame") then return nil end
    viewportFrame:ClearAllChildren()
    
    local model, sourceDesc = Hub.FindVehicle3DModel(vehicleId)
    if not model then return nil end
    
    model.Parent = viewportFrame
    local center, size = model:GetBoundingBox()
    
    -- Showroom Turntable Disc (Pedestal)
    local maxDim = math.max(size.X, size.Z)
    local pedestal = Instance.new("Part")
    pedestal.Name = "ShowroomPedestal"
    pedestal.Shape = Enum.PartType.Cylinder
    pedestal.Anchored = true
    pedestal.CanCollide = false
    pedestal.CanQuery = false
    pedestal.CanTouch = false
    pedestal.CastShadow = false
    pedestal.Size = Vector3.new(0.3, maxDim * 1.35, maxDim * 1.35)
    pedestal.CFrame = CFrame.new(center.Position.X, center.Position.Y - (size.Y * 0.5) - 0.12, center.Position.Z) * CFrame.Angles(0, 0, math.rad(90))
    pedestal.Color = Color3.fromRGB(22, 25, 34)
    pedestal.Material = Enum.Material.Metal
    pedestal.Parent = viewportFrame
    
    -- Camera
    local cam = Instance.new("Camera")
    cam.FieldOfView = 28
    cam.Parent = viewportFrame
    viewportFrame.CurrentCamera = cam
    
    -- Lighting
    viewportFrame.BackgroundTransparency = 1
    viewportFrame.LightDirection = Vector3.new(-0.6, -1.0, -0.4)
    viewportFrame.Ambient = Color3.fromRGB(165, 165, 180)
    viewportFrame.LightColor = Color3.fromRGB(255, 250, 240)
    
    local baseDistance = size.Magnitude * 1.18
    
    local rig = {
        Frame = viewportFrame,
        Camera = cam,
        Model = model,
        Center = center.Position,
        Size = size,
        BaseDistance = baseDistance,
        Zoom = 1.0,
        Yaw = math.rad(35),
        Pitch = 14,
        AutoRotate = true,
        Dragging = false,
        LastPos = nil,
        Source = sourceDesc,
        VehicleId = vehicleId,
    }
    
    local function applyCamCFrame()
        local radP = math.rad(math.clamp(rig.Pitch, -15, 65))
        local radY = rig.Yaw
        local offset = Vector3.new(
            math.cos(radP) * math.sin(radY),
            math.sin(radP),
            math.cos(radP) * math.cos(radY)
        )
        local camPos = rig.Center + offset * (rig.BaseDistance * rig.Zoom)
        rig.Camera.CFrame = CFrame.lookAt(camPos, rig.Center)
    end
    rig.ApplyCam = applyCamCFrame
    applyCamCFrame()
    
    -- Interactive Drag-to-Rotate (Mouse & Touch)
    viewportFrame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            rig.Dragging = true
            rig.LastPos = input.Position
        end
    end)
    
    viewportFrame.InputChanged:Connect(function(input)
        if rig.Dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local currentPos = input.Position
            local deltaX = currentPos.X - (rig.LastPos and rig.LastPos.X or currentPos.X)
            local deltaY = currentPos.Y - (rig.LastPos and rig.LastPos.Y or currentPos.Y)
            rig.LastPos = currentPos
            
            rig.Yaw = (rig.Yaw - deltaX * 0.012) % (math.pi * 2)
            rig.Pitch = math.clamp(rig.Pitch + deltaY * 0.35, -15, 65)
            applyCamCFrame()
        elseif input.UserInputType == Enum.UserInputType.MouseWheel then
            rig.Zoom = math.clamp(rig.Zoom - input.Position.Z * 0.1, 0.55, 2.5)
            applyCamCFrame()
        end
    end)
    
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            rig.Dragging = false
        end
    end)
    
    Hub.ActiveVehicleRigs[viewportFrame] = rig
    return rig
end

