local function IsNonGroundProp(inst, hitY, expectedY)
    if not inst then return true end
    if hitY and expectedY and (hitY - expectedY) > 2.2 then
        local n = inst.Name:lower()
        if n:find("fence") or n:find("post") or n:find("wall") or n:find("roof")
            or n:find("canopy") or n:find("awning") or n:find("gutter")
            or n:find("fascia") or n:find("header") or n:find("trunk") or n:find("leaf") or n:find("rail") then
            return true
        end
        if IsObstacleOrBuilding(inst) then
            return true
        end
    end
    return false
end

local function GetElevation(x, z, expectedY)
    expectedY = (expectedY ~= nil and tonumber(expectedY)) or 3.5
    local now = os.clock()
    if (now - Hub._lastElevationFilterUpdate) > 4.0 then
        Hub._lastElevationFilterUpdate = now
        Hub.UpdateElevationFilter()
    end
    local rayParams = Hub._elevationRayParams

    -- 1. Fast local ground & road scan (around expectedY + 8.0 down by 20.0 studs)
    local rMid = Workspace:Raycast(Vector3.new(x, expectedY + 8.0, z), Vector3.new(0, -20.0, 0), rayParams)
    if rMid and rMid.Instance and rMid.Instance.CanCollide and rMid.Normal.Y >= 0.45 and rMid.Position.Y > -40 then
        if not IsNonGroundProp(rMid.Instance, rMid.Position.Y, expectedY) then
            return rMid.Position.Y, rMid.Normal, rMid.Instance
        end
    end

    -- 2. Bridge & ascending ramp scan: cast from expectedY + 28.0 down by 45.0 studs
    local rHigh = Workspace:Raycast(Vector3.new(x, expectedY + 28.0, z), Vector3.new(0, -45.0, 0), rayParams)
    if rHigh and rHigh.Instance and rHigh.Instance.CanCollide and rHigh.Normal.Y >= 0.45 and rHigh.Position.Y > -40 then
        local dY = rHigh.Position.Y - expectedY
        if dY >= -16.0 and dY <= 24.0 and not IsNonGroundProp(rHigh.Instance, rHigh.Position.Y, expectedY) then
            return rHigh.Position.Y, rHigh.Normal, rHigh.Instance
        end
    end

    -- 3. Fallback: if rHigh hit any valid flat walkable surface
    if rHigh and rHigh.Instance and rHigh.Instance.CanCollide and rHigh.Normal.Y >= 0.55 and rHigh.Position.Y > -40 then
        if not IsNonGroundProp(rHigh.Instance, rHigh.Position.Y, expectedY) then
            return rHigh.Position.Y, rHigh.Normal, rHigh.Instance
        end
    end

    -- 4. Streaming fallback: If chunk is not yet streamed in or ray missed, return expectedY safely
    return expectedY, Vector3.new(0, 1, 0), nil
end
