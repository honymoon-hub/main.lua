                    if txt == "claim" or txt == "รับรางวัล" or txt == "รับ" then
                        isClaim = true
                    else
                        for _, child in ipairs(desc:GetChildren()) do
                            if child:IsA("TextLabel") then
                                local ctxt = tostring(child.Text or ""):lower():gsub("%s+", "")
                                if ctxt == "claim" or ctxt == "รับรางวัล" or ctxt == "รับ" then
                                    isClaim = true
                                    break
                                end
                            end
                        end
                    end

                    if isClaim and desc.Visible and desc.Active then
                        local isAncestorsVisible = true
                        local anc = desc.Parent
                        while anc and anc:IsA("GuiObject") and anc ~= pGui do
                            if not anc.Visible then
                                isAncestorsVisible = false
                                break
                            end
                            anc = anc.Parent
                        end

                        if isAncestorsVisible then
                            TriggerGuiButton(desc)
                            claimedCount = claimedCount + 1
                            clickedAny = true
                            task.wait(0.12)
                        end
                    end
                end
            end
            return clickedAny
        end

        -- 2. สแกนกดรับในหน้าปัจจุบันก่อน
        ScanAndClickClaimButtons()

        -- 3. สแกนหาปุ่ม Quests / Daily / Weekly ในโทรศัพท์
        local weeklyTabBtn = nil
        local dailyTabBtn = nil
        local questsAppBtn = nil

        if phoneGui then
            for _, desc in ipairs(phoneGui:GetDescendants()) do
                if desc:IsA("TextLabel") or desc:IsA("TextButton") then
                    local t = tostring(desc.Text or ""):lower():gsub("%s+", "")
                    if t == "weekly" or t:find("รายสัปดาห์") then
                        weeklyTabBtn = desc:IsA("GuiButton") and desc or desc:FindFirstAncestorWhichIsA("GuiButton")
                    elseif t == "daily" or t:find("รายวัน") then
                        dailyTabBtn = desc:IsA("GuiButton") and desc or desc:FindFirstAncestorWhichIsA("GuiButton")
                    elseif t == "quests" then
                        local btn = desc:IsA("GuiButton") and desc or desc:FindFirstAncestorWhichIsA("GuiButton")
                        if btn and not questsAppBtn then
                            questsAppBtn = btn
                        end
                    end
                end
            end
        end

        -- ถ้ายังไม่ได้เปิดแอป Quests ให้คลิกเปิดแอปเพื่อโหลดรายการ
        if questsAppBtn and not weeklyTabBtn and not dailyTabBtn then
            TriggerGuiButton(questsAppBtn)
            task.wait(0.25)
            if phoneGui then
                for _, desc in ipairs(phoneGui:GetDescendants()) do
                    if desc:IsA("TextLabel") or desc:IsA("TextButton") then
                        local t = tostring(desc.Text or ""):lower():gsub("%s+", "")
                        if t == "weekly" or t:find("รายสัปดาห์") then
                            weeklyTabBtn = desc:IsA("GuiButton") and desc or desc:FindFirstAncestorWhichIsA("GuiButton")
                        elseif t == "daily" or t:find("รายวัน") then
                            dailyTabBtn = desc:IsA("GuiButton") and desc or desc:FindFirstAncestorWhichIsA("GuiButton")
                        end
                    end
                end
            end
        end

        -- สลับไปแท็บ Weekly แล้วกดรับ
        if weeklyTabBtn then
            TriggerGuiButton(weeklyTabBtn)
            task.wait(0.2)
            ScanAndClickClaimButtons()
        end

        -- สลับกลับมาแท็บ Daily แล้วกดรับ
        if dailyTabBtn then
            TriggerGuiButton(dailyTabBtn)
            task.wait(0.2)
            ScanAndClickClaimButtons()
        end

        -- 4. ส่งผ่าน Remote เควสโดยตรง (ถ้ามี Remote ในเกม)
        local qRemote = FindQuestRemote()
        if qRemote then
            local invFn = (NetSeal and NetSeal.invoke) or (genv and genv[_gk.ni])
            local fireFn = (NetSeal and NetSeal.fire) or (genv and genv[_gk.nf])
            if invFn then
                pcall(invFn, qRemote, "ClaimAll")
                pcall(invFn, qRemote, "Claim")
            elseif fireFn then
                pcall(fireFn, qRemote, "ClaimAll")
                pcall(fireFn, qRemote, "Claim")
            end
        end

        -- 5. หากผู้เล่นกำลังฟาร์มงานอยู่ ให้ปิดจอโทรศัพท์กลับอัตโนมัติ ไม่ให้เกะกะ
        if IsAnyFarmEnabled and IsAnyFarmEnabled() then
            HideDeliveryPhoneUI()
        end
    end)

    QuestClaimingBusy = false
    return claimedCount
end
