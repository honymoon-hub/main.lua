-- language: Lua, file: init.lua, target: Roblox Luau
-- *Honymoon Hub loader with integrated StarterGui retry notification system*

local StarterGui = game:GetService("StarterGui")
local currentPlaceId = game.PlaceId

local function Notify(text, detail)
    warn("[Honymoon Hub] " .. text, detail or "")
    task.spawn(function()
        for _ = 1, 20 do
            local shown = pcall(StarterGui.SetCore, StarterGui, "SendNotification", {
                Title = "Honymoon Hub",
                Text = text,
                Duration = 10,
            })
            if shown then return end
            task.wait(0.5)
        end
    end)
end

local ScriptRegistry = {
    [122446657157717] = "https://raw.githubusercontent.com/honymoon-hub/main.lua/refs/heads/main/All/Sniper%20Arena",
    -- ใส่เพิ่มตรงนี้ได้เรื่อยๆ
}

local UniversalFallback = "https://raw.githubusercontent.com/honymoon-hub/main.lua/refs/heads/main/All/Universal"

local function executeRemoteScript(url)
    local success, content = pcall(function() return game:HttpGet(url) end)
    if success and content then
        local chunk, err = loadstring(content)
        if chunk then
            local runSuccess, runErr = pcall(chunk)
            if not runSuccess then
                Notify("Runtime error: check console", tostring(runErr))
            else
                Notify("Script executed successfully!")
            end
        else
            Notify("Compile error: check console", tostring(err))
        end
    else
        Notify("Failed to fetch script URL")
    end
end

local targetUrl = ScriptRegistry[currentPlaceId] or UniversalFallback
Notify("Loaded PlaceID: " .. tostring(currentPlaceId))
executeRemoteScript(targetUrl)
